diff --git a/bsd/dev/river_audio_queue.h b/bsd/dev/river_audio_queue.h
--- a/bsd/dev/river_audio_queue.h
+++ b/bsd/dev/river_audio_queue.h
@@ -1,3 +1,14 @@
+/* Normal iOS mode has one coordinator for both directions. Its mode bit
+ * remains sticky for this boot, including after stop, so failures cannot
+ * silently fall back to the old discarded/synthetic endpoints. */
+static struct {bool attempted,enabled,worker,blocked,muted;unsigned gain_q16;int error;} ri_audio_normal={.gain_q16=65536};
