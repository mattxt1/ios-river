+  }
+  unsigned resident=0,owned=0;
+  for(unsigned i=0;i<4;i++) {if(slots[i].owned || slots[i].ready)resident++;if(slots[i].owned)owned++;}
+  if(stopping && !resident)break;
+  /* Drain the four unity startup reads before changing ADC gain. Nothing
+   * remains DSP-owned at this barrier; exclude intentional preroll gaps. */
+  if(startup && submitted==4 && !resident) {
+   lck_mtx_lock(&ri_mic_buffer_lock);unsigned gain=ri_mic_live.gain;lck_mtx_unlock(&ri_mic_buffer_lock);
+   if(gain!=ri_mic.gain_level) {
+    uint16_t value=ri_clock_read(0x311);
+    if(value==0xffff || (value&0x100) || !ri_clock_write(0x311,(value&~255u)|0x200|(128+gain*24))) {
+     error=EIO;goto done;
+    }
+    ri_mic.gain_level=gain;settle=2;
+    lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.applied_gain=gain;lck_mtx_unlock(&ri_mic_buffer_lock);
+   }
+   startup=false;ri_mic.timestamp_previous=false;
+  }
+  while(!stopping && resident<4 && (!startup || submitted<4)) {
+   lck_mtx_lock(&ri_mic_buffer_lock);
+   unsigned free=RI_MIC_RING_FRAMES-ri_mic_live.used;
+   lck_mtx_unlock(&ri_mic_buffer_lock);
+   if(free<(resident+1)*2048)break;
+   if(submitted==~0u) {error=EOVERFLOW;goto done;}
+   struct ri_mic_read_slot *slot=&slots[submitted&3];
+   int check=ri_mic_read_publish(&ch,slot,stream,ri_mic.physical+(submitted&3)*4096,submitted);
+   if(check==EWOULDBLOCK)break;
+   if(check) {error=check;goto done;}
+   submitted++;resident++;owned++;
+   if(owned>ri_mic.max_owned)ri_mic.max_owned=owned;
+  }
+  if(!owned && !stopping) {
+   /* Ring capacity is reserved for every published destination. Wait for a
+    * reader rather than overwrite data; the consumer lease still bounds it. */
+   ri_mic.pipeline_starvations++;ri_wait(1);continue;
+  }
+  uint64_t now=ri_pipeline_now();
+  if(!stopping && now>=health_at) {
+   uint16_t lock=ri_clock_read(0x1881);if(lock==0xffff || !(lock&0x100)) {
+    error=EIO;stopping=true;
+    lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.stop=true;ri_mic_live.reason=5;lck_mtx_unlock(&ri_mic_buffer_lock);
+   }
+   health_at=ri_pipeline_now()+100000000ULL;
+  }
+  int result=ri_mic_read_receive(&ch,slots);
+  if(result==EAGAIN)ri_wait(1);
+  else if(result==EINPROGRESS) {if(++unrelated>32) {error=EOVERFLOW;goto done;}}
+  else if(result) {error=result;goto done;}
+  else unrelated=0;
+  now=ri_pipeline_now();
+  for(unsigned i=0;i<4;i++)if(slots[i].owned && now-slots[i].sent_ns>500000000ULL) {
+   error=ETIMEDOUT;goto done;
+  }
+ }
+ done:
+ ri_mic.in_flight=false;
+ for(unsigned i=0;i<4;i++)if(slots[i].owned)ri_mic.in_flight=true;
+ if(error && ri_mic.in_flight)ri_pcm.poisoned=true;
+ if(error && !ri_mic.failed_opcode)ri_mic.failed_opcode=0x10dac;
+ if(!error)ri_mic.phase="captured_continuous_pipeline";
+ ml_io_unmap(ipc,0x4000);return error;
+}
