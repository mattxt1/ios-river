diff --git a/bsd/dev/river_audio_normal.h b/bsd/dev/river_audio_normal.h
--- /dev/null
+++ b/bsd/dev/river_audio_normal.h
@@ -0,0 +1,123 @@
+/* One route owner for standard CoreAudio cdev I/O. Playback and physical
+ * capture may be enabled together; hardware routes remain half duplex.
+ * Only fully acknowledged, restored cleanup permits the next direction. */
+static bool
+ri_audio_normal_input_pending(void)
+{
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ bool pending=ri_mic_live.enabled && (ri_mic_live.requested || ri_mic_live.active);
+ lck_mtx_unlock(&ri_mic_buffer_lock);return pending;
+}
+static void
+ri_audio_normal_disable(void)
+{
+ lck_mtx_lock(&ri_audio_queue_lock);ri_audio_normal.enabled=false;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ ri_audio_auto_disable();
+ lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.enabled=false;ri_mic_live.stop=true;
+ ri_mic_live.reason=2;wakeup(&ri_mic_live);lck_mtx_unlock(&ri_mic_buffer_lock);
+}
+static void
+ri_audio_normal_worker(void *arg,wait_result_t wait)
+{
+ (void)arg;(void)wait;
+ for(;;) {
+  lck_mtx_lock(&ri_audio_queue_lock);
+  bool enabled=ri_audio_normal.enabled && ri_audio_auto.enabled;
+  int error=ri_audio_auto.error;
+  bool bad=ri_audio_auto.blocked;
+  lck_mtx_unlock(&ri_audio_queue_lock);
+  lck_mtx_lock(&ri_mic_buffer_lock);
+  enabled=enabled && ri_mic_live.enabled;
+  if(ri_mic_live.blocked) {bad=true;error=ri_mic_live.error?ri_mic_live.error:EIO;}
+  bool input=enabled && !bad && ri_mic_live.requested;
+  if(input) {ri_mic_live.active=true;ri_mic_live.requested=false;}
+  lck_mtx_unlock(&ri_mic_buffer_lock);
+  if(!enabled || bad) {
+   lck_mtx_lock(&ri_audio_queue_lock);
+   if(bad) {ri_audio_normal.blocked=true;ri_audio_normal.error=error?error:EIO;}
+   lck_mtx_unlock(&ri_audio_queue_lock);
+   ri_audio_normal_disable();break;
+  }
+  if(input) {ri_mic_live_session();continue;}
+  bool output=false;
+  lck_mtx_lock(&ri_audio_queue_lock);
+  if(ri_audio_queue.armed && ri_audio_queue.used) {
+   if(ri_audio_queue_now()-ri_audio_auto.last_write>=150000000ULL) {
+    ri_audio_auto.drain=true;ri_audio_auto.reason=3;
+   }
+   if(ri_audio_queue.used>=4096 || ri_audio_auto.drain) {
+    ri_audio_auto.active=true;ri_audio_queue.launched=true;output=true;
+   }
+  }
+  lck_mtx_unlock(&ri_audio_queue_lock);
+  if(output) {ri_audio_auto_session();continue;}
+  ri_wait(2);
+ }
+ /* This thread is the sole hardware owner. It only exits between sessions,
+  * after their exact cleanup checks, never while a DMA transaction runs. */
+ lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.worker=false;wakeup(&ri_mic_live);
+ lck_mtx_unlock(&ri_mic_buffer_lock);
+ lck_mtx_lock(&ri_audio_queue_lock);
+ ri_audio_auto.worker=false;ri_audio_normal.worker=false;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ (void)thread_terminate(current_thread());thread_block(THREAD_CONTINUE_NULL);
+}
+static int
+ri_audio_normal_enable(void)
+{
+ lck_mtx_lock(&ri_adsp_lock);
+ lck_mtx_lock(&ri_audio_queue_lock);
+ bool busy=ri_audio_normal.attempted || ri_audio_auto.worker || ri_audio_auto.enabled ||
+  ri_audio_auto.active || ri_audio_auto.blocked || ri_audio_queue.armed || ri_audio_queue.reserved;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ busy=busy || ri_mic_live.attempted || ri_mic_live.worker || ri_mic_capture.attempted;
+ lck_mtx_unlock(&ri_mic_buffer_lock);
+ if(busy || !ri_stream.complete || !ri_route_ready() || !ri_route.muted ||
+    !ri_afe_mute_hold || !ri_ngd.address_valid || !ri_ngd.enabled || ri_ngd.uncertain ||
+    !ri_mic_owned_clean() || !ri_audio_auto_clean()) {
+  lck_mtx_unlock(&ri_adsp_lock);return EBUSY;
+ }
+ int error=ri_audio_auto_rearm();
+ if(error) {lck_mtx_unlock(&ri_adsp_lock);return error;}
+ lck_mtx_lock(&ri_audio_queue_lock);
+ ri_audio_normal.attempted=ri_audio_normal.enabled=ri_audio_normal.worker=true;
+ ri_audio_auto.enabled=ri_audio_auto.worker=true;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ ri_mic_live.attempted=ri_mic_live.enabled=ri_mic_live.worker=true;
+ ri_mic_live.gain=0; /* Known clear baseline; no calibration changes in apps. */
+ lck_mtx_unlock(&ri_mic_buffer_lock);lck_mtx_unlock(&ri_adsp_lock);
+ thread_t thread=THREAD_NULL;
+ if(kernel_thread_start(ri_audio_normal_worker,NULL,&thread)!=KERN_SUCCESS) {
+  ri_audio_normal_disable();
+  lck_mtx_lock(&ri_audio_queue_lock);
+  ri_audio_normal.worker=ri_audio_auto.worker=false;
+  ri_audio_normal.blocked=true;ri_audio_normal.error=ENOMEM;
+  lck_mtx_unlock(&ri_audio_queue_lock);
+  lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.worker=false;ri_mic_live.blocked=true;
+  ri_mic_live.error=ENOMEM;lck_mtx_unlock(&ri_mic_buffer_lock);return ENOMEM;
+ }
+ thread_deallocate(thread);return 0;
+}
+static int river_audio_normal_sysctl SYSCTL_HANDLER_ARGS
+{
+ int value=0,error=sysctl_handle_int(oidp,&value,0,req);
+ if(error || !req->newptr)return error;
+ if(value==1)return ri_audio_normal_enable();
+ if(value!=0)return EINVAL;
+ ri_audio_normal_disable();return 0;
+}
+static int river_audio_normal_status_sysctl SYSCTL_HANDLER_ARGS
+{
+ char note[512];lck_mtx_lock(&ri_audio_queue_lock);
+ snprintf(note,sizeof(note),"attempted=%u enabled=%u worker=%u blocked=%u error=%d mode=ios_apps route_owner=single_coordinator duplex=half playback_session_limit=0 playback_duration_limit_ms=0 health_lease_ms=750 capture_idle_ms=750 input_gain_db=0 input_ring_frames=65536",
+  ri_audio_normal.attempted,ri_audio_normal.enabled,ri_audio_normal.worker,
+  ri_audio_normal.blocked,ri_audio_normal.error);
+ lck_mtx_unlock(&ri_audio_queue_lock);return sysctl_handle_string(oidp,note,sizeof(note),req);
+}
