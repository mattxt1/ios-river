+/* Idle audio has no hardware deadline. Sleep until a producer changes the
+ * generation, with a slow fallback. Short queued tails retain150ms drain. */
+static void
+ri_audio_normal_pause(uint64_t observed)
+{
+ unsigned ms=1000;
+ lck_mtx_lock(&ri_audio_queue_lock);
+ if(ri_audio_queue.armed && ri_audio_queue.used) {
+  uint64_t elapsed=ri_audio_queue_now()-ri_audio_auto.last_write;
+  ms=elapsed>=150000000ULL?1:(unsigned)((150000000ULL-elapsed+999999ULL)/1000000ULL);
+ }
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ uint64_t deadline;clock_interval_to_deadline(ms,NSEC_PER_MSEC,&deadline);
+ (void)assert_wait_deadline(&ri_audio_normal,THREAD_UNINT,deadline);
+ /* Register FIRST, then compare. Producers publish before wakeup. A wake
+  * either reaches our registered event or is noticed by this generation. */
+ if(__atomic_load_n(&ri_audio_normal_wake_generation,__ATOMIC_ACQUIRE)!=observed)
+  (void)clear_wait(current_thread(),THREAD_AWAKENED);
+ thread_block(THREAD_CONTINUE_NULL);
+}
