diff --git a/iokit/Kernel/arm/river_frame_clock.h b/iokit/Kernel/arm/river_frame_clock.h
--- /dev/null
+++ b/iokit/Kernel/arm/river_frame_clock.h
@@ -0,0 +1,27 @@
+/* River virtual-vsync clock. Only timer scheduling changes: existing
+ * presentation, GPU fences and surface pending/show/retire ownership stay.
+ * Expensive presents consume their share of a fixed period, not a whole
+ * extra sleep. Late work skips obsolete deadlines without catch-up bursts. */
+struct river_frame_clock {
+ uint64_t period,due,callbacks,skipped,max_late;
+};
+static void
+river_frame_clock_fire(struct river_frame_clock *clock,uint64_t now)
+{
+ clock->callbacks++;
+ if(now>clock->due && now-clock->due>clock->max_late)clock->max_late=now-clock->due;
+}
+static uint64_t
+river_frame_clock_arm(struct river_frame_clock *clock,uint64_t now)
+{
+ if(!clock->period)return 0;
+ if(!clock->due) {
+  clock->due=now+clock->period;return clock->due;
+ }
+ uint64_t next=clock->due+clock->period;
+ if(next<=now) {
+  uint64_t skipped=(now-next)/clock->period+1;
+  clock->skipped+=skipped;next+=skipped*clock->period;
+ }
+ clock->due=next;return next;
+}
