diff --git a/bsd/dev/river_wifi_media.h b/bsd/dev/river_wifi_media.h
--- a/bsd/dev/river_wifi_media.h
+++ b/bsd/dev/river_wifi_media.h
@@ -0,0 +1,27 @@
+/* A media-count query must report an entry even without a list buffer.
+ * IPConfiguration requires count>0 plus IFM_AVALID before accepting link state.
+ * The ioctl boundary has packed64 (44), kernel64 (48), and 32-bit (40) ABIs.
+ * Never dereference a userspace media-list pointer in the kernel. */
+static int
+river_wifi_media_query(unsigned long cmd,void *data,bool live)
+{
+ if(!data)return EINVAL;
+ struct river_ifmediareq *m=(struct river_ifmediareq *)data;
+ int capacity=m->ifm_count;
+ if(capacity<0)return EINVAL;
+ unsigned size=(unsigned)((cmd>>16)&0x1fff);
+ uint64_t address=0;
+ if(size==40) {uint32_t p=0;memcpy(&p,(uint8_t *)data+36,4);address=p;}
+ else if(size==44)memcpy(&address,(uint8_t *)data+36,8);
+ else if(size==48)memcpy(&address,(uint8_t *)data+40,8);
+ else return EINVAL;
+ m->ifm_current=0x80; /* IFM_IEEE80211 | IFM_AUTO */
+ m->ifm_mask=0;m->ifm_active=0x80;
+ m->ifm_status=1|(live?2:0); /* IFM_AVALID | IFM_ACTIVE */
+ m->ifm_count=1;
+ if(capacity && address) {
+  const int media=0x80;
+  return copyout(&media,(user_addr_t)address,sizeof(media));
+ }
+ return 0;
+}
