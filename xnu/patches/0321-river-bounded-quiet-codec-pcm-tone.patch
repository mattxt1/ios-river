diff --git a/bsd/dev/river_adsp_tone.h b/bsd/dev/river_adsp_tone.h
--- a/bsd/dev/river_adsp_tone.h
+++ b/bsd/dev/river_adsp_tone.h
@@ -0,0 +1,88 @@
+/* Short quiet ASP playback test. No boost, trim, gain or reset writes.
+ * ADSP/codec own the route; all amplifier state and watchdog share speaker
+ * lock, while individual QUP2 transfers retain their existing serialization. */
+static struct {
+ bool attempted,active,enabled,stopped,cutoff;
+ uint32_t power,mute,volume,want_volume,irq1,irq3;
+ int error;
+} ri_tone;
+static thread_call_t ri_tone_timer;
+static bool
+ri_tone_mute_locked(void)
+{
+ ri_tone.active=false;
+ bool ok=ri_i2s_amp_write(0x2024,ri_tone.mute|0x10);
+ if(!ri_i2s_amp_write(0x2018,ri_tone.power&~1u))ok=false;
+ if(!ri_i2s_amp_write(0x6000,ri_tone.volume))ok=false;
+ ri_tone.stopped=ok;return ok;
+}
+static void
+ri_tone_timeout(thread_call_param_t a,thread_call_param_t b)
+{
+ (void)a;(void)b;lck_mtx_lock(&ri_speaker_lock);
+ if(ri_tone.active) {ri_tone.cutoff=true;if(!ri_tone_mute_locked())ri_tone.error=EIO;}
+ lck_mtx_unlock(&ri_speaker_lock);
+}
+static bool
+ri_tone_locked_clocks(void)
+{
+ uint32_t source=0,global=0,gain=0,format=0;
+ return ri_cs35l41_rd(0x4c00,&source) && source==8 &&
+  ri_cs35l41_rd(0x2014,&global) && (global&1) &&
+  ri_cs35l41_rd(0x6c04,&gain) && gain==0x220 &&
+  ri_cs35l41_rd(0x4808,&format) && !(format&0x33) &&
+  ri_cs35l41_rd(0x10090,&ri_tone.irq1) && !(ri_tone.irq1&0x800281c0u) &&
+  ri_cs35l41_rd(0x10098,&ri_tone.irq3) && !(ri_tone.irq3&0x10) &&
+  ri_tone.irq3!=0xffffffff && (ri_clock_read(0x1881)&0x100) &&
+  ri_clock_read(0x1881)!=0xffff && (ri_clock_read(0x700)&0x80ff)==0x8038 &&
+  (ri_clock_read(0x708)&0x80ff)==0x8038 && (ri_clock_read(0x5f7)&1) && ri_clock_read(0x519)==3;
+}
+static int
+ri_tone_start(void)
+{
+ int error=EBUSY;lck_mtx_lock(&ri_speaker_lock);
+ if(ri_tone.attempted)goto done;
+ if(!ri_afe_mute_hold || !ri_i2s_quiet() || !ri_tone_locked_clocks() ||
+    !ri_cs35l41_rd(0x2018,&ri_tone.power) || !ri_cs35l41_rd(0x2024,&ri_tone.mute) ||
+    !ri_cs35l41_rd(0x6000,&ri_tone.volume))goto done;
+ if(!ri_tone_timer)ri_tone_timer=thread_call_allocate(ri_tone_timeout,NULL);
+ if(!ri_tone_timer) {error=ENOMEM;goto done;}
+ ri_tone.attempted=true;
+ /* Fixed -24dB digital attenuation, signed11-bit eighth-dB PCM_VOL.
+  * Samples are additionally bounded to +/-2048 with5ms end ramps. */
+ ri_tone.want_volume=(ri_tone.volume&~0x3ff8u)|(((0u-192u)&0x7ffu)<<3);
+ ri_tone.active=true;uint64_t deadline;
+ clock_interval_to_deadline(750,NSEC_PER_MSEC,&deadline);
+ thread_call_enter_delayed(ri_tone_timer,deadline);
+ if(!ri_i2s_amp_write(0x6000,ri_tone.want_volume) ||
+    !ri_i2s_amp_write(0x2018,ri_tone.power|1u)) {
+  error=EIO;(void)ri_tone_mute_locked();goto done;
+ }
+ delay(1000);
+ if(!ri_tone_locked_clocks() || !ri_i2s_amp_write(0x2024,ri_tone.mute&~0x10u)) {
+  error=EIO;(void)ri_tone_mute_locked();goto done;
+ }
+ ri_tone.enabled=true;error=0;
+done:
+ ri_tone.error=error;lck_mtx_unlock(&ri_speaker_lock);return error;
+}
+static int
+ri_tone_check(void)
+{
+ int error=0;uint32_t power=0,mute=0,volume=0;lck_mtx_lock(&ri_speaker_lock);
+ if(!ri_tone.active || ri_tone.cutoff)error=ETIMEDOUT;
+ else if(!ri_tone_locked_clocks() || !ri_cs35l41_rd(0x2018,&power) || !(power&1) ||
+   !ri_cs35l41_rd(0x2024,&mute) || (mute&0x10) ||
+   !ri_cs35l41_rd(0x6000,&volume) || volume!=ri_tone.want_volume)error=EIO;
+ if(error)ri_tone.error=error;
+ lck_mtx_unlock(&ri_speaker_lock);return error;
+}
+static void
+ri_tone_stop(void)
+{
+ lck_mtx_lock(&ri_speaker_lock);
+ if(ri_tone.attempted && !ri_tone_mute_locked())ri_tone.error=EIO;
+ lck_mtx_unlock(&ri_speaker_lock);
+ /* Never wait with speaker lock held: the watchdog also needs that lock. */
+ if(ri_tone_timer)thread_call_cancel_wait(ri_tone_timer);
+}
