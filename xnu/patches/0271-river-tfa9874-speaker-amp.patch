+void
+river_tfa9874_init(void)
+{
+	int enabled = 1;
+	(void)PE_parse_boot_argn("riverspeaker", &enabled, sizeof(enabled));
+	if (!enabled) return;
 
+	vm_offset_t gpio94 = ri_map(0x0105e000);
+	if (gpio94) {
+		ri_wr(gpio94, 4, 2);
+		ri_wr(gpio94, 0, 0x2c0);
+		delay(10000);
+		printf("RIVER AUDIO: TFA9874 reset released (GPIO94 cfg=%#x inout=%#x)\n",
+		       ri_rd(gpio94, 0), ri_rd(gpio94, 4));
+	}
+
+	if (!ri_qup2) {
+		printf("RIVER AUDIO: QUP2 not mapped\n");
+		return;
+	}
+
+	vm_offset_t tlmm_mi2s = ri_map(0x01058000);
+	if (tlmm_mi2s) {
+		ri_wr(tlmm_mi2s, 0x0000, 0x1c4);
+		ri_wr(tlmm_mi2s, 0x3000, 0x1c4);
+		ri_wr(tlmm_mi2s, 0x4000, 0x1c4);
+		ri_wr(tlmm_mi2s, 0x5000, 0x1c4);
+		printf("RIVER AUDIO: TLMM MI2S pins configured (88, 91, 92, 93)\n");
+	}
+
+	uint8_t rev_cmd = 0x03, rev_data[2] = {0, 0};
+	uint8_t status_cmd = 0x00, status_data[2] = {0, 0};
+	uint8_t addr = 0x34;
+	bool ok = false;
+	for (int t = 0; t < 10; t++) {
+		if (ri_qup_xfer(ri_qup2, 0x34, &rev_cmd, 1, rev_data, 2)) {
+			ok = true; addr = 0x34; break;
+		}
+		delay(3000);
+	}
+	if (!ok) {
+		for (int t = 0; t < 5; t++) {
+			if (ri_qup_xfer(ri_qup2, 0x35, &rev_cmd, 1, rev_data, 2)) {
+				ok = true; addr = 0x35; break;
+			}
+			delay(3000);
+		}
+	}
+	if (!ok) {
+		printf("RIVER AUDIO: TFA9874 probe failed at 0x34 and 0x35\n");
+		return;
+	}
+	ri_tfa_rev = ((uint16_t)rev_data[0] << 8) | rev_data[1];
+	printf("RIVER AUDIO: TFA9874 detected at I2C 0x%02x (rev=%#06x)\n", addr, ri_tfa_rev);
+	if (ri_qup_xfer(ri_qup2, addr, &status_cmd, 1, status_data, 2)) {
+		ri_tfa_status = ((uint16_t)status_data[0] << 8) | status_data[1];
+		printf("RIVER AUDIO: TFA9874 status=%#06x\n", ri_tfa_status);
+	}
+	uint8_t pwr_on[3] = { 0x04, 0x00, 0x00 };
+	ri_qup_xfer(ri_qup2, addr, pwr_on, 3, NULL, 0);
+	uint8_t boost[3] = { 0x09, 0x02, 0x5d };
+	ri_qup_xfer(ri_qup2, addr, boost, 3, NULL, 0);
+	uint8_t vol_unmute[3] = { 0x10, 0x00, 0x00 };
+	ri_qup_xfer(ri_qup2, addr, vol_unmute, 3, NULL, 0);
+	ri_speaker_ok = true;
+	printf("RIVER AUDIO: TFA9874 amplifier configured and unmuted\n");
+}
+
+static int
+river_audio_hw_sysctl SYSCTL_HANDLER_ARGS
+{
+	char buf[128];
+	snprintf(buf, sizeof(buf), "ok=%d rev=%#06x status=%#06x",
+	         ri_speaker_ok ? 1 : 0, ri_tfa_rev, ri_tfa_status);
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_audio_hw, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_audio_hw_sysctl, "A", "River audio hardware status");
