  state->attempted=true;state->session=session;
  ri_route.failed_opcode=ri_route.failed_status=ri_route.cleanup_opcode=ri_route.cleanup_status=0;
  ri_route.cleanup_error=0;ri_route.asm_format=false;ri_route.session=session;
@@ -94,6 +123,7 @@
  if(reply.words!=1 || !reply.data[0]) {ri_pcm.poisoned=true;error=EIO;goto done;}
  state->handle=reply.data[0];state->mapped=true;
  if(!ri_route_hold_mute()) {phase="mute";error=EIO;goto done;}
+ if(!state->afe_prepared) {
  phase="afe_reconfigure";
  error=ri_route_apply_config();
  if(error) {
@@ -105,6 +135,7 @@
  error=ri_stream_command(state,0x504,0x404,0x100e5,0,&port,1,&reply);
  if(error)goto done;
  ri_route.afe_started=true;
+ }
  const uint32_t stream=((state->session<<8)|1)<<16;
