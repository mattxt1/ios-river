+/* The live route may own an acknowledged AFE start while NGD connects its
+ * codec sink. No ASM, ADM or PCM submission exists at this point. */
+static bool
+ri_stream_live_prepared(void)
+{
+ return ri_live_stream.arm_attempted && ri_live_stream.afe_prepared &&
+  !ri_live_stream.attempted && ri_route.afe_started && ri_pcm.unmapped &&
+  ri_pcm.asm_closed && !ri_pcm.poisoned && !ri_route.asm_open &&
+  !ri_route.adm_open && !ri_route.cleanup_error && ri_route.muted;
+}
+static int
+ri_stream_prepare_live(void)
+{
+ if(ri_live_stream.arm_attempted || ri_live_stream.attempted)return EALREADY;
+ if(!ri_stream.complete || !ri_route_ready() || !ri_route.config_readback ||
+    ri_route.cleanup_error || ri_route.failed_opcode || !ri_route.asm_format)return EBUSY;
+ ri_live_stream.arm_attempted=true;ri_live_stream.session=5;
+ struct ri_apr_reply reply;int error;const char *phase="afe_prepare_mute";
+ if(!ri_route_hold_mute()) {error=EIO;goto done;}
+ phase="afe_prepare_config";error=ri_route_apply_config();if(error)goto done;
+ if(!ri_route.config_readback) {error=EIO;goto done;}
+ uint32_t port=0x4000;phase="afe_prepare_start";
+ error=ri_stream_command(&ri_live_stream,0x504,0x404,0x100e5,0,&port,1,&reply);
+ if(!error) {ri_route.afe_started=ri_live_stream.afe_prepared=true;phase="afe_prepared";}
+done:
+ return ri_stream_result(&ri_live_stream,phase,error);
+}
