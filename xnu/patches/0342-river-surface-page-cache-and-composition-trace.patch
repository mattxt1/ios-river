+/* River metadata-only present-attempt trace. Caller serializes ring access.
+ * No pixels, labels, text, or surface memory are read. Not a display FPS counter. */
+#ifndef RIVER_FB_COMPOSITION_TRACE_H
+#define RIVER_FB_COMPOSITION_TRACE_H
+#define RIVER_FB_TRACE_CONTROL 0x52465443u
+#define RIVER_FB_TRACE_READ 0x52465452u
+#define RIVER_FB_TRACE_CAPACITY 256u
+#define RIVER_FB_TRACE_CHUNK 16u
+struct river_fb_trace_record {
+ uint64_t ordinal, time_ns;
+ uint32_t swap_id, mask, surface[4];
+ uint32_t source_rect[4][4], destination_rect[4][4];
+};
+struct river_fb_trace_ring {
+ uint64_t total;
+ struct river_fb_trace_record records[RIVER_FB_TRACE_CAPACITY];
+};
+struct river_fb_trace_packet {
+ uint64_t total;
+ uint32_t version, available, first, count;
+ struct river_fb_trace_record records[RIVER_FB_TRACE_CHUNK];
+};
+static inline void river_fb_trace_append(struct river_fb_trace_ring *ring,
+ const struct river_fb_trace_record *record) {
+ uint64_t n = ring->total;
+ ring->records[n % RIVER_FB_TRACE_CAPACITY] = *record;
+ ring->records[n % RIVER_FB_TRACE_CAPACITY].ordinal = n;
+ ring->total = n + 1;
+}
+static inline void river_fb_trace_read(const struct river_fb_trace_ring *ring,
+ uint32_t first, struct river_fb_trace_packet *out) {
+ out->total = ring->total; out->version = 1;
+ out->available = ring->total < RIVER_FB_TRACE_CAPACITY ? (uint32_t)ring->total : RIVER_FB_TRACE_CAPACITY;
+ out->first = first; out->count = 0;
+ if (first >= out->available) return;
+ uint64_t oldest = ring->total - out->available;
+ while (out->count < RIVER_FB_TRACE_CHUNK && first + out->count < out->available) {
+  uint64_t at = oldest + first + out->count;
+  out->records[out->count++] = ring->records[at % RIVER_FB_TRACE_CAPACITY];
+ }
+}
