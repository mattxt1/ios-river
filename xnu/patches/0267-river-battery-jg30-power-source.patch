+/* Motorola JG30 (3000 mAh) battery profile OCV lookup table at 25 C.
+ * Traced from sdm632-river-common-overlay.dtsi and qg-batterydata-jg30-atl-3000mah.dtsi.
+ * Strictly monotonic decreasing voltage (4380 mV at 100.0% down to 2772 mV at 0.0%). */
+static const struct {
+ uint16_t mv;
+ uint16_t soc_bp; /* basis points: 10000 = 100.0% */
+} jg30_ocv_lut[] = {
+ {4380, 10000}, {4350,  9800}, {4322,  9600}, {4296,  9400}, {4271,  9200},
+ {4248,  9000}, {4224,  8800}, {4201,  8600}, {4178,  8400}, {4156,  8200},
+ {4134,  8000}, {4112,  7800}, {4091,  7600}, {4070,  7400}, {4050,  7200},
+ {4030,  7000}, {4010,  6800}, {3991,  6600}, {3974,  6400}, {3959,  6200},
+ {3941,  6000}, {3918,  5800}, {3895,  5600}, {3878,  5400}, {3864,  5200},
+ {3851,  5000}, {3841,  4800}, {3831,  4600}, {3822,  4400}, {3813,  4200},
+ {3806,  4000}, {3799,  3800}, {3793,  3600}, {3787,  3400}, {3781,  3200},
+ {3775,  3000}, {3769,  2800}, {3763,  2600}, {3756,  2400}, {3748,  2200},
+ {3740,  2000}, {3731,  1800}, {3720,  1600}, {3708,  1400}, {3693,  1200},
+ {3688,  1000}, {3687,   900}, {3685,   800}, {3682,   700}, {3672,   600},
+ {3643,   500}, {3595,   400}, {3533,   300}, {3448,   200}, {3316,   100},
+ {2772,     0},
+};
+#define JG30_OCV_LUT_COUNT (sizeof(jg30_ocv_lut) / sizeof(jg30_ocv_lut[0]))
+
+static unsigned
+jg30_estimate_soc(unsigned mv, int ma)
+{
+ unsigned vocv = mv;
+ if (ma < 0) {
+  unsigned dis_ma = (unsigned)(-ma);
+  unsigned vdrop = (dis_ma * 3u) / 20u; /* 150 mOhm cell IR compensation */
+  if (vdrop > 300) vdrop = 300;
+  vocv += vdrop;
+ }
+ if (vocv >= jg30_ocv_lut[0].mv) return 100;
+ if (vocv <= jg30_ocv_lut[JG30_OCV_LUT_COUNT - 1].mv) return 0;
+ for (unsigned i = 0; i < JG30_OCV_LUT_COUNT - 1; ++i) {
+  if (vocv <= jg30_ocv_lut[i].mv && vocv >= jg30_ocv_lut[i + 1].mv) {
+   unsigned span_mv = jg30_ocv_lut[i].mv - jg30_ocv_lut[i + 1].mv;
+   unsigned span_soc = jg30_ocv_lut[i].soc_bp - jg30_ocv_lut[i + 1].soc_bp;
+   unsigned frac_mv = vocv - jg30_ocv_lut[i + 1].mv;
+   unsigned soc_bp = jg30_ocv_lut[i + 1].soc_bp;
+   if (span_mv > 0) soc_bp += (frac_mv * span_soc) / span_mv;
+   return (soc_bp + 50u) / 100u;
+  }
+ }
+ return 0;
+}
