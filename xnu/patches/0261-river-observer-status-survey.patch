--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -3425,6 +3425,37 @@
 SYSCTL_PROC(_debug, OID_AUTO, river_charge_settle, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
             NULL, 0, river_charge_settle_sysctl, "A", "River post-DONE data delay survey");
 
+/* Read-only diagnostic: correlate RDATA transitions with status changes.
+ * Status equality cannot exclude another transaction or a stale completion. */
+static int
+river_charge_status_sysctl SYSCTL_HANDLER_ARGS
+{
+ if (!__atomic_load_n(&ri_power_ready,__ATOMIC_ACQUIRE) || !ri_charge_chgr) return ENXIO;
+ int expected=0;
+ if (!__atomic_compare_exchange_n(&ri_power_busy,&expected,1,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) return EBUSY;
+ unsigned zero=0,two=0,other=0,errors=0,changed10=0,changed100=0;
+ unsigned status10=0,status100=0,change_status10=0,change_status100=0,lateerr10=0,lateerr100=0;
+ uint32_t last_error=0;
+ for (unsigned i=0;i<64;i++) {
+  uint32_t s0=0,first=0;
+  if (!ri_charge_alt_read(ri_charge_chgr,4,&s0,&first)) { errors++; last_error=s0; continue; }
+  delay(10); uint32_t s10=ri_rd(ri_charge_chgr,8), d10=ri_rd(ri_charge_chgr,0x18)&0xffu;
+  delay(90); uint32_t s100=ri_rd(ri_charge_chgr,8), d100=ri_rd(ri_charge_chgr,0x18)&0xffu;
+  if (first==0) zero++; else if (first==2) two++; else other++;
+  bool c10=first!=d10, c100=first!=d100, s10c=s0!=s10, s100c=s0!=s100;
+  changed10+=c10; changed100+=c100; status10+=s10c; status100+=s100c;
+  change_status10+=c10&&s10c; change_status100+=c100&&s100c;
+  lateerr10+=(s10&14u)!=0; lateerr100+=(s100&14u)!=0;
+ }
+ char note[512];
+ snprintf(note,sizeof(note),"trials=64 first_zero=%u first_two=%u first_other=%u errors=%u last_error=%#x changed10=%u changed100=%u status10=%u status100=%u change_status10=%u change_status100=%u lateerr10=%u lateerr100=%u",zero,two,other,errors,last_error,changed10,changed100,status10,status100,change_status10,change_status100,lateerr10,lateerr100);
+ int error=sysctl_handle_string(oidp,note,0,req);
+ __atomic_store_n(&ri_power_busy,0,__ATOMIC_RELEASE);
+ return error;
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_charge_status, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_charge_status_sysctl, "A", "River observer status and data survey");
+
 static vm_offset_t
 ri_spmi_chnl(vm_offset_t core, unsigned ppid)
 {
