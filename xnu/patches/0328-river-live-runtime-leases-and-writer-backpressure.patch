+/* Prepare the route while muted; long mode requires a separate GO after the
+ * host issues its listening cue. Never hold queue mutex across sleep or I/O.
+ * Timeout/stop closes the prepared route without enabling the amplifier. */
+static int
+ri_audio_queue_wait_output(void)
+{
+ lck_mtx_lock(&ri_audio_queue_lock);
+ bool gated=ri_audio_queue.long_mode;
+ if(gated)ri_audio_queue.waiting_output=true;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ if(!gated)return 0;
+ int error=ETIMEDOUT;uint64_t until=ri_pipeline_now()+15000000000ULL;
+ while(ri_pipeline_now()<until) {
+  lck_mtx_lock(&ri_audio_queue_lock);
+  bool stop=ri_audio_queue.stop,go=ri_audio_queue.go;
+  lck_mtx_unlock(&ri_audio_queue_lock);
+  if(stop) {error=ECANCELED;break;}
+  if(go) {error=0;break;}
+  ri_wait(1);
+ }
+ lck_mtx_lock(&ri_audio_queue_lock);ri_audio_queue.waiting_output=false;
+ lck_mtx_unlock(&ri_audio_queue_lock);return error;
+}
