+/* River's 32-byte keychain item keys use RFC 3394 AES key wrap. */
+#ifndef RIVER_KEY_WRAP_H
+#define RIVER_KEY_WRAP_H
+
+enum { RIVER_AKS_SEED_BYTES = 32, RIVER_AKS_KEY_BYTES = 32, RIVER_AKS_WRAPPED_BYTES = 40 };
+
+/* Derive a distinct 128-bit KEK for each supported keychain protection class.
+ * A single block of AES-256 is a PRF over the fixed, distinct labels. */
+static bool
+river_aks_kek(const uint8_t seed[RIVER_AKS_SEED_BYTES], uint8_t keyclass, uint8_t kek[16])
+{
+	const uint8_t label[16] = {'R', 'i', 'v', 'e', 'r', 'A', 'K', 'S', 'v', '1', 0, 0, 0, 0, 0, keyclass};
+	aes_encrypt_ctx context;
+	bool ok = aes_encrypt_key256(seed, &context) == 0 && aes_encrypt(label, kek, &context) == 0;
+	memset_s(&context, sizeof(context), 0, sizeof(context));
+	return ok;
+}
+
+static bool
+river_aks_wrap(const uint8_t kek[16], const uint8_t input[RIVER_AKS_KEY_BYTES],
+    uint8_t output[RIVER_AKS_WRAPPED_BYTES])
+{
+	aes_encrypt_ctx context;
+	if (aes_encrypt_key128(kek, &context) != 0) {
+		memset_s(&context, sizeof(context), 0, sizeof(context));
+		return false;
+	}
+	uint8_t block[16];
+	memset(output, 0xa6, 8);
+	memcpy(output + 8, input, RIVER_AKS_KEY_BYTES);
+	bool ok = true;
+	for (unsigned round = 0; round < 6 && ok; ++round) {
+		for (unsigned index = 1; index <= 4; ++index) {
+			memcpy(block, output, 8);
+			memcpy(block + 8, output + 8 * index, 8);
+			ok = aes_encrypt(block, block, &context) == 0;
+			if (!ok) {
+				break;
+			}
+			block[7] ^= 4 * round + index;
+			memcpy(output, block, 8);
+			memcpy(output + 8 * index, block + 8, 8);
+		}
+	}
+	if (!ok) {
+		memset_s(output, RIVER_AKS_WRAPPED_BYTES, 0, RIVER_AKS_WRAPPED_BYTES);
+	}
+	memset_s(block, sizeof(block), 0, sizeof(block));
+	memset_s(&context, sizeof(context), 0, sizeof(context));
+	return ok;
+}
+
+static bool
+river_aks_unwrap(const uint8_t kek[16], const uint8_t input[RIVER_AKS_WRAPPED_BYTES],
+    uint8_t output[RIVER_AKS_KEY_BYTES])
+{
+	aes_decrypt_ctx context;
+	if (aes_decrypt_key128(kek, &context) != 0) {
+		memset_s(&context, sizeof(context), 0, sizeof(context));
+		return false;
+	}
+	uint8_t block[16], a[8];
+	const uint8_t iv[8] = {0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6};
+	memcpy(a, input, 8);
+	memcpy(output, input + 8, RIVER_AKS_KEY_BYTES);
+	bool ok = true;
+	for (int round = 5; round >= 0 && ok; --round) {
+		for (unsigned index = 4; index > 0; --index) {
+			memcpy(block, a, 8);
+			block[7] ^= 4 * round + index;
+			memcpy(block + 8, output + 8 * (index - 1), 8);
+			ok = aes_decrypt(block, block, &context) == 0;
+			if (!ok) {
+				break;
+			}
+			memcpy(a, block, 8);
+			memcpy(output + 8 * (index - 1), block + 8, 8);
+		}
+	}
+	ok = ok && timingsafe_bcmp(a, iv, sizeof(iv)) == 0;
+	if (!ok) {
+		memset_s(output, RIVER_AKS_KEY_BYTES, 0, RIVER_AKS_KEY_BYTES);
+	}
+	memset_s(a, sizeof(a), 0, sizeof(a));
+	memset_s(block, sizeof(block), 0, sizeof(block));
+	memset_s(&context, sizeof(context), 0, sizeof(context));
+	return ok;
+}
+#endif
