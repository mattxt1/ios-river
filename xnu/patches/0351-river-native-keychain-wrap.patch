+#if defined(RIVER)
+static bool
+river_aks_is_securityd(vfs_context_t context)
+{
+	if (kauth_getuid() != 64) {
+		return false;
+	}
+	vnode_t executable = proc_getexecutablevnode(current_proc());
+	if (!executable) {
+		return false;
+	}
+	vnode_t expected = NULLVP;
+	const int error = vnode_lookup("/usr/libexec/securityd", VNODE_LOOKUP_NOFOLLOW, &expected, context);
+	const bool trusted = error == 0 && executable == expected;
+	if (expected) {
+		vnode_put(expected);
+	}
+	vnode_put(executable);
+	return trusted;
+}
+
+static bool
+river_aks_load_seed(vfs_context_t context, uint8_t seed[RIVER_AKS_SEED_BYTES])
+{
+	vnode_t vnode = NULLVP;
+	static const char path[] = "/private/var/keybags/river-wrap-v1";
+	if (vnode_open(path, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vnode, context) != 0) {
+		return false;
+	}
+	struct vnode_attr attributes;
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_uid);
+	VATTR_WANTED(&attributes, va_mode);
+	VATTR_WANTED(&attributes, va_nlink);
+	VATTR_WANTED(&attributes, va_data_size);
+	bool valid = vnode_isreg(vnode) && vnode_getattr(vnode, &attributes, context) == 0 &&
+	    VATTR_ALL_SUPPORTED(&attributes) && attributes.va_uid == 0 &&
+	    (attributes.va_mode & ALLPERMS) == 0400 && attributes.va_nlink == 1 &&
+	    attributes.va_data_size == RIVER_AKS_SEED_BYTES;
+	if (valid) {
+		int remaining = RIVER_AKS_SEED_BYTES;
+		const int error = vn_rdwr(UIO_READ, vnode, reinterpret_cast<caddr_t>(seed),
+		    RIVER_AKS_SEED_BYTES, 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(context),
+		    &remaining, vfs_context_proc(context));
+		valid = error == 0 && remaining == 0;
+	}
+	vnode_close(vnode, FREAD, context);
+	return valid;
+}
+
+static IOReturn
+river_aks_crypt(uint32_t selector, IOExternalMethodArguments *args)
+{
+	const bool wrap = selector == kAKSWrapKey;
+	const size_t input_size = wrap ? RIVER_AKS_KEY_BYTES : RIVER_AKS_WRAPPED_BYTES;
+	const size_t output_size = wrap ? RIVER_AKS_WRAPPED_BYTES : RIVER_AKS_KEY_BYTES;
+	if (args->scalarInputCount != 2 || !args->scalarInput ||
+	    args->scalarOutputCount != (wrap ? 1u : 0u) || (wrap && !args->scalarOutput) ||
+	    args->structureInputDescriptor || args->structureOutputDescriptor ||
+	    !args->structureInput || args->structureInputSize != input_size || !args->structureOutput) {
+		return kIOReturnBadArgument;
+	}
+	if (args->structureOutputSize < output_size) {
+		return kIOReturnNoSpace;
+	}
+	const uint64_t bag = args->scalarInput[0], keyclass = args->scalarInput[1];
+	/* Only the ordinary system bag on River's existing no-passcode platform. */
+	if (bag != SWEET_AKS_SYSTEM_HANDLE || keyclass < 6 || keyclass > 11) {
+		return kIOReturnUnsupported;
+	}
+	vfs_context_t context = vfs_context_kernel();
+	if (!river_aks_is_securityd(context)) {
+		return kIOReturnNotPrivileged;
+	}
+	uint8_t seed[RIVER_AKS_SEED_BYTES] = {};
+	uint8_t kek[16] = {};
+	uint8_t output[RIVER_AKS_WRAPPED_BYTES] = {};
+	IOReturn result = kIOReturnNotReady;
+	if (river_aks_load_seed(context, seed) && river_aks_kek(seed, keyclass, kek)) {
+		const uint8_t *input = static_cast<const uint8_t *>(args->structureInput);
+		const bool ok = wrap ? river_aks_wrap(kek, input, output) : river_aks_unwrap(kek, input, output);
+		result = ok ? sweet_aks_struct_out(args, output, output_size) : kIOReturnBadArgument;
+		if (result == kIOReturnSuccess && wrap) {
+			args->scalarOutput[0] = keyclass;
+		}
+	}
+	memset_s(seed, sizeof(seed), 0, sizeof(seed));
+	memset_s(kek, sizeof(kek), 0, sizeof(kek));
+	memset_s(output, sizeof(output), 0, sizeof(output));
+	return result;
+}
+#endif
