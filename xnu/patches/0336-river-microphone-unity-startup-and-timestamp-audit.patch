+   if(delta>1000000)ri_mic.timestamp_gaps++;
+   else {
+    int64_t difference=(int64_t)(delta*48)-(int64_t)ri_mic.timestamp_frames*1000;
+    uint64_t magnitude=difference<0?(uint64_t)-difference:(uint64_t)difference;
