+
+/* Diagnostic only: one four-byte last-ADC read, not Motorola's held burst
+ * average and not a guaranteed simultaneous voltage/current snapshot. The
+ * 0x8000 reset sentinel is rejected for either half conservatively. */
+static int
+river_qg_sample_sysctl SYSCTL_HANDLER_ARGS
+{
+ if (!__atomic_load_n(&ri_power_ready, __ATOMIC_ACQUIRE)) return ENXIO;
+ uint32_t raw;
+ if (!ri_power_read(ri_power_qg, 0xc0, 4, &raw)) return EIO;
+ uint32_t vr = raw & 0xffffu, ir = raw >> 16;
+ if (vr == 0x8000u || ir == 0x8000u) return ENODATA;
+ int32_t signed_ir = ir < 0x8000u ? (int32_t)ir : (int32_t)ir - 65536;
+ uint32_t uv = (uint32_t)((194637ULL * vr) / 1000);
+ int32_t ua = (int32_t)((152588LL * signed_ir) / 1000);
+ char note[160];
+ snprintf(note, sizeof(note), "voltage_raw=%#x current_raw=%#x voltage_uv=%u current_ua=%d", vr, ir, uv, ua);
+ return sysctl_handle_string(oidp, note, 0, req);
 }
+SYSCTL_PROC(_debug, OID_AUTO, river_qg_sample, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_qg_sample_sysctl, "A", "River QG last ADC diagnostic");
 
 /* On-demand, read-only observer sample. The atomic gate prevents concurrent
  * readers from racing on the same SPMI observer command registers. */
