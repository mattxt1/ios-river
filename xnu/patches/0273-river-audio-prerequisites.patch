+/* Read-only codec prerequisites. Never touches unowned QUP7 or LPASS.
+ * PPIDs are candidates from PM8953 layout, not measured rail voltages.
+ * The existing SPMI helper serializes observer commands and poisons timeouts.
+ */
+static LCK_GRP_DECLARE(ri_audio_survey_grp, "river-audio-survey");
+static LCK_MTX_DECLARE(ri_audio_survey_lock, &ri_audio_survey_grp);
+static int
+river_audio_prereq_sysctl SYSCTL_HANDLER_ARGS
+{
+ char buf[2048];
+ size_t used = 0;
+ static vm_offset_t core, rail[3], pins[6], gcc_ahb, gcc_spi;
+ const unsigned ppids[] = { 0x145, 0x11d, 0x0c5 };
+ const char *names[] = { "L6", "S4", "PMGPIO6" };
+ const unsigned gpios[] = { 46, 68, 135, 136, 137, 138 };
+ if (req->newptr) return EPERM;
+ lck_mtx_lock(&ri_audio_survey_lock);
+#define RAP(...) do { used += snprintf(buf + used, sizeof(buf) - used, __VA_ARGS__); } while (0)
+ RAP("transport=unimplemented capture=synthetic playback=discarded\n");
+ if (!core) core = ri_map(0x0200f000);
+ uint32_t ver = core ? ri_rd(core, 0) : 0;
+ RAP("spmi_version=%#x\n", ver);
+ if (ver >= 0x20010000 && ver < 0x50000000) {
+  for (unsigned i = 0; i < 3; i++) {
+   if (!rail[i]) rail[i] = ri_spmi_obs(core, ppids[i]);
+   uint32_t type = 0, subtype = 0, status = 0, enable = 0;
+   bool ok = rail[i] && ri_spmi_read(rail[i], 4, 1, &type) &&
+       ri_spmi_read(rail[i], 5, 1, &subtype) &&
+       ri_spmi_read(rail[i], 8, 1, &status) &&
+       ri_spmi_read(rail[i], 0x46, 1, &enable);
+   RAP("%s candidate_ppid=%#x readable=%u type=%#x subtype=%#x status=%#x enable=%#x\n",
+       names[i], ppids[i], ok, type, subtype, status, enable);
+  }
+ }
+ for (unsigned i = 0; i < 6; i++) {
+  if (!pins[i]) pins[i] = ri_map(0x01000000 + gpios[i] * 0x1000);
+  if (!pins[i]) { RAP("gpio%u unmapped\n", gpios[i]); continue; }
+  RAP("gpio%u cfg=%#x inout=%#x\n", gpios[i], ri_rd(pins[i], 0), ri_rd(pins[i], 4));
+ }
+ /* GCC is AP-owned and already used for touch/haptics/WCNSS clocks.
+  * Read branch state only; do not enable clocks or access the QUP window.
+  * Offsets: pinned msm-clocks-hwio-8953.h, GCC base 0x01800000. */
+ if (!gcc_ahb) gcc_ahb = ri_map(0x0180b008);
+ if (!gcc_spi) gcc_spi = ri_map(0x0180f01c);
+ if (gcc_ahb && gcc_spi)
+  RAP("blsp2_ahb_cbcr=%#x qup3_spi_cbcr=%#x qup3_spi_cmd=%#x\n",
+      ri_rd(gcc_ahb, 0), ri_rd(gcc_spi, 0), ri_rd(gcc_spi, 8));
+ else RAP("gcc unmapped\n");
+#undef RAP
+ lck_mtx_unlock(&ri_audio_survey_lock);
+ return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_audio_prereq, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_audio_prereq_sysctl, "A", "River read-only codec prerequisites");
