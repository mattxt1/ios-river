 }
 SYSCTL_PROC(_debug, OID_AUTO, river_charge_pon, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
             NULL, 0, river_charge_pon_sysctl, "A", "River PON traffic correlation survey");
+
+/* Experimental PON/charger exclusion only. No interrupt masking, waiting on
+ * the gate, or PMIC control writes. Busy PON polls are deferred to next tick.
+ * Nominal hold is read timeout plus 100 us; preemption can extend it. */
+static int
+river_charge_serial_sysctl SYSCTL_HANDLER_ARGS
+{
+ if (!__atomic_load_n(&ri_power_ready,__ATOMIC_ACQUIRE) || !ri_charge_chgr || !ri_pon_ok) return ENXIO;
+ int expected=0;
+ if (!__atomic_compare_exchange_n(&ri_power_busy,&expected,1,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) return EBUSY;
+ unsigned zero=0,two=0,other=0,errors=0,busy=0,c10=0,c100=0; uint32_t last_error=0;
+ uint32_t deferred=__atomic_load_n(&ri_pon_deferred,__ATOMIC_RELAXED);
+ for (unsigned i=0;i<64;i++) {
+  int gate=0;
+  if (!__atomic_compare_exchange_n(&ri_pon_survey_gate,&gate,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED)) { busy++; continue; }
+  uint32_t status=0,first=0;
+  if (!ri_charge_alt_read(ri_charge_chgr,4,&status,&first)) { errors++; last_error=status; __atomic_store_n(&ri_pon_survey_gate,0,__ATOMIC_RELEASE); continue; }
+  delay(10); uint32_t d10=ri_rd(ri_charge_chgr,0x18)&0xffu;
+  delay(90); uint32_t d100=ri_rd(ri_charge_chgr,0x18)&0xffu;
+  __atomic_store_n(&ri_pon_survey_gate,0,__ATOMIC_RELEASE);
+  if (first==0) zero++; else if (first==2) two++; else other++;
+  c10+=(first!=d10); c100+=(first!=d100);
+ }
+ deferred=__atomic_load_n(&ri_pon_deferred,__ATOMIC_RELAXED)-deferred;
+ char note[256];
+ snprintf(note,sizeof(note),"trials=64 zero=%u two=%u other=%u errors=%u last_error=%#x gate_busy=%u changed10=%u changed100=%u pon_deferred=%u",zero,two,other,errors,last_error,busy,c10,c100,deferred);
+ int error=sysctl_handle_string(oidp,note,0,req);
+ __atomic_store_n(&ri_power_busy,0,__ATOMIC_RELEASE);
+ return error;
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_charge_serial, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_charge_serial_sysctl, "A", "River PON/charger exclusion survey");
 
