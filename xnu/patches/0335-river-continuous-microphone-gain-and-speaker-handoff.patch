diff --git a/bsd/dev/river_mic_lifecycle.h b/bsd/dev/river_mic_lifecycle.h
--- /dev/null
+++ b/bsd/dev/river_mic_lifecycle.h
@@ -0,0 +1,100 @@
+/* Serialized microphone/speaker handoff. Only exact cleanup and restored
+ * clocks allow reuse; DMA page and monotonic APR/channel identities persist. */
+static bool ri_mic_owned_clean(void) {
+ return !ri_pcm.poisoned && !ri_mic.mapped && !ri_mic.in_flight && !ri_mic.running &&
+  !ri_mic.asm_open && !ri_mic.adm_open && !ri_mic.afe_started && !ri_mic.connected &&
+  !ri_mic.defined && !ri_mic.active && !ri_mic.uncertain && !ri_mic.cleanup_error &&
+  (!ri_mic.attempted || (ri_mic.complete && ri_mic.codec_restored));
+}
+static int ri_mic_live_release(void) {
+ lck_mtx_assert(&ri_adsp_lock,LCK_MTX_ASSERT_OWNED);
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ bool busy=ri_mic_live.enabled || ri_mic_live.worker || ri_mic_live.active ||
+  ri_mic_live.requested || ri_mic_live.reader_busy || ri_mic_live.blocked;
+ lck_mtx_unlock(&ri_mic_buffer_lock);
+ if(busy || !ri_mic_owned_clean())return EBUSY;
+ if(ri_mic.live && ri_mic.complete)ri_clock_attempted=0;
+ return 0;
+}
+static int ri_mic_live_rearm(void) {
+ if(!ri_mic_owned_clean())return EBUSY;
+ if(ri_mic.tid>0xef-6)return EOVERFLOW;
+ lck_mtx_lock(&ri_speaker_lock);uint32_t mute=0;
+ bool quiet=ri_cs35l41_rd(0x2024,&mute) && (mute&0x10);
+ lck_mtx_unlock(&ri_speaker_lock);if(!quiet)return EIO;
+ vm_offset_t page=ri_mic.page;uint64_t physical=ri_mic.physical;unsigned tid=ri_mic.tid;
+ if(ri_mic.attempted)ri_clock_attempted=0;
+ if(ri_clock_attempted)return EBUSY;
+ memset(&ri_mic,0,sizeof(ri_mic));ri_mic.page=page;ri_mic.physical=physical;ri_mic.tid=tid;
+ ri_mic.live=ri_mic.attempted=true;
+ lck_mtx_lock(&ri_mic_buffer_lock);ri_mic.gain_level=ri_mic_live.gain;lck_mtx_unlock(&ri_mic_buffer_lock);
+ return 0;
+}
+static void ri_mic_live_worker(void *arg,wait_result_t wait) {
+ (void)arg;(void)wait;
+ for(;;) {
+  lck_mtx_lock(&ri_mic_buffer_lock);
+  bool quit=!ri_mic_live.enabled && !ri_mic_live.active;
+  bool run=ri_mic_live.enabled && ri_mic_live.requested && !ri_mic_live.active;
+  if(run) {ri_mic_live.active=true;ri_mic_live.requested=false;}
+  lck_mtx_unlock(&ri_mic_buffer_lock);
+  if(quit)break;
+  if(!run) {ri_wait(5);continue;}
+  lck_mtx_lock(&ri_adsp_lock);
+  int error=ri_mic_live_rearm();
+  if(!error) {
+   lck_mtx_lock(&ri_codec_lock);lck_mtx_lock(&ri_speaker_lock);
+   ri_clock_capture_test=ri_mic_codec;
+   error=ri_clock_run_impl(true,true,false);ri_clock_capture_test=NULL;
+   lck_mtx_unlock(&ri_speaker_lock);lck_mtx_unlock(&ri_codec_lock);
+   ri_mic.complete=!error && !ri_pcm.poisoned && ri_mic.codec_restored &&
+    !ri_mic.mapped && !ri_mic.in_flight && !ri_mic.running && !ri_mic.asm_open &&
+    !ri_mic.adm_open && !ri_mic.afe_started && !ri_mic.connected && !ri_mic.defined &&
+    !ri_mic.active && !ri_mic.uncertain && !ri_mic.cleanup_error;
+  }
+  bool clean=ri_mic_owned_clean();
+  if(!error && !clean)error=EIO;
+  ri_mic.error=error;
+  lck_mtx_lock(&ri_mic_buffer_lock);
+  ri_mic_live.sessions++;ri_mic_live.active=false;ri_mic_live.stop=true;
+  ri_mic_live.error=error;
+  if(error) {ri_mic_live.blocked=true;ri_mic_live.enabled=false;}
+  snprintf(ri_mic_live.note,sizeof(ri_mic_live.note),"cleanup_verified=%u phase=%s poisoned=%u mapped=%u in_flight=%u submitted=%u completed=%u asm_open=%u adm_open=%u afe_started=%u source_connected=%u channel_defined=%u channel_active=%u uncertain=%u codec_restored=%u cleanup_error=%d tid=%u physical=%#llx failed_opcode=%#x failed_status=%#x adm_reply=%#x,%#x clock={%s}",
+   clean,ri_mic.phase?ri_mic.phase:"prerequisite",ri_pcm.poisoned,ri_mic.mapped,ri_mic.in_flight,
+   ri_mic.submitted,ri_mic.completed,ri_mic.asm_open,ri_mic.adm_open,ri_mic.afe_started,
+   ri_mic.connected,ri_mic.defined,ri_mic.active,ri_mic.uncertain,ri_mic.codec_restored,
+   ri_mic.cleanup_error,ri_mic.tid,(unsigned long long)ri_mic.physical,ri_mic.failed_opcode,
+   ri_mic.failed_status,ri_mic.adm_reply[0],ri_mic.adm_reply[1],ri_clock_note);
+  wakeup(&ri_mic_live);lck_mtx_unlock(&ri_mic_buffer_lock);lck_mtx_unlock(&ri_adsp_lock);
+ }
+ lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.worker=false;wakeup(&ri_mic_live);
+ lck_mtx_unlock(&ri_mic_buffer_lock);
+ (void)thread_terminate(current_thread());thread_block(THREAD_CONTINUE_NULL);
+}
+static int ri_mic_live_enable(void) {
+ lck_mtx_lock(&ri_adsp_lock);lck_mtx_lock(&ri_mic_buffer_lock);
+ bool duplicate=ri_mic_live.attempted || ri_mic_live.worker;
+ lck_mtx_unlock(&ri_mic_buffer_lock);
+ if(duplicate) {lck_mtx_unlock(&ri_adsp_lock);return EALREADY;}
+ lck_mtx_lock(&ri_audio_queue_lock);
+ bool output_busy=ri_audio_auto.enabled || ri_audio_auto.worker || ri_audio_auto.active;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ if(output_busy || ri_mic_capture.attempted || !ri_stream.complete || !ri_route_ready() ||
+    !ri_route.muted || !ri_afe_mute_hold || !ri_ngd.address_valid || !ri_ngd.enabled ||
+    ri_ngd.uncertain || !ri_mic_owned_clean()) {lck_mtx_unlock(&ri_adsp_lock);return EBUSY;}
+ int error=ri_audio_auto_rearm();
+ if(error) {lck_mtx_unlock(&ri_adsp_lock);return error;}
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ if(ri_mic_live.attempted || ri_mic_live.worker) {
+  lck_mtx_unlock(&ri_mic_buffer_lock);lck_mtx_unlock(&ri_adsp_lock);return EALREADY;
+ }
+ ri_mic_live.attempted=ri_mic_live.enabled=ri_mic_live.worker=true;
+ lck_mtx_unlock(&ri_mic_buffer_lock);lck_mtx_unlock(&ri_adsp_lock);
+ thread_t thread=THREAD_NULL;
+ if(kernel_thread_start(ri_mic_live_worker,NULL,&thread)!=KERN_SUCCESS) {
+  lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.enabled=ri_mic_live.worker=false;
+  ri_mic_live.blocked=true;ri_mic_live.error=ENOMEM;wakeup(&ri_mic_live);
+  lck_mtx_unlock(&ri_mic_buffer_lock);return ENOMEM;
+ }
+ thread_deallocate(thread);return 0;
+}
diff --git a/bsd/dev/river_mic_live.h b/bsd/dev/river_mic_live.h
--- /dev/null
+++ b/bsd/dev/river_mic_live.h
@@ -0,0 +1,153 @@
+/* Explicit supervised physical input. The stash mutex owns only CPU ring and
+ * lifecycle metadata. Device readers sleep interruptibly; hardware stays on
+ * the dedicated worker. No DSP ownership waits or SPI under this mutex. */
+#define RI_MIC_RING_FRAMES 16384u
+static struct {
+ bool attempted,enabled,worker,active,requested,stop,blocked,reader_busy;
+ unsigned opens,sessions,epoch,head,used,high_water,gain,applied_gain,reason;
+ unsigned overruns,waits,read_faults;
+ uint64_t last_read,produced,consumed,discarded;
+ struct {uint64_t frames,squares,clipped;unsigned peak;} levels[3];
+ int error;
+ int16_t samples[RI_MIC_RING_FRAMES];
+ char note[2048];
+} ri_mic_live;
+static int ri_mic_live_enable(void);
+static int ri_mic_live_release(void);
+static void ri_mic_live_open(void) {
+ lck_mtx_lock(&ri_mic_buffer_lock);ri_mic_live.opens++;
+ if(ri_mic_live.enabled && !ri_mic_live.active && !ri_mic_live.requested && ri_mic_live.sessions) {
+  ri_mic_live.discarded+=ri_mic_live.used;ri_mic_live.head=ri_mic_live.used=0;ri_mic_live.stop=false;
+ }lck_mtx_unlock(&ri_mic_buffer_lock);
+}
+static void ri_mic_live_close(void) {
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ if(ri_mic_live.opens)ri_mic_live.opens--;
+ if(ri_mic_live.active || ri_mic_live.requested) {
+  ri_mic_live.stop=true;ri_mic_live.reason=1;
+  ri_mic_live.discarded+=ri_mic_live.used;ri_mic_live.used=ri_mic_live.head=0;
+  if(!ri_mic_live.active)ri_mic_live.requested=false;
+ }
+ wakeup(&ri_mic_live);lck_mtx_unlock(&ri_mic_buffer_lock);
+}
+static bool ri_mic_live_stop(void) {
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ bool stop=ri_mic_live.stop || !ri_mic_live.enabled;
+ if(!stop && ri_audio_queue_now()-ri_mic_live.last_read>250000000ULL) {
+  stop=ri_mic_live.stop=true;ri_mic_live.reason=3;
+ }
+ lck_mtx_unlock(&ri_mic_buffer_lock);return stop;
+}
+static int ri_mic_live_push(const int16_t *samples,unsigned frames,unsigned gain) {
+ if(!samples || frames>2048 || gain>2)return EINVAL;
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ ri_mic_live.produced+=frames;
+ if(ri_mic_live.stop || !ri_mic_live.enabled) {
+  ri_mic_live.discarded+=frames;lck_mtx_unlock(&ri_mic_buffer_lock);return 0;
+ }
+ if(frames>RI_MIC_RING_FRAMES-ri_mic_live.used) {
+  ri_mic_live.overruns++;ri_mic_live.error=EOVERFLOW;ri_mic_live.discarded+=frames;
+  lck_mtx_unlock(&ri_mic_buffer_lock);return EOVERFLOW;
+ }
+ for(unsigned n=0;n<frames;n++) {
+  int value=samples[n];unsigned peak=value<0?(unsigned)-value:(unsigned)value;
+  ri_mic_live.samples[(ri_mic_live.head+ri_mic_live.used+n)%RI_MIC_RING_FRAMES]=samples[n];
+  ri_mic_live.levels[gain].frames++;
+  uint64_t square=(uint64_t)((int64_t)value*value);
+  if(ri_mic_live.levels[gain].squares<=~0ULL-square)ri_mic_live.levels[gain].squares+=square;
+  if(peak>ri_mic_live.levels[gain].peak)ri_mic_live.levels[gain].peak=peak;
+  if(peak>=32760)ri_mic_live.levels[gain].clipped++;
+ }
+ ri_mic_live.used+=frames;
+ if(ri_mic_live.used>ri_mic_live.high_water)ri_mic_live.high_water=ri_mic_live.used;
+ wakeup(&ri_mic_live);lck_mtx_unlock(&ri_mic_buffer_lock);return 0;
+}
+static int ri_mic_live_read(int16_t *out,unsigned frames,bool nonblock) {
+ if(!out || !frames || frames>512)return -EINVAL;
+ lck_mtx_lock(&ri_mic_buffer_lock);int result=-ENXIO;
+ if(!ri_mic_live.attempted)goto done;
+ if(ri_mic_live.reader_busy) {result=-EBUSY;goto done;}
+ /* HAL may retain its descriptor between recordings. A NEW read call after
+  * acknowledged close/idle teardown requests a fresh generation; a reader
+  * already waiting during stop still gets EOF. Old tail is explicitly counted. */
+ if(ri_mic_live.enabled && !ri_mic_live.active && !ri_mic_live.requested &&
+    ri_mic_live.stop && ri_mic_live.sessions &&
+    (ri_mic_live.reason==1 || ri_mic_live.reason==3)) {
+  ri_mic_live.discarded+=ri_mic_live.used;ri_mic_live.head=ri_mic_live.used=0;ri_mic_live.stop=false;
+ }
+ ri_mic_live.reader_busy=true;
+ uint64_t begin=ri_audio_queue_now();
+ for(;;) {
+  if(ri_mic_live.blocked) {result=-EIO;break;}
+  if(ri_mic_live.used) {
+   if(frames>ri_mic_live.used)frames=ri_mic_live.used;
+   for(unsigned n=0;n<frames;n++)out[n]=ri_mic_live.samples[(ri_mic_live.head+n)%RI_MIC_RING_FRAMES];
+   ri_mic_live.head=(ri_mic_live.head+frames)%RI_MIC_RING_FRAMES;
+   ri_mic_live.used-=frames;ri_mic_live.consumed+=frames;
+   ri_mic_live.last_read=ri_audio_queue_now();result=(int)frames;break;
+  }
+  if(!ri_mic_live.enabled || ri_mic_live.stop) {result=0;break;}
+  if(!ri_mic_live.opens) {result=-EBADF;break;}
+  if(!ri_mic_live.active && !ri_mic_live.requested) {
+   ri_mic_live.stop=false;ri_mic_live.requested=true;ri_mic_live.epoch++;
+   ri_mic_live.last_read=ri_audio_queue_now();
+  }
+  ri_mic_live.last_read=ri_audio_queue_now();
+  if(nonblock) {result=-EWOULDBLOCK;break;}
+  if(ri_audio_queue_now()-begin>10000000000ULL) {
+   ri_mic_live.stop=true;ri_mic_live.reason=4;result=-ETIMEDOUT;break;
+  }
+  ri_mic_live.waits++;
+  struct timespec timeout={0,100000000};
+  int error=msleep(&ri_mic_live,&ri_mic_buffer_lock,PCATCH,"rivermic",&timeout);
+  if(error && error!=EWOULDBLOCK) {
+   ri_mic_live.stop=true;ri_mic_live.reason=4;result=-error;break;
+  }
+ }
+ ri_mic_live.reader_busy=false;
+ done:lck_mtx_unlock(&ri_mic_buffer_lock);return result;
+}
+static void ri_mic_live_read_fault(unsigned frames) {
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ if(ri_mic_live.attempted) {
+  ri_mic_live.read_faults++;ri_mic_live.discarded+=frames;
+  if(ri_mic_live.consumed>=frames)ri_mic_live.consumed-=frames;
+  ri_mic_live.stop=true;ri_mic_live.reason=4;
+ }
+ lck_mtx_unlock(&ri_mic_buffer_lock);
+}
+static uint32_t ri_mic_live_flags(void) {
+ lck_mtx_lock(&ri_mic_buffer_lock);
+ uint32_t flags=ri_mic_live.attempted?HAKIOS_AUDIO_CAPTURE_PHYSICAL_LIVE:0;
