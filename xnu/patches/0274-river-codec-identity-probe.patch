 SYSCTL_PROC(_debug, OID_AUTO, river_audio_prereq, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
             NULL, 0, river_audio_prereq_sysctl, "A", "River read-only codec prerequisites");
