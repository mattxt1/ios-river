 done:
diff --git a/bsd/dev/river_adsp_tone.h b/bsd/dev/river_adsp_tone.h
--- a/bsd/dev/river_adsp_tone.h
+++ b/bsd/dev/river_adsp_tone.h
@@ -4,14 +4,22 @@
 static struct {
  bool attempted,active,enabled,stopped,cutoff;
  uint32_t power,mute,volume,want_volume,irq1,irq3;
+ uint64_t armed_at,unmuted_at,muted_at,max_check_ns;
  int error;
 } ri_tone;
 static thread_call_t ri_tone_timer;
+static uint64_t
+ri_tone_now_ns(void)
+{
+ uint64_t absolute,ns;clock_get_uptime(&absolute);
+ absolutetime_to_nanoseconds(absolute,&ns);return ns;
+}
 static bool
 ri_tone_mute_locked(void)
 {
  ri_tone.active=false;
  bool ok=ri_i2s_amp_write(0x2024,ri_tone.mute|0x10);
+ if(ok && !ri_tone.muted_at)ri_tone.muted_at=ri_tone_now_ns();
  if(!ri_i2s_amp_write(0x2018,ri_tone.power&~1u))ok=false;
  if(!ri_i2s_amp_write(0x6000,ri_tone.volume))ok=false;
  ri_tone.stopped=ok;return ok;
@@ -53,7 +61,7 @@
  /* Fixed -24dB digital attenuation, signed11-bit eighth-dB PCM_VOL.
   * Samples are additionally bounded to +/-2048 with5ms end ramps. */
  ri_tone.want_volume=(ri_tone.volume&~0x3ff8u)|(((0u-192u)&0x7ffu)<<3);
- ri_tone.active=true;uint64_t deadline;
+ ri_tone.armed_at=ri_tone_now_ns();ri_tone.active=true;uint64_t deadline;
  clock_interval_to_deadline(750,NSEC_PER_MSEC,&deadline);
  thread_call_enter_delayed(ri_tone_timer,deadline);
  if(!ri_i2s_amp_write(0x6000,ri_tone.want_volume) ||
@@ -64,19 +72,22 @@
  if(!ri_tone_locked_clocks() || !ri_i2s_amp_write(0x2024,ri_tone.mute&~0x10u)) {
   error=EIO;(void)ri_tone_mute_locked();goto done;
  }
- ri_tone.enabled=true;error=0;
+ ri_tone.unmuted_at=ri_tone_now_ns();ri_tone.enabled=true;error=0;
 done:
  ri_tone.error=error;lck_mtx_unlock(&ri_speaker_lock);return error;
 }
 static int
 ri_tone_check(void)
 {
+ uint64_t begin=ri_tone_now_ns();
  int error=0;uint32_t power=0,mute=0,volume=0;lck_mtx_lock(&ri_speaker_lock);
  if(!ri_tone.active || ri_tone.cutoff)error=ETIMEDOUT;
  else if(!ri_tone_locked_clocks() || !ri_cs35l41_rd(0x2018,&power) || !(power&1) ||
    !ri_cs35l41_rd(0x2024,&mute) || (mute&0x10) ||
    !ri_cs35l41_rd(0x6000,&volume) || volume!=ri_tone.want_volume)error=EIO;
  if(error)ri_tone.error=error;
+ uint64_t elapsed=ri_tone_now_ns()-begin;
+ if(elapsed>ri_tone.max_check_ns)ri_tone.max_check_ns=elapsed;
  lck_mtx_unlock(&ri_speaker_lock);return error;
 }
