diff --git a/bsd/dev/river_adsp_stream.h b/bsd/dev/river_adsp_stream.h
--- a/bsd/dev/river_adsp_stream.h
+++ b/bsd/dev/river_adsp_stream.h
@@ -211,7 +211,9 @@
   error=ri_stream_command(state,stream|0x507,stream|0x407,0x10bdb,0x10c1c,NULL,0,&reply);
   if(error)goto done;
   if(reply.words) {ri_pcm.poisoned=true;error=EIO;goto done;}
-  state->eos_rendered=true;error=ri_stream_output_check();if(error)goto done;
+  /* Playback has drained. Mute immediately below instead of spending the
