+/* Dedicated automatic route owner. Only acknowledged complete teardown can
+ * release one-shot state for another session. Poison/reset/fault/unknown buffer
+ * ownership is sticky until reboot. Never clear ri_pcm.sequence or NGD IDs. */
+static bool
+ri_audio_auto_clean(void)
+{
+ return !ri_pcm.poisoned && !ri_live_stream.mapped && !ri_live_stream.in_flight &&
+  !ri_live_stream.running && !ri_live_stream.afe_prepared && !ri_live_stream.unmap_error &&
+  !ri_route.asm_open && !ri_route.adm_open && !ri_route.afe_started &&
+  !ri_route.matrix && !ri_route.cleanup_error && !ri_route.failed_opcode &&
+  !ri_channel.connected && !ri_channel.defined && !ri_channel.active &&
+  !ri_channel.uncertain && !ri_channel.cleanup_error &&
+  !ri_tone.active && !ri_tone.cutoff && !ri_tone.error &&
+  (!ri_tone.attempted || ri_tone.stopped) &&
+  (!ri_codec_path.attempted || (ri_codec_path.complete && ri_codec_path.restored &&
+   ri_live_stream.complete && ri_live_stream.eos_rendered && ri_channel.complete &&
+   ri_i2s_codec_restored && ri_i2s_amp_restored && ri_clock_data_restored));
+}
+static int
+ri_audio_auto_rearm(void)
+{
+ lck_mtx_assert(&ri_adsp_lock,LCK_MTX_ASSERT_OWNED);
+ if(!ri_audio_auto_clean())return EBUSY;
+ if(!ri_codec_path.attempted)return 0;
+ /* Make sure a previous timer is no longer executing before clearing its
+  * state. Speaker/QUP2 remain free throughout the cancellation wait. */
+ if(ri_tone_timer)thread_call_cancel_wait(ri_tone_timer);
+ lck_mtx_lock(&ri_speaker_lock);
+ uint32_t mute=0,power=0,format=0;
+ /* The fully restored idle snapshot may retain silicon-shutdown power/
+  * format bits. Match that snapshot exactly and require protective mute;
+  * do not apply the different live-I2S quiet-state predicate at idle. */
+ bool quiet=ri_cs35l41_rd(0x2024,&mute) && (mute&0x10) && mute==ri_i2s_amp_saved[1] &&
+  ri_cs35l41_rd(0x2018,&power) && power==ri_i2s_amp_saved[0] &&
+  ri_cs35l41_rd(0x4808,&format) && format==ri_i2s_amp_saved[4];
+ if(!quiet) {lck_mtx_unlock(&ri_speaker_lock);return EIO;}
+ vm_offset_t page=ri_live_stream.page;uint64_t physical=ri_live_stream.physical;
+ unsigned tid=ri_channel.tid;
+ if(tid>0xef-6) {lck_mtx_unlock(&ri_speaker_lock);return EOVERFLOW;}
+ memset(&ri_live_stream,0,sizeof(ri_live_stream));
+ ri_live_stream.page=page;ri_live_stream.physical=physical;
+ memset(&ri_channel,0,sizeof(ri_channel));ri_channel.tid=tid;
+ memset(&ri_codec_path,0,sizeof(ri_codec_path));
+ memset(&ri_tone,0,sizeof(ri_tone));ri_clock_attempted=0;
+ ri_live_health_index=0;
+ lck_mtx_unlock(&ri_speaker_lock);return 0;
+}
+static void
+ri_audio_auto_worker(void *arg,wait_result_t wait)
+{
+ (void)arg;(void)wait;
+ for(;;) {
+  bool run=false,quit=false;
+  lck_mtx_lock(&ri_audio_queue_lock);
+  if(!ri_audio_auto.enabled && !ri_audio_auto.active)quit=true;
+  else if(ri_audio_queue.armed && !ri_audio_auto.active) {
+   uint64_t now=ri_audio_queue_now();
+   if(ri_audio_queue.used && now-ri_audio_auto.last_write>=150000000ULL) {
+    ri_audio_auto.drain=true;ri_audio_auto.reason=3; /* inactive writer */
+   }
+   if(ri_audio_queue.used>=4096 || (ri_audio_auto.drain && ri_audio_queue.used)) {
+    ri_audio_auto.active=true;ri_audio_queue.launched=true;run=true;
+   }
+  }
+  lck_mtx_unlock(&ri_audio_queue_lock);
+  if(quit)break;
+  if(!run) {ri_wait(5);continue;}
+  lck_mtx_lock(&ri_adsp_lock);
+  int error=ri_audio_auto_rearm();
+  if(!error)error=ri_codec_path_run_mode(4);
+  bool clean=ri_audio_auto_clean();
+  lck_mtx_unlock(&ri_adsp_lock);
+  lck_mtx_lock(&ri_audio_queue_lock);
+  ri_audio_auto.sessions++;if(ri_audio_auto.sessions>1)ri_audio_auto.restarts++;
+  ri_audio_auto.completed_total+=ri_audio_queue.consumed;
+  ri_audio_auto.error=error?error:clean?0:EIO;
+  ri_audio_auto.active=false;ri_audio_queue.done=true;
+  ri_audio_queue.error=ri_audio_auto.error;ri_audio_queue.armed=false;
+  ri_audio_queue.discarded_at_stop+=ri_audio_queue.used;ri_audio_queue.used=0;
+  if(ri_audio_auto.error) {
+   ri_audio_auto.enabled=false;ri_audio_auto.blocked=true;
+  } else if(ri_audio_queue.dsp_submitted==ri_audio_queue.target_blocks) {
+   /* Reaching the validation cap cannot silently chain more output. */
+   ri_audio_auto.enabled=false;ri_audio_auto.at_limit=true;ri_audio_auto.reason=5;
+  } else if(ri_audio_auto.sessions>=3) {
+   ri_audio_auto.enabled=false;ri_audio_auto.at_limit=true;
+  }
+  /* Outstanding user copies must cancel before a new generation can arm.
+   * reserve() sees drain and returns backpressure until all have returned. */
+  ri_audio_auto.drain=true;
+  lck_mtx_unlock(&ri_audio_queue_lock);
+  for(;;) {
+   lck_mtx_lock(&ri_audio_queue_lock);bool pending=ri_audio_queue.reserved!=0;
+   if(!pending)ri_audio_auto.drain=false;
+   lck_mtx_unlock(&ri_audio_queue_lock);
+   if(!pending)break;
+   ri_wait(1);
+  }
+ }
+ lck_mtx_lock(&ri_audio_queue_lock);ri_audio_auto.worker=false;
+ lck_mtx_unlock(&ri_audio_queue_lock);
+ (void)thread_terminate(current_thread());thread_block(THREAD_CONTINUE_NULL);
+}
+static int
+ri_audio_auto_enable(void)
+{
+ /* Explicit once-per-boot supervised enable; writes/open/idle/close drive
+  * all following starts/stops. Old diagnostic controls stay one-shot. */
+ lck_mtx_lock(&ri_adsp_lock);
+ bool ready=ri_stream.complete && ri_route_ready() && ri_route.muted && ri_afe_mute_hold &&
+  ri_ngd.address_valid && ri_ngd.enabled && !ri_ngd.uncertain &&
+  !ri_codec_path.attempted && !ri_live_stream.attempted && !ri_channel.attempted;
+ if(!ready) {lck_mtx_unlock(&ri_adsp_lock);return EBUSY;}
+ lck_mtx_lock(&ri_audio_queue_lock);
+ if(ri_audio_auto.worker || ri_audio_auto.blocked || ri_audio_auto.sessions ||
+    ri_audio_queue.armed || ri_audio_queue.reserved || ri_audio_queue.launched) {
+  lck_mtx_unlock(&ri_audio_queue_lock);lck_mtx_unlock(&ri_adsp_lock);return EBUSY;
+ }
+ ri_audio_auto.enabled=ri_audio_auto.worker=true;
+ lck_mtx_unlock(&ri_audio_queue_lock);lck_mtx_unlock(&ri_adsp_lock);
+ thread_t thread=THREAD_NULL;
+ if(kernel_thread_start(ri_audio_auto_worker,NULL,&thread)!=KERN_SUCCESS) {
+  lck_mtx_lock(&ri_audio_queue_lock);ri_audio_auto.enabled=ri_audio_auto.worker=false;
+  ri_audio_auto.blocked=true;ri_audio_auto.error=ENOMEM;
+  lck_mtx_unlock(&ri_audio_queue_lock);return ENOMEM;
+ }
+ thread_deallocate(thread);return 0;
+}
