+ lck_mtx_lock(&river_apple80211_mtx);
+ if (!river_power_state || req->generation != join_generation) {
+  lck_mtx_unlock(&river_apple80211_mtx);
+  return false;
+ }
+ join_result = (uint32_t)status;
+ join_pending_flag = false;
+ bzero(&active_bss, sizeof(active_bss));
+ active_phase = status ? PHASE_IDLE : PHASE_JOINED;
+ if (!status) {
+  for (unsigned i=0;i<river_bss_count;i++)
+   if (!memcmp(river_bss_table[i].bssid,info->bssid,6)) {
+    memcpy(&active_bss,&river_bss_table[i],sizeof(active_bss));break;
+   }
+  active_bss.ssid_len=req->ssid_len;
+  memcpy(active_bss.ssid,req->ssid,req->ssid_len);
+  memcpy(active_bss.bssid,info->bssid,6);
+  active_bss.channel=info->channel;
+  active_bss.rssi=info->rssi;
+ }
+ struct apple80211_link_changed link = {
+  .down=status!=0,.involuntary=status!=0,.rssi=status?0:info->rssi,.reason=status?4:0,
+ };
+ /* Serialize completion publication with a new join/disconnect request. */
+ post(EVENT_SSID_CHANGED,NULL,0);post(EVENT_BSSID_CHANGED,NULL,0);
+ post(EVENT_LINK_CHANGED,&link,sizeof(link));post(EVENT_ASSOC_DONE,NULL,0);
+ lck_mtx_unlock(&river_apple80211_mtx);
+ return true;
+}
+bool
+river_apple80211_link_lost(uint64_t generation,int16_t rssi)
+{
+ lck_mtx_lock(&river_apple80211_mtx);
+ if (generation != join_generation) {lck_mtx_unlock(&river_apple80211_mtx);return false;}
+ active_phase=PHASE_IDLE;bzero(&active_bss,sizeof(active_bss));
+ struct apple80211_link_changed link = {.down=1,.involuntary=1,.rssi=rssi,.reason=4};
+ post(EVENT_SSID_CHANGED,NULL,0);post(EVENT_BSSID_CHANGED,NULL,0);
+ post(EVENT_LINK_CHANGED,&link,sizeof(link));
+ lck_mtx_unlock(&river_apple80211_mtx);
+ return true;
+}
