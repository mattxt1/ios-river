diff --git a/bsd/dev/river_native_pcm.h b/bsd/dev/river_native_pcm.h
--- a/bsd/dev/river_native_pcm.h
+++ b/bsd/dev/river_native_pcm.h
@@ -0,0 +1,91 @@
+/* Opt-in one-shot native iOS PCM staging, not microphone capture or a live
+ * playback backend. The existing /dev callback supplies48k stereoS16.
+ * Freeze16KiB at first nonsilent frame. No hardware I/O on the writer thread.
+ * Only the explicit bounded codec test may claim and replay this snapshot. */
+#if defined(KERNEL)
+#include <sys/hakios.audio.h>
+_Static_assert(HAKIOS_AUDIO_RATE==48000 && HAKIOS_AUDIO_CHANNELS==2 && HAKIOS_AUDIO_FRAME==4,"Native PCM staging ABI");
+#endif
+static LCK_GRP_DECLARE(ri_native_pcm_group,"river-native-pcm");
+static LCK_MTX_DECLARE(ri_native_pcm_lock,&ri_native_pcm_group);
+static struct {
+ bool armed,started,ready,claimed;
+ unsigned frames,peak,rejected;
+ uint64_t observed_frames;
+ int16_t samples[4096*2];
+} ri_native_pcm;
+static int
+ri_native_pcm_arm(void)
+{
+ int error=0;lck_mtx_lock(&ri_native_pcm_lock);
+ if(ri_native_pcm.armed || ri_native_pcm.ready || ri_native_pcm.claimed)error=EALREADY;
+ else {memset(&ri_native_pcm,0,sizeof(ri_native_pcm));ri_native_pcm.armed=true;}
+ lck_mtx_unlock(&ri_native_pcm_lock);return error;
+}
+static void
+ri_native_pcm_push(const int16_t *pcm,size_t frames)
+{
+ lck_mtx_lock(&ri_native_pcm_lock);
+ if(!ri_native_pcm.armed)goto done;
+ /* river_audio_write emits atmost1024frames per callback. Reject a foreign
+  * oversized/null call before reading any source memory. */
+ if(!pcm || frames>1024) {ri_native_pcm.rejected++;goto done;}
+ ri_native_pcm.observed_frames+=frames;
+ for(unsigned i=0;i<frames && ri_native_pcm.frames<4096;i++) {
+  int32_t left=pcm[i*2],right=pcm[i*2+1];
+  unsigned a=left<0?(unsigned)-left:(unsigned)left;
+  unsigned b=right<0?(unsigned)-right:(unsigned)right;
+  if(!ri_native_pcm.started && a<=8 && b<=8)continue;
+  ri_native_pcm.started=true;unsigned n=ri_native_pcm.frames++;
+  ri_native_pcm.samples[n*2]=(int16_t)left;ri_native_pcm.samples[n*2+1]=(int16_t)right;
+  if(a>ri_native_pcm.peak)ri_native_pcm.peak=a;
+  if(b>ri_native_pcm.peak)ri_native_pcm.peak=b;
+ }
+ if(ri_native_pcm.frames==4096) {ri_native_pcm.ready=true;ri_native_pcm.armed=false;}
+ done:lck_mtx_unlock(&ri_native_pcm_lock);
+}
+static bool
+ri_native_pcm_claim(void)
+{
+ lck_mtx_lock(&ri_native_pcm_lock);
+ bool ok=ri_native_pcm.ready && !ri_native_pcm.claimed;
+ if(ok)ri_native_pcm.claimed=true;
+ lck_mtx_unlock(&ri_native_pcm_lock);return ok;
+}
+static bool
+ri_native_pcm_fill(int16_t *target,unsigned index)
+{
+ if(!target || index>=4)return false;
+ lck_mtx_lock(&ri_native_pcm_lock);
+ bool ok=ri_native_pcm.ready && ri_native_pcm.claimed && ri_native_pcm.frames==4096;
+ if(ok)for(unsigned i=0;i<1024;i++) {
+  unsigned frame=index*1024+i,remaining=4095-frame;
+  unsigned ramp=frame<240?frame:remaining<240?remaining:240;
+  for(unsigned channel=0;channel<2;channel++) {
+   int value=ri_native_pcm.samples[frame*2+channel];
+   if(value>2048)value=2048;if(value<-2048)value=-2048;
+   target[i*2+channel]=(int16_t)(value*(int)ramp/240);
+  }
+ }
+ lck_mtx_unlock(&ri_native_pcm_lock);return ok;
+}
+static int
+river_native_pcm_stage_sysctl SYSCTL_HANDLER_ARGS
+{
+ int value=0,error=sysctl_handle_int(oidp,&value,0,req);
+ if(error || !req->newptr)return error;
+ if(value!=1)return EINVAL;return ri_native_pcm_arm();
+}
+static int
+river_native_pcm_status_sysctl SYSCTL_HANDLER_ARGS
+{
+ char note[384];lck_mtx_lock(&ri_native_pcm_lock);
+ snprintf(note,sizeof(note),"armed=%u started=%u ready=%u claimed=%u frames=%u capacity_frames=4096 observed_frames=%llu peak=%u rejected=%u rate=48000 channels=2 bits=16 source=ios_device_write replay=explicit_bounded_only ios_backend=discarded capture=synthetic",
+  ri_native_pcm.armed,ri_native_pcm.started,ri_native_pcm.ready,ri_native_pcm.claimed,
+  ri_native_pcm.frames,(unsigned long long)ri_native_pcm.observed_frames,ri_native_pcm.peak,ri_native_pcm.rejected);
+ lck_mtx_unlock(&ri_native_pcm_lock);return sysctl_handle_string(oidp,note,sizeof(note),req);
+}
+SYSCTL_PROC(_debug,OID_AUTO,river_native_pcm_stage,CTLTYPE_INT|CTLFLAG_RW|CTLFLAG_LOCKED,
+ NULL,0,river_native_pcm_stage_sysctl,"I","Arm one-shot native PCM snapshot without playback");
+SYSCTL_PROC(_debug,OID_AUTO,river_native_pcm_status,CTLTYPE_STRING|CTLFLAG_RD|CTLFLAG_LOCKED,
+ NULL,0,river_native_pcm_status_sysctl,"A","Native PCM snapshot metadata; never sample contents");
