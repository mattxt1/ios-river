diff --git a/bsd/dev/river_adsp_pipeline.h b/bsd/dev/river_adsp_pipeline.h
--- /dev/null
+++ b/bsd/dev/river_adsp_pipeline.h
@@ -0,0 +1,143 @@
+/* Four independently owned DMA slots; only this ADSP-locked worker accesses
+ * CID6 while the pipeline is active. Every reply is dispatched by exact token
+ * then decoded using the established service/port/opcode checks. */
+struct ri_pipeline_slot {
+ struct ri_apr_request request;
+ uint64_t address,submitted_ns;
+ bool owned;
+};
+static uint64_t
+ri_pipeline_now(void)
+{
+ uint64_t t,ns;clock_get_uptime(&t);absolutetime_to_nanoseconds(t,&ns);return ns;
+}
+static int
+ri_pipeline_publish(struct ri_apr_channel *ch,struct ri_pipeline_slot *slot,
+ uint32_t stream,uint64_t address,uint32_t handle,unsigned block)
+{
+ vm_offset_t smem=river_smd_smem;
+ struct ri_apr_channel again;
+ if(!ri_apr.received || !ri_apr.state || !ri_apr.owned || !ri_apr.opened ||
+    !ri_apr_dsp_ready(smem) || !ri_apr_resolve(smem,&again) ||
+    again.info!=ch->info || again.tx!=ch->tx || again.rx!=ch->rx ||
+    ri_rd(ch->info,0)!=2 || ri_rd(ch->info,20)!=2 || !ri_apr_indices(ch))return EIO;
+ if(slot->owned || ri_pcm.sequence==0xffffffffu-0x52420000u)return EOVERFLOW;
+ uint32_t head=ri_rd(ch->info,16),tail=ri_rd(ch->info,12);
+ if(((tail-head-4)&8191)<72)return EWOULDBLOCK;
+ slot->request=(struct ri_apr_request){.source=stream|0x507,.destination=stream|0x407,
+  .opcode=0x10dab,.response=0x10d99,.token=0x52420000u+(++ri_pcm.sequence)};
+ uint32_t frame[18]={52,0,0,0,0,(52u<<16)|0x250,
+  slot->request.source,slot->request.destination,slot->request.token,0x10dab,
+  (uint32_t)address,(uint32_t)(address>>32),handle,4096,block,0,0,0};
+ for(unsigned i=0;i<72;i+=4)ri_wr(ch->tx,(head+i)&8191,frame[i/4]);
+ __asm__ volatile("dmb sy" ::: "memory");
+ slot->address=address;slot->submitted_ns=ri_pipeline_now();slot->owned=true;
+ ri_pcm.transactions++;ri_wr(ch->info,16,(head+72)&8191);
+ ri_apr_write8(ch->info+8,1);ri_apr_notify(ch);return 0;
+}
+/* Exactly one packet per poll; no matching token => stale, no slot released.
+ * A malformed packet or transport reset poisons all unresolved ownership. */
+static int
+ri_pipeline_receive(struct ri_apr_channel *ch,struct ri_pipeline_slot slots[4],
+ uint32_t handle,unsigned *completed)
+{
+ if(!ri_apr_dsp_ready(river_smd_smem) || ri_rd(ch->info,0)!=2 ||
+    ri_rd(ch->info,20)!=2 || !ri_apr_indices(ch))return EIO;
+ uint32_t head=ri_rd(ch->info,36),tail=ri_rd(ch->info,32);
+ unsigned available=(head-tail)&8191;
+ if(available<20)return EAGAIN;
+ __asm__ volatile("dmb sy" ::: "memory");
+ uint32_t bytes=ri_rd(ch->rx,tail),packet[128];
+ if(bytes<20 || bytes>512 || (bytes&3))return EIO;
+ if(available<20+bytes)return EAGAIN;
+ for(unsigned i=0;i<bytes;i+=4)packet[i/4]=ri_rd(ch->rx,(tail+20+i)&8191);
+ ri_pcm.rx_header=packet[0];ri_pcm.rx_source=packet[1];ri_pcm.rx_destination=packet[2];
+ ri_pcm.rx_token=packet[3];ri_pcm.rx_opcode=packet[4];
+ struct ri_pipeline_slot *slot=NULL;
+ for(unsigned i=0;i<4;i++)if(slots[i].owned && slots[i].request.token==packet[3])slot=&slots[i];
+ struct ri_apr_reply reply={0};
+ /* Validate framing even for unrelated tokens. */
+ struct ri_apr_request unmatched={0};
+ int decoded=ri_pcm_decode(packet,bytes,slot?&slot->request:&unmatched,&reply);
+ if(decoded==RI_APR_BAD)return EIO;
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(ch->info,32,(tail+20+bytes)&8191);ri_apr_write8(ch->info+9,1);
+ ri_apr_ack_flags(ch);ri_apr_notify(ch);
+ if(!slot || decoded==RI_APR_STALE || decoded==RI_APR_ACK_ONLY) {
+  ri_pcm.notifications++;return EINPROGRESS;
+ }
+ /* Even a basic NACK cannot return WRITE buffer ownership: retain mapping. */
+ if(decoded!=RI_APR_STATE || reply.words!=4 ||
+    reply.data[0]!=(uint32_t)slot->address || reply.data[1]!=(uint32_t)(slot->address>>32) ||
+    reply.data[2]!=handle)return EIO;
+ slot->owned=false;(*completed)++;
+ return reply.data[3]?EREMOTE:0;
+}
+static int (*ri_pipeline_health)(void);
+static int
+ri_stream_pipeline(struct ri_stream_state *state,uint32_t stream)
+{
+ struct ri_apr_channel ch;vm_offset_t smem=river_smd_smem;
+ if(!smem || !ri_apr_resolve(smem,&ch) ||
+    (uint32_t)(ch.info-smem)!=ri_apr.info_offset ||
+    (uint32_t)(ch.tx-smem)!=ri_apr.fifo_offset)return EBUSY;
+ vm_offset_t ipc=ml_io_map_unmappable(0x0b010000,0x4000,VM_WIMG_IO);
+ if(!ipc)return ENOMEM;
+ ch.ipc=ipc+0x1008;struct ri_pipeline_slot slots[4]={0};
+ unsigned submitted=0,completed=0,unrelated=0,max_owned=0,checks=0;bool stopping=false;
+ int error=0;bool drain=false;uint64_t health_at=0;
+ while(completed<12) {
+  for(unsigned i=0;i<4 && submitted<12 && !stopping;i++)if(!slots[i].owned) {
+   int16_t *p=(int16_t *)(state->page+i*4096);
+   int result=ri_audio_queue_pop(p,submitted);
+   if(result==0) {stopping=true;break;}
+   if(result<0) {error=ENOBUFS;drain=true;goto done;}
+   sweet_dcache_clean((vm_offset_t)p,4096);__asm__ volatile("dmb sy" ::: "memory");
+   error=ri_pipeline_publish(&ch,&slots[i],stream,state->physical+i*4096,state->handle,submitted);
+   if(error)goto done;
+   submitted++;state->submitted++;state->in_flight=true;
+   if(submitted-completed>max_owned)max_owned=submitted-completed;
+  }
+  if(stopping && completed==submitted)break;
+  uint64_t now=ri_pipeline_now();
+  if(now>=health_at) {
+   if(!ri_pipeline_health) {error=EIO;drain=true;goto done;}
+   checks++;if((error=ri_pipeline_health())) {drain=true;goto done;}
+   health_at=ri_pipeline_now()+10000000ULL;
+  }
+  unsigned before=completed;
+  error=ri_pipeline_receive(&ch,slots,state->handle,&completed);
+  if(completed!=before) {state->completed++;state->bytes_completed+=4096;unrelated=0;}
+  if(error==EINPROGRESS) {if(++unrelated>32) {error=EOVERFLOW;goto done;}error=0;}
+  else if(error==EAGAIN) {error=0;ri_wait(1);}
+  else if(error)goto done;
+  now=ri_pipeline_now();
+  for(unsigned i=0;i<4;i++)if(slots[i].owned && now-slots[i].submitted_ns>250000000ULL) {
+   error=ETIMEDOUT;goto done;
+  }
+ }
+ done:
+ /* A local underrun/health failure stops output immediately, then returns
+  * already-published buffers through exact completions while muted. A bad
+  * packet/reset/ownership mismatch never permits speculative recycling. */
+ if(error && drain) {
+  if(ri_stream_output_stop)ri_stream_output_stop();
+  uint64_t deadline=ri_pipeline_now()+250000000ULL;unsigned stale=0;
+  while(completed<submitted && ri_pipeline_now()<deadline) {
+   unsigned before=completed;
+   int result=ri_pipeline_receive(&ch,slots,state->handle,&completed);
+   if(completed!=before) {state->completed++;state->bytes_completed+=4096;}
+   if(result==EAGAIN)ri_wait(1);
+   else if(result==EINPROGRESS) {if(++stale>32)break;}
+   else if(result)break;
+  }
+ }
+ state->in_flight=false;
+ for(unsigned i=0;i<4;i++)if(slots[i].owned)state->in_flight=true;
+ if(error && state->in_flight)ri_pcm.poisoned=true;
+ ml_io_unmap(ipc,0x4000);
+ lck_mtx_lock(&ri_audio_queue_lock);
+ ri_audio_queue.dsp_submitted=submitted;ri_audio_queue.dsp_completed=completed;
+ ri_audio_queue.max_owned=max_owned;ri_audio_queue.health_checks=checks;
+ lck_mtx_unlock(&ri_audio_queue_lock);return error;
+}
