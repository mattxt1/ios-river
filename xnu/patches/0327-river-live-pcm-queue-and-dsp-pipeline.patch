+}
diff --git a/bsd/dev/river_audio_queue.h b/bsd/dev/river_audio_queue.h
--- /dev/null
+++ b/bsd/dev/river_audio_queue.h
@@ -0,0 +1,92 @@
+/* Opt-in live device-write queue. Queue lock never nests hardware/ADSP locks
+ * and no DSP waits run on a HAL writer. Whole incoming chunks are dropped
+ * on overflow (drop-newest); counters expose this bounded, nonblocking policy.
+ * First hardware trial retains the750ms independent mute deadline. */
+static LCK_GRP_DECLARE(ri_audio_queue_group,"river-audio-queue");
+static LCK_MTX_DECLARE(ri_audio_queue_lock,&ri_audio_queue_group);
+static struct {
+ bool armed,launched,stop,done;
+ unsigned head,used,high_water,underruns,overflows,rejected,peak;
+ uint64_t accepted,dropped,consumed;
+ unsigned dsp_submitted,dsp_completed,max_owned,health_checks;
+ int error;
+ int16_t samples[8192*2];
+} ri_audio_queue;
+static int ri_audio_queue_launch(void);
+static int
+ri_audio_queue_arm(void)
+{
+ int error=0;lck_mtx_lock(&ri_audio_queue_lock);
+ if(ri_audio_queue.armed || ri_audio_queue.launched || ri_audio_queue.done)error=EALREADY;
+ else {memset(&ri_audio_queue,0,sizeof(ri_audio_queue));ri_audio_queue.armed=true;}
+ lck_mtx_unlock(&ri_audio_queue_lock);return error;
+}
+static void
+ri_audio_queue_push(const int16_t *pcm,size_t frames)
+{
+ lck_mtx_lock(&ri_audio_queue_lock);
+ if(!ri_audio_queue.armed || ri_audio_queue.stop)goto out;
+ if(!pcm || frames>1024) {ri_audio_queue.rejected++;goto out;}
+ if(frames>8192-ri_audio_queue.used) {
+  ri_audio_queue.overflows++;ri_audio_queue.dropped+=frames;goto out;
+ }
+ for(unsigned i=0;i<frames;i++) {
+  unsigned n=(ri_audio_queue.head+ri_audio_queue.used+i)&8191;
+  for(unsigned c=0;c<2;c++) {
+   int value=pcm[i*2+c];unsigned magnitude=value<0?(unsigned)-value:(unsigned)value;
+   if(magnitude>ri_audio_queue.peak)ri_audio_queue.peak=magnitude;
+  }
+  ri_audio_queue.samples[n*2]=pcm[i*2];ri_audio_queue.samples[n*2+1]=pcm[i*2+1];
+ }
+ ri_audio_queue.used+=(unsigned)frames;ri_audio_queue.accepted+=frames;
+ if(ri_audio_queue.used>ri_audio_queue.high_water)ri_audio_queue.high_water=ri_audio_queue.used;
+ out:lck_mtx_unlock(&ri_audio_queue_lock);
+}
+/* 1=data,0=explicit stop,-1=underrun. No invented samples on underrun. */
+static int
+ri_audio_queue_pop(int16_t *pcm,unsigned block)
+{
+ if(!pcm || block>=12)return -1;
+ int result=1;lck_mtx_lock(&ri_audio_queue_lock);
+ if(ri_audio_queue.stop) {result=0;goto out;}
+ if(ri_audio_queue.used<1024) {ri_audio_queue.underruns++;result=-1;goto out;}
+ for(unsigned i=0;i<1024;i++) {
+  unsigned n=(ri_audio_queue.head+i)&8191,frame=block*1024+i;
+  unsigned remaining=12*1024-1-frame;
+  unsigned ramp=frame<240?frame:remaining<240?remaining:240;
+  for(unsigned c=0;c<2;c++) {
+   int value=ri_audio_queue.samples[n*2+c];
+   if(value>2048)value=2048;if(value<-2048)value=-2048;
+   pcm[i*2+c]=(int16_t)(value*(int)ramp/240);
+  }
+ }
+ ri_audio_queue.head=(ri_audio_queue.head+1024)&8191;
+ ri_audio_queue.used-=1024;ri_audio_queue.consumed+=1024;
+ out:lck_mtx_unlock(&ri_audio_queue_lock);return result;
+}
+static int
+river_audio_queue_sysctl SYSCTL_HANDLER_ARGS
+{
+ int value=0,error=sysctl_handle_int(oidp,&value,0,req);
+ if(error || !req->newptr)return error;
+ if(value==1)return ri_audio_queue_arm();
+ if(value==2)return ri_audio_queue_launch();
+ if(value!=3)return EINVAL;
+ lck_mtx_lock(&ri_audio_queue_lock);ri_audio_queue.stop=true;
+ lck_mtx_unlock(&ri_audio_queue_lock);return 0;
+}
