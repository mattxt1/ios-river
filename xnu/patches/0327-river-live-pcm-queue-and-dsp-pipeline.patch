 }
+
+static unsigned ri_live_health_index,ri_live_health_checks;
+static int
+ri_live_health(void)
+{
+ uint64_t begin=ri_tone_now_ns();int error=0;uint32_t value=0;
+ lck_mtx_lock(&ri_speaker_lock);
+ if(!ri_tone.active || ri_tone.cutoff)error=ETIMEDOUT;
+ else switch(ri_live_health_index++%3) {
+ case 0:
+  if(!ri_cs35l41_rd(0x10090,&value) || (value&0x800281c0u))error=EIO;
+  break;
+ case 1:
+  if(!ri_cs35l41_rd(0x10098,&value) || value==0xffffffff || (value&0x10))error=EIO;
+  break;
