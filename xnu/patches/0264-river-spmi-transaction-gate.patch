+/* One River AP execution-environment controller gate. A bounded non-sleeping
+ * acquisition can be called from early boot or interrupt-sensitive contexts.
+ * It does not exclude firmware or another execution environment. A command
+ * timeout poisons the controller until reboot: a late completion is unsafe to
+ * associate with a subsequent command. Never print or sleep while held. */
+static int ri_spmi_gate, ri_spmi_poisoned;
+static uint32_t ri_spmi_acquired, ri_spmi_busy;
+static bool
+ri_spmi_acquire(void)
+{
+ for (unsigned i=0;i<64;i++) {
+  if (__atomic_load_n(&ri_spmi_poisoned,__ATOMIC_ACQUIRE)) return false;
+  int expected=0;
+  if (__atomic_compare_exchange_n(&ri_spmi_gate,&expected,1,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED)) {
+   if (!__atomic_load_n(&ri_spmi_poisoned,__ATOMIC_ACQUIRE)) { __atomic_add_fetch(&ri_spmi_acquired,1,__ATOMIC_RELAXED); return true; }
+   __atomic_store_n(&ri_spmi_gate,0,__ATOMIC_RELEASE); return false;
+  }
+  delay(1);
+ }
+ __atomic_add_fetch(&ri_spmi_busy,1,__ATOMIC_RELAXED); return false;
+}
+static void
+ri_spmi_release(bool timeout)
+{
+ if (timeout) __atomic_store_n(&ri_spmi_poisoned,1,__ATOMIC_RELEASE);
+ __atomic_store_n(&ri_spmi_gate,0,__ATOMIC_RELEASE);
+}
