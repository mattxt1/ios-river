+void
+river_speaker_init(void)
+{
+	/* 1. Release CS47L35 hardware reset via TLMM GPIO 68 (0x01044000) */
+	vm_offset_t gpio68 = ri_map(0x01044000);
+	if (gpio68) {
+		ri_wr(gpio68, 4, 2); /* OUT = 1 (drive high) */
+		ri_wr(gpio68, 0, 0x203); /* OE=1, PULL_UP=3, DRV=2mA, FUNC=0 */
+		delay(2000); /* 2 ms settle time */
+		ri_cs35l41_gpio68_val = ri_rd(gpio68, 4);
+		printf("RIVER AUDIO: CS47L35 reset released (GPIO68 cfg=%#x inout=%#x)\n",
+		       ri_rd(gpio68, 0), ri_cs35l41_gpio68_val);
+	}
+
+	/* 2. Configure TLMM GPIO 46 (CS47L35 IRQ) with pull-up */
+	vm_offset_t gpio46 = ri_map(0x0102e000);
+	if (gpio46) ri_wr(gpio46, 0, 0x203);
+
+	/* 3. Release CS35L41 hardware reset via TLMM GPIO 94 (0x0105e000) */
+	vm_offset_t gpio94 = ri_map(0x0105e000);
+	if (gpio94) {
+		ri_wr(gpio94, 4, 2); /* OUT = 1 (drive high) */
+		ri_wr(gpio94, 0, 0x203); /* OE=1, PULL_UP=3, DRV=2mA, FUNC=0 */
+		delay(1000); /* 1 ms delay for power-on reset */
+		ri_cs35l41_gpio94_val = ri_rd(gpio94, 4);
+		printf("RIVER AUDIO: CS35L41 reset released (GPIO94 cfg=%#x inout=%#x)\n",
+		       ri_rd(gpio94, 0), ri_cs35l41_gpio94_val);
+	}
+
+	/* 4. Configure TLMM GPIO 63 (CS35L41 IRQ) with pull-up */
+	vm_offset_t gpio63 = ri_map(0x0103f000);
+	if (gpio63) ri_wr(gpio63, 0, 0x203);
+
+	if (!ri_qup2) {
+		printf("RIVER AUDIO: QUP2 not mapped\n");
+		return;
+	}
+
+	/* 5. Configure TLMM MI2S pins: GPIO 91 (0x0105b000), GPIO 92 (0x0105c000), GPIO 93 (0x0105d000) */
+	vm_offset_t g91 = ri_map(0x0105b000);
+	if (g91) ri_wr(g91, 0, 0x0c4); /* GPIO 91: pri_mi2s, 8mA */
+	vm_offset_t g92 = ri_map(0x0105c000);
+	if (g92) ri_wr(g92, 0, 0x0c4); /* GPIO 92: pri_mi2s_ws, 8mA */
+	vm_offset_t g93 = ri_map(0x0105d000);
+	if (g93) ri_wr(g93, 0, 0x0c4); /* GPIO 93: pri_mi2s, 8mA */
+
+	/* 6. Configure TLMM GPIO 66 (MCLK2): 0x01042000 */
+	vm_offset_t gpio66 = ri_map(0x01042000);
+	if (gpio66) ri_wr(gpio66, 0, 0x0c4);
+
+	/* 7. Probe CS35L41 at I2C address 0x40 on QUP2 */
+	bool ok = false;
+	for (int t = 0; t < 5; t++) {
+		if (ri_cs35l41_rd(0x00000000, &ri_cs35l41_devid)) {
+			if (ri_cs35l41_devid != 0 && ri_cs35l41_devid != 0xffffffff) {
+				ok = true;
+				break;
+			}
+		}
+		ri_wait(20);
+	}
+
+	if (!ok) {
+		printf("RIVER AUDIO: CS35L41 probe failed at 0x40 (devid=%#010x)\n", ri_cs35l41_devid);
+		return;
+	}
+
+	(void)ri_cs35l41_rd(0x00000004, &ri_cs35l41_revid);
+	printf("RIVER AUDIO: CS35L41 detected at I2C 0x40 (devid=%#010x rev=%#010x)\n",
+	       ri_cs35l41_devid, ri_cs35l41_revid);
+
+	/* 8. Initialize amplifier registers (Cirrus ALSA gold-standard sequence) */
+	/* Power control 1: GLOBAL_EN = 0 (disable during configuration) */
+	ri_cs35l41_wr(0x00002014, 0x00000000);
+	/* Power control 3: 0x01000010 */
+	ri_cs35l41_wr(0x0000201c, 0x01000010);
+	/* Boost peak inductor current: 4500 mA (0x4a) */
+	ri_cs35l41_wr(0x00003808, 0x0000004a);
+	/* Boost inductor slope: 1000 nH (0x00) */
+	ri_cs35l41_wr(0x00003814, 0x00000000);
+	/* Audio Serial Port (ASP) RX1/TX1 enable: ASPRX1_EN = 1, ASPTX1_EN = 1 */
+	ri_cs35l41_wr(0x00004800, 0x00010001);
+	/* ASP Format: 32 bits RX/TX slots, I2S mode, SCLK/LRCLK Master (0x20200233) */
+	ri_cs35l41_wr(0x00004808, 0x20200233);
+	/* Hi-Z unused/disabled: 0x03 */
+	ri_cs35l41_wr(0x0000480c, 0x00000003);
+	/* ASP RX frame slot: slots 0 and 1 (0x03) */
+	ri_cs35l41_wr(0x00004820, 0x00000003);
+	/* ASP TX word length: 24 cycles/slot (0x18) */
+	ri_cs35l41_wr(0x00004838, 0x00000018);
+	/* ASP RX word length: 24 cycles/slot (0x18) */
+	ri_cs35l41_wr(0x00004840, 0x00000018);
+	/* PLL Clock Control: Open-loop self-oscillator enabled (0x00000833) */
+	ri_cs35l41_wr(0x00002c04, 0x00000833);
+	/* DSP Clock Control: DSP CLK EN (0x00000003) */
+	ri_cs35l41_wr(0x00002c08, 0x00000003);
+	/* Global clock control: 48 kHz (0x00000003) */
+	ri_cs35l41_wr(0x00002c0c, 0x00000003);
+	/* DAC PCM1 Source: route ASPRX1 directly to DAC (0x08) */
+	ri_cs35l41_wr(0x00004c00, 0x00000008);
+	/* ASP TX1 Source: VMON (0x18) */
+	ri_cs35l41_wr(0x00004c20, 0x00000018);
+	/* ASP TX2 Source: IMON (0x19) */
+	ri_cs35l41_wr(0x00004c24, 0x00000019);
+	/* Amplifier Gain: set gain to +17 dB (0x00000220) */
+	ri_cs35l41_wr(0x00006c04, 0x00000220);
+	/* UNMUTE: Digital volume control (0.0 dB unmuted) */
+	ri_cs35l41_wr(0x00006000, 0x00000000);
+	/* UNMUTE: Output stage analog mute cleared (0x00 unmuted) */
+	ri_cs35l41_wr(0x00002024, 0x00000000);
+	/* Power control 2: AMP_EN = 1, BST_EN = 2 (internal boost) */
+	ri_cs35l41_wr(0x00002018, 0x00000021);
+	delay(5000); /* 5 ms settle time for boost converter */
+	/* Power control 1: GLOBAL_EN = 1 */
+	ri_cs35l41_wr(0x00002014, 0x00000001);
+
+	/* Read back status and configuration */
+	(void)ri_cs35l41_rd(0x00002018, &ri_cs35l41_status);
+	(void)ri_cs35l41_rd(0x00006000, &ri_cs35l41_dig_vol);
+	(void)ri_cs35l41_rd(0x00002024, &ri_cs35l41_out_mute);
+	(void)ri_cs35l41_rd(0x00004808, &ri_cs35l41_sp_fmt);
+	(void)ri_cs35l41_rd(0x00002c04, &ri_cs35l41_pll_clk);
+	(void)ri_cs35l41_rd(0x00006c04, &ri_cs35l41_gain);
+	(void)ri_cs35l41_rd(0x00010090, &ri_cs35l41_irq1);
+	(void)ri_cs35l41_rd(0x00010094, &ri_cs35l41_irq2);
+	(void)ri_cs35l41_rd(0x00010098, &ri_cs35l41_irq3);
+	(void)ri_cs35l41_rd(0x0001009c, &ri_cs35l41_irq4);
+	ri_speaker_ok = true;
+	printf("RIVER AUDIO: CS35L41 unmuted (pwr=%#x vol=%#x mute=%#x fmt=%#x pll=%#x gain=%#x raw_irq=%#x,%#x,%#x,%#x)\n",
+	       ri_cs35l41_status, ri_cs35l41_dig_vol, ri_cs35l41_out_mute, ri_cs35l41_sp_fmt,
+	       ri_cs35l41_pll_clk, ri_cs35l41_gain, ri_cs35l41_irq1, ri_cs35l41_irq2,
+	       ri_cs35l41_irq3, ri_cs35l41_irq4);
+}
+
+void
+river_audio_hw_write(const int16_t *pcm, size_t frames)
+{
+	if (!ri_speaker_ok || !pcm || frames == 0) return;
+	ri_audio_hw_frames += frames;
+
+	int16_t max_sample = 0;
+	size_t count = frames * 2;
+	for (size_t i = 0; i < count; i++) {
+		int16_t val = pcm[i] < 0 ? -pcm[i] : pcm[i];
+		if (val > max_sample) max_sample = val;
+	}
+
+	if (max_sample > 100) {
+		ri_cs35l41_wr(0x00002024, 0x00000000);
+	}
+}
+
+static void
+river_speaker_thread(void *arg, wait_result_t result)
+{
+	(void)arg; (void)result;
+	ri_wait(1000);
+	river_speaker_init();
+}
+
+static int
+river_audio_hw_sysctl SYSCTL_HANDLER_ARGS
+{
+	if (ri_speaker_ok) {
+		(void)ri_cs35l41_rd(0x00002018, &ri_cs35l41_status);
+		(void)ri_cs35l41_rd(0x00006000, &ri_cs35l41_dig_vol);
+		(void)ri_cs35l41_rd(0x00002024, &ri_cs35l41_out_mute);
+		(void)ri_cs35l41_rd(0x00004808, &ri_cs35l41_sp_fmt);
+		(void)ri_cs35l41_rd(0x00002c04, &ri_cs35l41_pll_clk);
+		(void)ri_cs35l41_rd(0x00006c04, &ri_cs35l41_gain);
+		(void)ri_cs35l41_rd(0x00010090, &ri_cs35l41_irq1);
+		(void)ri_cs35l41_rd(0x00010094, &ri_cs35l41_irq2);
+		(void)ri_cs35l41_rd(0x00010098, &ri_cs35l41_irq3);
+		(void)ri_cs35l41_rd(0x0001009c, &ri_cs35l41_irq4);
+	}
+	char buf[320];
+	snprintf(buf, sizeof(buf),
+	         "ok=%d devid=%#010x rev=%#010x pwr=%#010x vol=%#010x mute=%#010x fmt=%#010x pll=%#010x gain=%#010x irq=%#x,%#x,%#x,%#x g68=%#x g94=%#x frames=%llu",
+	         ri_speaker_ok ? 1 : 0, ri_cs35l41_devid, ri_cs35l41_revid, ri_cs35l41_status,
+	         ri_cs35l41_dig_vol, ri_cs35l41_out_mute, ri_cs35l41_sp_fmt, ri_cs35l41_pll_clk,
+	         ri_cs35l41_gain, ri_cs35l41_irq1, ri_cs35l41_irq2, ri_cs35l41_irq3, ri_cs35l41_irq4,
+	         ri_cs35l41_gpio68_val, ri_cs35l41_gpio94_val,
+	         (unsigned long long)ri_audio_hw_frames);
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_audio_hw, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_audio_hw_sysctl, "A", "River audio hardware status");
 static uint64_t
 ri_ns_since(uint64_t t0)
 {
