+static bool
+ri_cs35l41_rd(uint32_t reg, uint32_t *val)
+{
+	uint8_t tx[4] = {
+		(uint8_t)(reg >> 24),
+		(uint8_t)(reg >> 16),
+		(uint8_t)(reg >> 8),
+		(uint8_t)(reg)
+	};
+	uint8_t rx[4] = { 0 };
+	if (!ri_qup2 || !ri_qup_xfer(ri_qup2, 0x40, tx, 4, rx, 4))
+		return false;
+	if (val) {
+		*val = ((uint32_t)rx[0] << 24) |
+		       ((uint32_t)rx[1] << 16) |
+		       ((uint32_t)rx[2] << 8)  |
+		       ((uint32_t)rx[3]);
+	}
+	return true;
+}
+
+static bool
+ri_cs35l41_wr(uint32_t reg, uint32_t val)
+{
+	uint8_t tx[8] = {
+		(uint8_t)(reg >> 24),
+		(uint8_t)(reg >> 16),
+		(uint8_t)(reg >> 8),
+		(uint8_t)(reg),
+		(uint8_t)(val >> 24),
+		(uint8_t)(val >> 16),
+		(uint8_t)(val >> 8),
+		(uint8_t)(val)
+	};
+	if (!ri_qup2) return false;
+	return ri_qup_xfer(ri_qup2, 0x40, tx, 8, NULL, 0);
+}
+
+void
+river_speaker_init(void)
+{
+	/* 1. Release hardware reset via TLMM GPIO 94 (0x0105e000) */
+	vm_offset_t gpio94 = ri_map(0x0105e000);
+	if (gpio94) {
+		ri_wr(gpio94, 4, 2); /* OUT = 1 (drive high) */
+		ri_wr(gpio94, 0, 0x203); /* OE=1, PULL_UP=3, DRV=2mA, FUNC=0 */
+		delay(1000); /* 1 ms delay for power-on reset */
+		printf("RIVER AUDIO: CS35L41 reset released (GPIO94 cfg=%#x inout=%#x)\n",
+		       ri_rd(gpio94, 0), ri_rd(gpio94, 4));
+	}
+
+	if (!ri_qup2) {
+		printf("RIVER AUDIO: QUP2 not mapped\n");
+		return;
+	}
+
+	/* 2. Configure TLMM MI2S pins: GPIO 91 (0x0105b000), GPIO 92 (0x0105c000), GPIO 93 (0x0105d000) */
+	vm_offset_t g91 = ri_map(0x0105b000);
+	if (g91) ri_wr(g91, 0, 0x0c4); /* GPIO 91: pri_mi2s, 8mA */
+	vm_offset_t g92 = ri_map(0x0105c000);
+	if (g92) ri_wr(g92, 0, 0x0c4); /* GPIO 92: pri_mi2s_ws, 8mA */
+	vm_offset_t g93 = ri_map(0x0105d000);
+	if (g93) ri_wr(g93, 0, 0x0c4); /* GPIO 93: pri_mi2s, 8mA */
+	printf("RIVER AUDIO: TLMM MI2S pins configured (91, 92, 93)\n");
+
+	/* 3. Configure TLMM GPIO 66 (MCLK2): 0x01042000 */
+	vm_offset_t gpio66 = ri_map(0x01042000);
+	if (gpio66) {
+		ri_wr(gpio66, 0, 0x0c4);
+		printf("RIVER AUDIO: TLMM MCLK2 pin configured (GPIO 66)\n");
+	}
+
+	/* 4. Configure LPASS CSR Speaker & Mode MUX registers */
+	vm_offset_t csr_spkr = ri_map(0x0c051000);
+	if (csr_spkr) {
+		uint32_t spkr_val = ri_rd(csr_spkr, 4);
+		spkr_val |= 0x00010000; /* LPASS_CSR_GP_IO_MUX_SPKR_CTL: select primary TLMM */
+		ri_wr(csr_spkr, 4, spkr_val);
+		ri_csr_spkr_mux = ri_rd(csr_spkr, 4);
+		printf("RIVER AUDIO: LPASS CSR speaker mux configured: %#010x\n", ri_csr_spkr_mux);
+	}
+	vm_offset_t csr_pri_mode = ri_map(0x0c055000);
+	if (csr_pri_mode) {
+		ri_wr(csr_pri_mode, 0, 0x00000001); /* select Primary MI2S/PCM */
+		printf("RIVER AUDIO: LPASS CSR pri mode mux configured: %#010x\n", ri_rd(csr_pri_mode, 0));
+	}
+
+	/* 5. Probe CS35L41 at I2C address 0x40 on QUP2 */
+	bool ok = false;
+	for (int t = 0; t < 5; t++) {
+		if (ri_cs35l41_rd(0x00000000, &ri_cs35l41_devid)) {
+			if (ri_cs35l41_devid != 0 && ri_cs35l41_devid != 0xffffffff) {
+				ok = true;
+				break;
+			}
+		}
+		ri_wait(20);
+	}
+
+	if (!ok) {
+		printf("RIVER AUDIO: CS35L41 probe failed at 0x40 (devid=%#010x)\n", ri_cs35l41_devid);
+		return;
+	}
+
+	(void)ri_cs35l41_rd(0x00000004, &ri_cs35l41_revid);
+	printf("RIVER AUDIO: CS35L41 detected at I2C 0x40 (devid=%#010x rev=%#010x)\n",
+	       ri_cs35l41_devid, ri_cs35l41_revid);
+
+	/* 6. Initialize amplifier registers */
+	/* Power control 1: GLOBAL_EN = 1 */
+	ri_cs35l41_wr(0x00002014, 0x00000001);
+	/* Power control 2: AMP_EN = 1, BST_EN = 2 (internal boost) */
+	ri_cs35l41_wr(0x00002018, 0x00000021);
+	/* Boost peak inductor current: 4500 mA (0x4a) */
+	ri_cs35l41_wr(0x00003808, 0x0000004a);
+	/* Boost inductor slope: 1000 nH (0x00) */
+	ri_cs35l41_wr(0x00003814, 0x00000000);
+	/* Audio Serial Port (ASP) RX1 enable: ASP_RX1_EN = 1 */
+	ri_cs35l41_wr(0x00004800, 0x00010000);
+	/* ASP Format: I2S mode, 16-bit word length */
+	ri_cs35l41_wr(0x00004808, 0x00021000);
+	/* ASP RX word length: 16-bit (0x10) */
+	ri_cs35l41_wr(0x00004840, 0x00000010);
+	/* Global clock control: 48 kHz (0x03) */
+	ri_cs35l41_wr(0x00002c0c, 0x00000003);
+	/* DAC PCM1 Source: route ASPRX1 directly to DAC (bypassing DSP) */
+	ri_cs35l41_wr(0x00004c00, 0x00000008);
+	/* Amplifier Gain: set gain to 4.5 dB (0x84) */
+	ri_cs35l41_wr(0x00006c04, 0x00000084);
+	/* UNMUTE: Digital volume control (0.0 dB unmuted, default was 0x4cf mute) */
+	ri_cs35l41_wr(0x00006000, 0x00000000);
+	/* UNMUTE: Output stage analog mute cleared (0x00 unmuted) */
+	ri_cs35l41_wr(0x00002024, 0x00000000);
+
+	/* Read back status and configuration */
+	(void)ri_cs35l41_rd(0x00002018, &ri_cs35l41_status);
+	(void)ri_cs35l41_rd(0x00006000, &ri_cs35l41_dig_vol);
+	(void)ri_cs35l41_rd(0x00002024, &ri_cs35l41_out_mute);
+	(void)ri_cs35l41_rd(0x00004808, &ri_cs35l41_sp_fmt);
+	ri_speaker_ok = true;
+	printf("RIVER AUDIO: CS35L41 unmuted (pwr=%#x vol=%#x mute=%#x fmt=%#x csr=%#x)\n",
+	       ri_cs35l41_status, ri_cs35l41_dig_vol, ri_cs35l41_out_mute, ri_cs35l41_sp_fmt, ri_csr_spkr_mux);
+}
+
+void
+river_audio_hw_write(const int16_t *pcm, size_t frames)
+{
+	if (!ri_speaker_ok || !pcm || frames == 0) return;
+	ri_audio_hw_frames += frames;
+}
+
+static void
+river_speaker_thread(void *arg, wait_result_t result)
+{
+	(void)arg; (void)result;
+	ri_wait(1000);
+	river_speaker_init();
+}
+
+static int
+river_audio_hw_sysctl SYSCTL_HANDLER_ARGS
+{
+	char buf[256];
+	snprintf(buf, sizeof(buf),
+	         "ok=%d devid=%#010x rev=%#010x pwr=%#010x vol=%#010x mute=%#010x fmt=%#010x csr=%#010x frames=%llu",
+	         ri_speaker_ok ? 1 : 0, ri_cs35l41_devid, ri_cs35l41_revid, ri_cs35l41_status,
+	         ri_cs35l41_dig_vol, ri_cs35l41_out_mute, ri_cs35l41_sp_fmt, ri_csr_spkr_mux,
+	         (unsigned long long)ri_audio_hw_frames);
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_debug, OID_AUTO, river_audio_hw, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+            NULL, 0, river_audio_hw_sysctl, "A", "River audio hardware status");
