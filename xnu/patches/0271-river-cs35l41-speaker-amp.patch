+static bool
+ri_cs35l41_rd(uint32_t reg, uint32_t *val)
+{
+	uint8_t tx[4] = {
+		(uint8_t)(reg >> 24),
+		(uint8_t)(reg >> 16),
+		(uint8_t)(reg >> 8),
+		(uint8_t)(reg)
+	};
+	uint8_t rx[4] = { 0 };
+	if (!ri_qup2 || !ri_qup_xfer(ri_qup2, 0x40, tx, 4, rx, 4))
+		return false;
+	if (val) {
+		*val = ((uint32_t)rx[0] << 24) |
+		       ((uint32_t)rx[1] << 16) |
+		       ((uint32_t)rx[2] << 8)  |
+		       ((uint32_t)rx[3]);
+	}
+	return true;
+}
+
+static bool
+ri_cs35l41_wr(uint32_t reg, uint32_t val)
+{
+	uint8_t tx[8] = {
+		(uint8_t)(reg >> 24),
+		(uint8_t)(reg >> 16),
+		(uint8_t)(reg >> 8),
+		(uint8_t)(reg),
+		(uint8_t)(val >> 24),
+		(uint8_t)(val >> 16),
+		(uint8_t)(val >> 8),
+		(uint8_t)(val)
+	};
+	if (!ri_qup2) return false;
+	return ri_qup_xfer(ri_qup2, 0x40, tx, 8, NULL, 0);
+}
+
+void
+river_speaker_set_volume(uint32_t below_eighths, bool muted)
+{
+	if (!ri_speaker_ok) return;
+	if (muted) {
+		ri_cs35l41_wr(0x00002024, 0x00000001);
+		ri_cs35l41_wr(0x00006000, 0x000004cf);
+	} else {
+		ri_cs35l41_wr(0x00002024, 0x00000000);
+		uint32_t v = below_eighths > 0x400 ? 0x400 : below_eighths;
+		ri_cs35l41_wr(0x00006000, v);
+	}
+	(void)ri_cs35l41_rd(0x00006000, &ri_cs35l41_dig_vol);
+	(void)ri_cs35l41_rd(0x00002024, &ri_cs35l41_out_mute);
+}
+
+int
+river_speaker_tone(unsigned ms, unsigned freq_hz)
+{
+	if (!ri_speaker_ok) return -1;
+	if (ms == 0) return 0;
+	if (ms > 5000) ms = 5000;
+	if (freq_hz < 100) freq_hz = 100;
+	if (freq_hz > 4000) freq_hz = 4000;
+
+	unsigned half_us = 1000000 / (freq_hz * 2);
+	if (half_us < 100) half_us = 100;
+
+	ri_cs35l41_wr(0x00006c04, 0x00000220);
+	ri_cs35l41_wr(0x00006000, 0x00000000);
+	ri_cs35l41_wr(0x00002018, 0x00000021);
+	ri_cs35l41_wr(0x00002014, 0x00000001);
+
+	unsigned total_us = ms * 1000;
+	unsigned elapsed = 0;
+	while (elapsed < total_us) {
+		ri_cs35l41_wr(0x00002024, 0x00000000);
+		delay(half_us);
+		ri_cs35l41_wr(0x00002024, 0x00000001);
+		delay(half_us);
+		elapsed += (half_us * 2);
+	}
+
+	ri_cs35l41_wr(0x00002024, 0x00000000);
+	return 0;
+}
