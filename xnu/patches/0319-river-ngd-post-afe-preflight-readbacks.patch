 }
 static int
@@ -78,8 +83,26 @@
  vm_offset_t mmio=ml_io_map_unmappable(0x0c140000,0x4000,VM_WIMG_IO);
  if(!mmio)return ri_channel_result("map",ENOMEM);
  vm_offset_t base=mmio+0x1000;
- if(!ri_ngd_live() || ri_rd(mmio,0)!=0x01050000 || ri_rd(base,0)!=1 ||
-    ri_rd(base,0x10) || ri_rd(base,0x14) || !(ri_rd(base,4)&2) || (ri_rd(base,4)&1)) {
+ ri_channel.hw_version=ri_rd(mmio,0);
+ ri_channel.initial_cfg=ri_rd(base,0);ri_channel.initial_status=ri_rd(base,4);
+ ri_channel.initial_int_en=ri_rd(base,0x10);ri_channel.initial_interrupts=ri_rd(base,0x14);
+ ri_channel.initial_ie=ri_rd(base,0xf0);ri_channel.initial_ve=ri_rd(base,0x100);
+ /* AFE start may leave a documented IE/VE/reconfiguration notification.
+  * Never change CFG/IRQ_EN, consume an unsolicited RX frame, or clear an
+  * error to pass ownership. Only settle busy status and known W1C notices. */
+ bool ready=false;
+ for(unsigned i=0;i<8;i++) {
+  ri_channel.preflight_polls++;
+  ri_channel.cfg=ri_rd(base,0);ri_channel.status=ri_rd(base,4);ri_channel.interrupts=ri_rd(base,0x14);
+  if(!ri_ngd_live() || ri_channel.hw_version!=0x01050000 || ri_rd(mmio,0)!=ri_channel.hw_version ||
+     ri_channel.cfg!=1 || ri_rd(base,0x10) || !(ri_channel.status&2) ||
+     (ri_channel.interrupts&~0x11000000u))break;
+  if(ri_channel.interrupts) {
+   ri_wr(base,0x18,ri_channel.interrupts);ri_ngd_barrier();
+  } else if(!(ri_channel.status&1)) {ready=true;break;}
+  ri_wait(5);
+ }
+ if(!ready) {
   ml_io_unmap(mmio,0x4000);return ri_channel_result("ownership",EBUSY);
  }
  ri_channel.attempted=true;ri_channel.tid=0x71;
