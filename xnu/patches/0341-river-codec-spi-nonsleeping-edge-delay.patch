diff --git a/bsd/dev/river_codec_probe.h b/bsd/dev/river_codec_probe.h
--- a/bsd/dev/river_codec_probe.h
+++ b/bsd/dev/river_codec_probe.h
@@ -11,15 +11,30 @@
 static int ri_codec_attempted;
 static char ri_codec_note[256] = "not requested";
 
+/* SPI edges need a minimum dwell, not a scheduler sleep. On this port
+ * delay(5) may assert_wait/thread_block when cpu_idle_latency is unknown.
+ * Keep the proven five microsecond wire timing; do not change global delay,
+ * PLL settling, power sequencing, interrupt masks or amplifier health leases. */
+static void
+ri_codec_spi_delay(void)
+{
+ uint64_t interval;
+ clock_interval_to_absolutetime_interval(5,NSEC_PER_USEC,&interval);
+ uint64_t deadline=mach_absolute_time()+interval;
+ while(mach_absolute_time()<deadline) {
+  __asm__ volatile("" ::: "memory");
+ }
+}
+
 static uint8_t
