diff --git a/bsd/dev/river_codec_clock.h b/bsd/dev/river_codec_clock.h
--- a/bsd/dev/river_codec_clock.h
+++ b/bsd/dev/river_codec_clock.h
@@ -77,8 +77,10 @@
  ri_wr(ri_codec_pin[1], 4, 2); delay(5);
  /* CTRL_UPD is a command bit, excluded from immediate N validation.
   * The caller explicitly rearms and clears it around each update strobe. */
- /* GPn_LVL is live input status, not restorable GPIO configuration. */
- uint16_t mask = (reg == 0x172 || reg == 0x1710 || reg == 0x1714) ? 0x7fff : 0xffff;
+ /* GPn_LVL and mixer x_STSn are live status, not configuration.
+  * CS47L35 DS1085F2 Table4-7: source-register bit15 reports input enable. */
+ uint16_t mask = (reg == 0x172 || reg == 0x1710 || reg == 0x1712 || reg == 0x1714 ||
+  (reg >= 0x700 && reg <= 0x70e && !(reg & 1))) ? 0x7fff : 0xffff;
  uint16_t got = ri_clock_read(reg);
  bool ok = (got & mask) == (value & mask);
  if (!ok && !ri_clock_bad_reg) {
diff --git a/bsd/dev/river_adsp_codec_route.h b/bsd/dev/river_adsp_codec_route.h
--- a/bsd/dev/river_adsp_codec_route.h
+++ b/bsd/dev/river_adsp_codec_route.h
@@ -26,7 +26,8 @@
  uint16_t saved[22];ri_codec_path.restored=true;
  for(unsigned i=0;i<22;i++)saved[i]=ri_clock_read(ri_codec_path_regs[i]);
  for(unsigned i=0;i<22;i++) {
-  uint16_t mask=ri_codec_path_regs[i]==0x1712?0x7fff:0xffff;
+  uint16_t mask=(ri_codec_path_regs[i]==0x1712 ||
+   (ri_codec_path_regs[i]>=0x700 && ri_codec_path_regs[i]<=0x70e && !(ri_codec_path_regs[i]&1)))?0x7fff:0xffff;
   if(saved[i]==0xffff || (ri_clock_read(ri_codec_path_regs[i])&mask)!=(saved[i]&mask)) {
    ri_codec_path.bad_reg=ri_codec_path_regs[i];return EIO;
   }
@@ -69,6 +70,9 @@
    error=EIO;goto restore;
   }
   if(!(ri_codec_path.port_live&1)) {error=ENXIO;goto restore;}
+  if(i==19 && (!(ri_clock_read(0x700)&0x8000) || !(ri_clock_read(0x708)&0x8000))) {
+   error=ETIMEDOUT;goto restore;
+  }
   ri_wait(5);
  }
  ri_codec_path.seen=true;
@@ -87,7 +91,8 @@
   for(unsigned i=0;i<22;i++)if(!ri_codec_path_restore_write(ri_codec_path_regs[i],saved[i]))restored=false;
   if(!ri_codec_path_restore_write(0x501,pin_before))restored=false;
   for(unsigned i=0;i<22;i++) {
-   uint16_t mask=ri_codec_path_regs[i]==0x1712?0x7fff:0xffff;
+   uint16_t mask=(ri_codec_path_regs[i]==0x1712 ||
+   (ri_codec_path_regs[i]>=0x700 && ri_codec_path_regs[i]<=0x70e && !(ri_codec_path_regs[i]&1)))?0x7fff:0xffff;
    if((ri_clock_read(ri_codec_path_regs[i])&mask)!=(saved[i]&mask)) {
     restored=false;if(!ri_codec_path.bad_reg)ri_codec_path.bad_reg=ri_codec_path_regs[i];
    }
