+/* Stock ngd_slim_power_up reads base version then NGD status immediately
+ * after an acknowledged QMI ACTIVE response. Snapshot only; no RX consumption,
+ * interrupt clearing, reset, DMA/BAM setup, or controller configuration. */
+static int
+ri_slim_ngd_snapshot(void)
+{
+ if(ri_slim.ngd_attempted)return EALREADY;
+ if(!ri_slim.active || !ri_slim.selected || !ri_slim_live() ||
+    !ri_stream.complete || !ri_route_ready() || !ri_route.muted)
+  return ri_slim_result("ngd_prerequisite",EBUSY);
+ vm_offset_t mmio=ml_io_map_unmappable(0x0c140000,0x4000,VM_WIMG_IO);
+ if(!mmio)return ri_slim_result("ngd_map",ENOMEM);
+ if(!ri_slim_live() || !ri_slim.active || !ri_route_ready()) {
+  ml_io_unmap(mmio,0x4000);return ri_slim_result("ngd_recheck",EBUSY);
+ }
+ ri_slim.ngd_attempted=true;
+ ri_slim.hw_version=ri_rd(mmio,0);
+ __asm__ volatile("dmb sy" ::: "memory");
+ int error=0;
+ if(ri_slim.hw_version==0xffffffff || ri_rd(mmio,0)!=ri_slim.hw_version)error=EIO;
+ else {
+  /* Stock cell-index1: upper16 version zero uses V1 offset0x800,
+   * otherwise V2 offset0x1000. Both lie within the owned mapping. */
+  unsigned offset=(ri_slim.hw_version>>16)?0x1000:0x800;
+  ri_slim.ngd_offset=offset;ri_slim.ngd_cfg=ri_rd(mmio,offset);
+  ri_slim.ngd_status=ri_rd(mmio,offset+4);ri_slim.ngd_int_en=ri_rd(mmio,offset+0x10);
+  ri_slim.ngd_int_stat=ri_rd(mmio,offset+0x14);ri_slim.ngd_ie=ri_rd(mmio,offset+0xf0);
+  ri_slim.ngd_ve=ri_rd(mmio,offset+0x100);ri_slim.ngd_read=true;
+ }
+ ml_io_unmap(mmio,0x4000);
+ return ri_slim_result(error?"ngd_version_invalid":"ngd_readonly_complete",error);
+}
