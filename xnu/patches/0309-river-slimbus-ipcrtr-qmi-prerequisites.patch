+++ b/bsd/dev/river_adsp_probe.h
@@ -108,6 +108,7 @@
 #include "river_adsp_pcm.h"
 #include "river_adsp_route.h"
 #include "river_adsp_stream.h"
+#include "river_adsp_slim.h"
 
 static int
 river_adsp_probe_sysctl SYSCTL_HANDLER_ARGS
