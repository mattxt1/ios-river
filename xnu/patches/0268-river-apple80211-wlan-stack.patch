+/*
+ * river_apple80211.c: Apple80211 ioctl and event engine for Moto G7 river.
+ */
+
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <libkern/crypto/sha1.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/river_apple80211.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+static LCK_GRP_DECLARE(river_apple80211_lck_grp, "river-apple80211");
+static LCK_MTX_DECLARE(river_apple80211_mtx, &river_apple80211_lck_grp);
+
+static const char interface_name[16] = "en0";
+static const uint8_t river_test_mac[6] = {0x02, 0, 0, 0x36, 0x60, 1};
+
+#define RIVER_MAX_BSS 32
+struct river_apple80211_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32];
+	uint8_t ssid_len;
+	uint8_t channel;
+	uint16_t freq;
+	int16_t rssi;
+	uint16_t beacon_int;
+	uint16_t caps;
+	uint32_t age_ms;
+	uint16_t ies_len;
+	uint8_t ies[768];
+};
+
+static struct river_apple80211_bss river_bss_table[RIVER_MAX_BSS];
+static unsigned river_bss_count = 0;
+static unsigned scan_result_idx = 0;
+static bool scan_pending_flag = false;
+
+static struct river_apple80211_join_req pending_join;
+static bool join_pending_flag = false;
+static uint32_t join_result = 0;
+
+enum river_wifi_phase {
+	PHASE_IDLE = 0,
+	PHASE_SCANNING = 1,
+	PHASE_JOINING = 2,
+	PHASE_JOINED = 4,
+};
+static int river_power_state = 1;
+static enum river_wifi_phase active_phase = PHASE_IDLE;
+static struct river_apple80211_bss active_bss;
+
+static void
+hmac_sha1(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t mac[20])
+{
+	SHA1_CTX ctx;
+	uint8_t k_pad[64];
+	uint8_t tk[20];
+	size_t i;
+
+	if (key_len > 64) {
+		SHA1Init(&ctx);
+		SHA1Update(&ctx, key, key_len);
+		SHA1Final(tk, &ctx);
+		key = tk;
+		key_len = 20;
+	}
+
+	memset(k_pad, 0x36, sizeof(k_pad));
+	for (i = 0; i < key_len; i++) {
+		k_pad[i] ^= key[i];
+	}
+	SHA1Init(&ctx);
+	SHA1Update(&ctx, k_pad, 64);
+	SHA1Update(&ctx, data, data_len);
+	SHA1Final(mac, &ctx);
+
+	memset(k_pad, 0x5c, sizeof(k_pad));
+	for (i = 0; i < key_len; i++) {
+		k_pad[i] ^= key[i];
+	}
+	SHA1Init(&ctx);
+	SHA1Update(&ctx, k_pad, 64);
+	SHA1Update(&ctx, mac, 20);
+	SHA1Final(mac, &ctx);
+}
+
+void
+river_pbkdf2_pmk(const char *passphrase, const char *ssid, size_t ssid_len, uint8_t pmk[32])
+{
+	size_t pass_len = strlen(passphrase);
+	uint8_t salt[64];
+	uint8_t u[20];
+	uint8_t f[20];
+	uint32_t b, i, j;
+
+	for (b = 1; b <= 2; b++) {
+		memcpy(salt, ssid, ssid_len);
+		salt[ssid_len + 0] = (uint8_t)(b >> 24);
+		salt[ssid_len + 1] = (uint8_t)(b >> 16);
+		salt[ssid_len + 2] = (uint8_t)(b >> 8);
+		salt[ssid_len + 3] = (uint8_t)(b & 0xff);
+
+		hmac_sha1((const uint8_t *)passphrase, pass_len, salt, ssid_len + 4, u);
+		memcpy(f, u, 20);
+
+		for (i = 1; i < 4096; i++) {
+			hmac_sha1((const uint8_t *)passphrase, pass_len, u, 20, u);
+			for (j = 0; j < 20; j++) {
+				f[j] ^= u[j];
+			}
+		}
+
+		if (b == 1) {
+			memcpy(pmk, f, 20);
+		} else {
+			memcpy(pmk + 20, f, 12);
+		}
+	}
+}
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = {
+		.vendor_code = KEV_VENDOR_APPLE,
+		.kev_class = KEV_IEEE80211_CLASS,
+		.kev_subclass = 1,
+		.event_code = code,
+	};
+	char name[16];
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 :
+	    copyout(data, request->req_data, length < request->req_len ? length : request->req_len);
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned ch)
+{
+	channel->version = 1;
+	channel->channel = ch;
+	channel->flags = CHANNEL_20MHZ | CHANNEL_2GHZ | CHANNEL_ACTIVE;
+}
+
+static int
+give_network(const struct apple80211req *request, const struct river_apple80211_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) &&
+	    copyin(request->req_data, result, offsetof(struct apple80211_scan_result, elements)) == 0 &&
+	    result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->channel);
+	result->rssi = bss->rssi;
+	result->beacon_interval = bss->beacon_int;
+	result->capability = bss->caps;
+	memcpy(result->bssid, bss->bssid, 6);
+	result->ssid_length = bss->ssid_len;
+	memcpy(result->ssid, bss->ssid, bss->ssid_len);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->ies_len <= room ? bss->ies_len : 0);
+	if (result->elements_length > 0) {
+		memcpy(result->elements, bss->ies, result->elements_length);
+	}
+	for (unsigned at = 0; at + 2 <= bss->ies_len && at + 2 + bss->ies[at + 1] <= bss->ies_len;
+	    at += 2 + bss->ies[at + 1]) {
+		if (bss->ies[at] == 1 || bss->ies[at] == 50) {
+			for (unsigned i = 0; i < bss->ies[at + 1]; i++) {
+				unsigned rate = (bss->ies[at + 2 + i] & 0x7f) / 2;
+				if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+					result->rates[result->rate_count++] = rate;
+				}
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+static int
+get(struct apple80211req *request)
+{
+	int error = 0;
+	lck_mtx_lock(&river_apple80211_mtx);
+	switch (request->req_type) {
+		case 37: {
+		static const char cc[4] = "US";
+		error = give(request, cc, 2);
+		break;
+	}
+	case 14:
+		error = give(request, river_test_mac, 6);
+		break;
+	case 23:
+		request->req_val = 20;
+		error = 0;
+		break;
+	case 43:
+	case 44: {
+		static const char name[256] = "river: Qualcomm SDM632 (WCN36xx)";
+		error = give(request, name, sizeof(name));
+		break;
+	}
+	case 12: {
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		error = give(request, bits, sizeof(bits));
+		break;
+	}
+	case 19: {
+		struct {
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { river_power_state ? 1 : 0 } };
+		request->req_val = river_power_state ? 1 : 0;
+		error = give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 15:
+		request->req_val = 1;
+		error = 0;
+		break;
+	case 27:
+	case 254: {
+		struct apple80211_channels *answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO);
+		if (!answer) { error = ENOMEM; break; }
+		answer->version = 1;
+		answer->count = 11;
+		for (unsigned i = 0; i < 11; i++) {
+			channel_fill(&answer->channels[i], i + 1);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		break;
+	}
+	case 207: {
+		struct apple80211_channels_info *answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO);
+		if (!answer) { error = ENOMEM; break; }
+		answer->count = 11;
+		for (unsigned i = 0; i < 11; i++) {
+			struct apple80211_channel ch;
+			channel_fill(&ch, i + 1);
+			answer->number[i] = (uint8_t)(i + 1);
+			answer->dfs[i] = 0;
+			answer->passive[i] = 0;
+			answer->flags[i] = ch.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		break;
+	}
+	case 21:
+		request->req_val = (int32_t)join_result;
+		error = 0;
+		break;
+	case 11: {
+		if (scan_result_idx < river_bss_count) {
+			error = give_network(request, &river_bss_table[scan_result_idx++]);
+		} else {
+			error = EIO;
+		}
+		break;
+	}
+	case 13:
+		request->req_val = (active_phase == PHASE_JOINED ? 4 :
+		    (active_phase == PHASE_JOINING ? 2 :
+		    (active_phase == PHASE_SCANNING ? 1 : 0)));
+		error = 0;
+		break;
+	case 1:
+		if (active_phase != PHASE_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, active_bss.ssid, active_bss.ssid_len)) == 0) {
+			request->req_len = active_bss.ssid_len;
+		}
+		break;
+	case 9:
+		error = (active_phase != PHASE_JOINED) ? ENXIO : give(request, active_bss.bssid, 6);
+		break;
+	case 4: {
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+		if (active_phase != PHASE_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, active_bss.channel);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = {
+			.version = 1, .radios = 1,
+			.each = { active_bss.rssi }, .all = active_bss.rssi,
+			.each_ext = { active_bss.rssi }, .all_ext = active_bss.rssi,
+		};
+		error = (active_phase != PHASE_JOINED) ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:
+		error = (active_phase != PHASE_JOINED) ? ENXIO : give_network(request, &active_bss);
+		break;
+	case 2: {
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+		error = (active_phase != PHASE_JOINED) ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	lck_mtx_unlock(&river_apple80211_mtx);
+	return error;
+}
+
+static int
+set(const struct apple80211req *request)
+{
+	int error = 0;
+	switch (request->req_type) {
+	case 10: {
+		lck_mtx_lock(&river_apple80211_mtx);
+		if (active_phase == PHASE_JOINED) {
+			scan_pending_flag = false;
+			scan_result_idx = 0;
+			lck_mtx_unlock(&river_apple80211_mtx);
+			river_apple80211_scan_done(0);
+			break;
+		}
+		scan_pending_flag = true;
+		scan_result_idx = 0;
+		active_phase = PHASE_SCANNING;
+		lck_mtx_unlock(&river_apple80211_mtx);
+		break;
+	}
+	case 20: {
+		struct apple80211_assoc *asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+		if (!asked) return ENOMEM;
+		if (copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest)) != 0) {
+			kfree_data(asked, sizeof(*asked));
+			return EFAULT;
+		}
+		if (asked->ssid_length == 0 || asked->ssid_length > 32) {
+			kfree_data(asked, sizeof(*asked));
+			return EINVAL;
+		}
+		lck_mtx_lock(&river_apple80211_mtx);
+		memset(&pending_join, 0, sizeof(pending_join));
+		pending_join.ssid_len = (uint8_t)asked->ssid_length;
+		memcpy(pending_join.ssid, asked->ssid, asked->ssid_length);
+		memcpy(pending_join.bssid, asked->bssid, 6);
+		if (asked->key_length == 0) {
+			pending_join.has_pmk = false;
+		} else if (asked->key_length == 32) {
+			memcpy(pending_join.pmk, asked->key, 32);
+			pending_join.has_pmk = true;
+		} else if (asked->key_length == 64) {
+			bool hex_ok = true;
+			for (unsigned i = 0; i < 32 && hex_ok; i++) {
+				uint8_t hi = asked->key[2 * i], lo = asked->key[2 * i + 1];
+				int h = (hi >= '0' && hi <= '9') ? hi - '0' :
+				    (hi >= 'a' && hi <= 'f') ? hi - 'a' + 10 :
+				    (hi >= 'A' && hi <= 'F') ? hi - 'A' + 10 : -1;
+				int l = (lo >= '0' && lo <= '9') ? lo - '0' :
+				    (lo >= 'a' && lo <= 'f') ? lo - 'a' + 10 :
+				    (lo >= 'A' && lo <= 'F') ? lo - 'A' + 10 : -1;
+				if (h < 0 || l < 0) hex_ok = false;
+				else pending_join.pmk[i] = (uint8_t)((h << 4) | l);
+			}
+			if (hex_ok) {
+				pending_join.has_pmk = true;
+			}
+		} else if (asked->key_length >= 8 && asked->key_length <= 63) {
+			char pass[65] = {0};
+			memcpy(pass, asked->key, asked->key_length);
+			river_pbkdf2_pmk(pass, (const char *)pending_join.ssid, pending_join.ssid_len, pending_join.pmk);
+			pending_join.has_pmk = true;
+			memset_s(pass, sizeof(pass), 0, sizeof(pass));
+		}
+		printf("river_apple80211: join req key_len=%u key_cipher=%u has_pmk=%u\n",
+		    asked->key_length, asked->key_cipher, pending_join.has_pmk);
+		join_pending_flag = true;
+		join_result = 0;
+		active_phase = PHASE_JOINING;
+		lck_mtx_unlock(&river_apple80211_mtx);
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+		break;
+	}
+	case 22: {
+		lck_mtx_lock(&river_apple80211_mtx);
+		active_phase = PHASE_IDLE;
+		bzero(&active_bss, sizeof(active_bss));
+		lck_mtx_unlock(&river_apple80211_mtx);
+		river_apple80211_link_changed(false, 0);
+		break;
+	}
+	case 19: {
+		lck_mtx_lock(&river_apple80211_mtx);
+		int pwr = request->req_val;
+		if (request->req_data != USER_ADDR_NULL && request->req_len >= 12) {
+			struct {
+				uint32_t version, radios, state[4];
+			} ps = {0};
+			if (copyin(request->req_data, &ps, sizeof(ps)) == 0) {
+				pwr = (int)ps.state[0];
+			}
+		}
+		river_power_state = (pwr != 0);
+		if (!river_power_state) {
+			active_phase = PHASE_IDLE;
+			bzero(&active_bss, sizeof(active_bss));
+		}
+		lck_mtx_unlock(&river_apple80211_mtx);
+		if (!river_power_state) {
+			river_apple80211_link_changed(false, 0);
+		}
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+void
+river_apple80211_add_bss(const uint8_t *bssid, const uint8_t *ssid, uint8_t ssid_len,
+    uint16_t freq, int16_t rssi, uint16_t beacon_int, uint16_t caps,
+    const uint8_t *ies, uint16_t ies_len)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	unsigned i;
+	for (i = 0; i < river_bss_count; i++) {
+		if (memcmp(river_bss_table[i].bssid, bssid, 6) == 0) {
+			break;
+		}
+	}
+	if (i == river_bss_count && i < RIVER_MAX_BSS) {
+		river_bss_count++;
+	}
+	if (i < RIVER_MAX_BSS) {
+		memcpy(river_bss_table[i].bssid, bssid, 6);
+		river_bss_table[i].ssid_len = ssid_len < 32 ? ssid_len : 32;
+		memcpy(river_bss_table[i].ssid, ssid, river_bss_table[i].ssid_len);
+		river_bss_table[i].freq = freq;
+		river_bss_table[i].channel = freq == 2484 ? 14 : (freq < 4000 ? (freq - 2407) / 5 : (freq - 5000) / 5);
+		river_bss_table[i].rssi = rssi;
+		river_bss_table[i].beacon_int = beacon_int;
+		river_bss_table[i].caps = caps;
+		river_bss_table[i].age_ms = 0;
+		river_bss_table[i].ies_len = ies_len < sizeof(river_bss_table[i].ies) ? ies_len : sizeof(river_bss_table[i].ies);
+		if (river_bss_table[i].ies_len > 0 && ies != NULL) {
+			memcpy(river_bss_table[i].ies, ies, river_bss_table[i].ies_len);
+		}
+	}
+	lck_mtx_unlock(&river_apple80211_mtx);
+}
+
+void
+river_apple80211_clear_scan(void)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	river_bss_count = 0;
+	scan_result_idx = 0;
+	lck_mtx_unlock(&river_apple80211_mtx);
+}
+
+bool
+river_apple80211_find_target(const struct river_apple80211_join_req *req, struct river_apple80211_target_info *info)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	const struct river_apple80211_bss *target = NULL;
+	for (unsigned i = 0; i < river_bss_count; i++) {
+		if (river_bss_table[i].ssid_len == req->ssid_len &&
+		    memcmp(river_bss_table[i].ssid, req->ssid, req->ssid_len) == 0) {
+			bool bssid_zero = true;
+			for (unsigned k = 0; k < 6; k++) if (req->bssid[k]) bssid_zero = false;
+			if (bssid_zero || memcmp(river_bss_table[i].bssid, req->bssid, 6) == 0) {
+				target = &river_bss_table[i];
+				break;
+			}
+		}
+	}
+	if (!target) {
+		for (unsigned i = 0; i < river_bss_count; i++) {
+			if (river_bss_table[i].ssid_len == req->ssid_len &&
+			    memcmp(river_bss_table[i].ssid, req->ssid, req->ssid_len) == 0) {
+				target = &river_bss_table[i];
+				break;
+			}
+		}
+	}
+	if (!target) {
+		lck_mtx_unlock(&river_apple80211_mtx);
+		return false;
+	}
+	bzero(info, sizeof(*info));
+	memcpy(info->bssid, target->bssid, 6);
+	info->channel = target->channel ? target->channel : 1;
+	info->beacon = target->beacon_int;
+	info->caps = target->caps;
+	info->dtim = 1;
+	info->rssi = target->rssi;
+
+	static const uint8_t supported[] = {2, 4, 11, 22, 12, 18, 24, 36, 48, 72, 96, 108};
+	for (unsigned off = 0; off + 2 <= target->ies_len;) {
+		unsigned id = target->ies[off], n = target->ies[off + 1];
+		off += 2;
+		if (n > target->ies_len - off) break;
+		if (id == 1 || id == 50) {
+			for (unsigned k = 0; k < n; k++) {
+				unsigned v = target->ies[off + k], j;
+				for (j = 0; j < sizeof(supported) && (v & 127) != supported[j]; j++) {}
+				if (j == sizeof(supported)) continue;
+				for (j = 0; j < info->nrates && (info->rates[j] & 127) != (v & 127); j++) {}
+				if (j < info->nrates) info->rates[j] |= (v & 128);
+				else if (j < 12) info->rates[info->nrates++] = v;
+			}
+		}
+		if (id == 5 && n >= 2 && target->ies[off + 1]) {
+			info->dtim = target->ies[off + 1];
+		}
+		if (id == 48) {
+			static const uint8_t rsn_std[] = {48, 20, 1, 0, 0, 15, 172, 4, 1, 0, 0, 15, 172, 4, 1, 0, 0, 15, 172, 2, 0, 0};
+			memcpy(info->rsn, rsn_std, sizeof(rsn_std));
+			info->rsn_len = sizeof(rsn_std);
+			info->ap_rsn_len = n + 2;
+			info->ap_rsn[0] = 48;
+			info->ap_rsn[1] = n;
+			memcpy(info->ap_rsn + 2, target->ies + off, n);
+		}
+		off += n;
+	}
+	if (info->nrates == 0) {
+		static const uint8_t default_rates[] = {0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24, 0x30, 0x48, 0x60, 0x6c};
+		info->nrates = sizeof(default_rates);
+		memcpy(info->rates, default_rates, sizeof(default_rates));
+	}
+	lck_mtx_unlock(&river_apple80211_mtx);
+	return true;
+}
+
+void
+river_apple80211_scan_done(int status)
+{
+	(void)status;
+	lck_mtx_lock(&river_apple80211_mtx);
+	scan_result_idx = 0;
+	scan_pending_flag = false;
+	if (active_phase == PHASE_SCANNING) {
+		active_phase = PHASE_IDLE;
+	}
+	lck_mtx_unlock(&river_apple80211_mtx);
+	post(EVENT_SCAN_DONE, NULL, 0);
+	printf("river_apple80211: scan complete, posted EVENT_SCAN_DONE (%u BSS found)\n", river_bss_count);
+}
+
+void
+river_apple80211_assoc_done(int status)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	join_result = (uint32_t)status;
+	join_pending_flag = false;
+	if (status == 0) {
+		active_phase = PHASE_JOINED;
+		for (unsigned i = 0; i < river_bss_count; i++) {
+			if (river_bss_table[i].ssid_len == pending_join.ssid_len &&
+			    memcmp(river_bss_table[i].ssid, pending_join.ssid, pending_join.ssid_len) == 0) {
+				memcpy(&active_bss, &river_bss_table[i], sizeof(active_bss));
+				break;
+			}
+		}
+	} else {
+		active_phase = PHASE_IDLE;
+		bzero(&active_bss, sizeof(active_bss));
+	}
+	lck_mtx_unlock(&river_apple80211_mtx);
+	post(EVENT_ASSOC_DONE, NULL, 0);
+	printf("river_apple80211: assoc finished, status=%d join_result=%u, posted EVENT_ASSOC_DONE\n",
+	    status, join_result);
+}
+
+void
+river_apple80211_link_changed(bool up, int16_t rssi)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	if (up) {
+		active_phase = PHASE_JOINED;
+		for (unsigned i = 0; i < river_bss_count; i++) {
+			if (river_bss_table[i].ssid_len == pending_join.ssid_len &&
+			    memcmp(river_bss_table[i].ssid, pending_join.ssid, pending_join.ssid_len) == 0) {
+				memcpy(&active_bss, &river_bss_table[i], sizeof(active_bss));
+				break;
+			}
+		}
+		active_bss.rssi = rssi;
+	} else {
+		active_phase = PHASE_IDLE;
+		bzero(&active_bss, sizeof(active_bss));
+	}
+	struct apple80211_link_changed link = {
+		.down = !up,
+		.involuntary = !up,
+		.rssi = rssi,
+		.reason = up ? 0 : 4,
+	};
+	lck_mtx_unlock(&river_apple80211_mtx);
+
+	post(EVENT_SSID_CHANGED, NULL, 0);
+	post(EVENT_BSSID_CHANGED, NULL, 0);
+	post(EVENT_LINK_CHANGED, &link, sizeof(link));
+	printf("river_apple80211: link %s (rssi=%d dBm), posted EVENT_LINK_CHANGED\n",
+	    up ? "UP" : "DOWN", rssi);
+}
+
+bool
+river_apple80211_scan_pending(void)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	bool pending = scan_pending_flag && (active_phase != PHASE_JOINED);
+	lck_mtx_unlock(&river_apple80211_mtx);
+	return pending;
+}
+
+bool
+river_apple80211_join_pending(struct river_apple80211_join_req *req)
+{
+	lck_mtx_lock(&river_apple80211_mtx);
+	bool pending = join_pending_flag;
+	if (pending && req != NULL) {
+		memcpy(req, &pending_join, sizeof(*req));
+	}
+	join_pending_flag = false;
+	lck_mtx_unlock(&river_apple80211_mtx);
+	return pending;
+}
+
+void
+river_apple80211_init(void)
+{
+	static bool initialized = false;
+	if (initialized) return;
+	initialized = true;
+	printf("river_apple80211: initialized Apple80211 interface\n");
+}
+
+errno_t
+river_apple80211_ioctl(u_long command, void *data)
+{
+	struct apple80211req *request = data;
+	bool is_set = (command == SIOCSA80211);
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	error = is_set ? set(request) : get(request);
+	return error;
+}
