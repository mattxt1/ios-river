diff --git a/bsd/dev/river_rpm_reply.h b/bsd/dev/river_rpm_reply.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/river_rpm_reply.h
@@ -0,0 +1,52 @@
+/* RPM V0 replies on the observed1024-byte SMD packet FIFO. Read-side only:
+ * callers must own/serialize the channel before using this for another client.
+ * An ACK belongs only to its exact nonzero request ID. */
+enum {
+ RI_RPM_REPLY_BAD=-2, RI_RPM_REPLY_NACK=-1, RI_RPM_REPLY_WAIT=0,
+ RI_RPM_REPLY_ACK=1, RI_RPM_REPLY_STALE=2
+};
+static int
+ri_rpm_v0_reply(const uint32_t *payload, unsigned bytes,
+    uint32_t wanted, uint32_t *reply_id)
+{
+ if(!payload || !reply_id || !wanted || bytes<20 || bytes>128) return RI_RPM_REPLY_BAD;
+ if(payload[0]!=0x00716572u || payload[1]!=bytes-8 ||
+    payload[2]!=0x2367736du || payload[3]!=4 || !payload[4]) return RI_RPM_REPLY_BAD;
+ *reply_id=payload[4];
+ int result=RI_RPM_REPLY_ACK;
+ if(bytes!=20) {
+  /* A V0 error follows msg#: err, byte-length, error text. Unknown or
+   * inconsistent trailing data must never be accepted as success. */
+  if(bytes<28 || payload[5]!=0x00727265u || payload[6]!=bytes-28) return RI_RPM_REPLY_BAD;
+  result=RI_RPM_REPLY_NACK;
+ }
+ return *reply_id==wanted?result:RI_RPM_REPLY_STALE;
+}
+static int
+ri_rpm_take_reply(vm_offset_t auxmem, vm_offset_t fifo, vm_offset_t ipc,
+    uint32_t wanted, uint32_t *reply_id)
+{
+ if(!reply_id || !wanted) return RI_RPM_REPLY_BAD;
+ *reply_id=0;
+ if(ri_rd(auxmem,0)!=2 || ri_rd(auxmem,44)!=2) return RI_RPM_REPLY_BAD;
+ uint32_t head=ri_rd(auxmem,84), tail=ri_rd(auxmem,80);
+ if(head>=1024 || tail>=1024 || ((head|tail)&3)) return RI_RPM_REPLY_BAD;
+ unsigned available=(head-tail)&1023;
+ if(available<20) return RI_RPM_REPLY_WAIT;
+ __asm__ volatile("dmb sy" ::: "memory");
+ uint32_t bytes=ri_rd(fifo,tail);
+ if(bytes<20 || bytes>128) return RI_RPM_REPLY_BAD;
+ unsigned total=20+((bytes+3)&~3u);
+ if(available<total) return RI_RPM_REPLY_WAIT;
+ uint32_t payload[32]={0};
+ for(unsigned offset=0;offset<bytes;offset+=4)
+  payload[offset/4]=ri_rd(fifo,(tail+20+offset)&1023);
+ int result=ri_rpm_v0_reply(payload,bytes,wanted,reply_id);
+ if(result==RI_RPM_REPLY_BAD) return result; /* Leave malformed packet alone. */
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(auxmem,80,(tail+total)&1023);
+ ri_wr(auxmem,68,1);
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(ipc,0,1);
+ return result;
+}
