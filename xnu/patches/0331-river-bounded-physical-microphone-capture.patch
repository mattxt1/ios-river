diff --git a/bsd/dev/river_adsp_capture.h b/bsd/dev/river_adsp_capture.h
--- /dev/null
+++ b/bsd/dev/river_adsp_capture.h
@@ -0,0 +1,136 @@
+/* Read protocol pinned to River q6asm/apr_audio-v2: READ_V2 0x10dac,
+ * READ_DONE_V2 0x10d9a, mono48k/S16. Separate permanent DMA page and session6.
+ * Exact service/port/token/opcode match remains in ri_pcm_transaction. */
+static struct {
+ bool attempted,mapped,asm_open,adm_open,afe_started,running,in_flight;
+ bool connected,defined,active,uncertain,codec_restored,complete;
+ vm_offset_t page;uint64_t physical;
+ uint32_t handle,copp;
+ unsigned submitted,completed,frames,peak,tid,bad_reg;
+ int error,cleanup_error;
+ const char *phase;
+} ri_mic;
+static int
+ri_mic_command(uint32_t source,uint32_t destination,uint32_t opcode,uint32_t response,
+ const uint32_t *payload,unsigned words,struct ri_apr_reply *reply)
+{
+ struct ri_apr_request request={source,destination,0,opcode,response,payload,words};
+ return ri_pcm_transaction(&request,reply);
+}
+/* Validate ALL returned DMA metadata before invalidation or CPU access. A
+ * foreign address/handle, range or metadata layout retains mapping ownership. */
+static bool
+ri_mic_read_done(const struct ri_apr_reply *reply,uint64_t address,uint32_t handle,
+ unsigned sequence,unsigned *offset,unsigned *bytes)
+{
+ if(reply->words!=11 || reply->data[0] || reply->data[1]!=(uint32_t)address ||
+    reply->data[2]!=(uint32_t)(address>>32) || reply->data[3]!=handle ||
+    !reply->data[4] || reply->data[4]>4096 || reply->data[5]>4096-reply->data[4] ||
+    ((reply->data[4]|reply->data[5])&1) || (reply->data[8]&~0x80000000u) ||
+    reply->data[10]!=sequence)return false;
+ *offset=reply->data[5];*bytes=reply->data[4];return true;
+}
+static void
+ri_mic_invalidate(vm_offset_t page)
+{
+ /* Dedicated full page; CPU never dirties an owned DSP slot. Cleaned once
+  * before MAP; invalidate only after exact READ_DONE returned ownership. */
+ for(vm_offset_t p=page;p<page+PAGE_SIZE;p+=64)
+  __asm__ volatile("dc ivac, %0" :: "r"(p) : "memory");
+ __asm__ volatile("dsb sy" ::: "memory");
+}
+static int
+ri_mic_channel_command(vm_offset_t base,unsigned opcode,uint8_t *payload,unsigned bytes,unsigned tid_offset)
+{
+ if(ri_mic.tid>=0xef || bytes>16 || tid_offset>=bytes)return EINVAL;
+ unsigned tid=++ri_mic.tid;payload[tid_offset]=(uint8_t)tid;
+ uint32_t packet[5]={0};uint8_t *wire=(uint8_t *)packet;wire[0]=(uint8_t)(0x40|(bytes+3));
+ wire[1]=(uint8_t)opcode;wire[2]=0xff;memcpy(wire+3,payload,bytes);
+ ri_ngd.ack_tid=tid;ri_ngd.ack_status=0;ri_ngd.acked=false;ri_ngd.ack_waiting=true;
+ int error=ri_ngd_send(base,packet,bytes+3);
+ if(!error)for(unsigned i=0;i<200 && !ri_ngd.acked;i++) {
+  bool sent=false;error=ri_ngd_poll(base,&sent);if(error)break;
+  if(!ri_ngd.acked)ri_wait(5);
+ }
+ ri_ngd.ack_waiting=false;
+ if(!error && !ri_ngd.acked)error=ETIMEDOUT;
+ if(error && (error!=EREMOTE || !ri_ngd.acked))ri_mic.uncertain=true;
+ return error;
+}
+static void
+ri_mic_dsp_cleanup(void)
+{
+ struct ri_apr_reply reply;const uint32_t stream=0x06010000;
+ int error;
+ if(ri_mic.running && !ri_pcm.poisoned) {
+  error=ri_mic_command(stream|0x507,stream|0x407,0x10bd3,0,NULL,0,&reply);
+  if(error)ri_mic.cleanup_error=error;else ri_mic.running=false;
+ }
+ if(ri_mic.asm_open && !ri_pcm.poisoned) {
+  error=ri_mic_command(stream|0x507,stream|0x407,0x10bcd,0,NULL,0,&reply);
+  if(error)ri_mic.cleanup_error=error;else ri_mic.asm_open=ri_mic.running=false;
+ }
+ if(ri_mic.adm_open && !ri_pcm.poisoned) {
+  error=ri_mic_command(0x40010508,(ri_mic.copp<<16)|0x408,0x10327,0,NULL,0,&reply);
+  if(error)ri_mic.cleanup_error=error;else ri_mic.adm_open=false;
+ }
+ if(ri_mic.afe_started && !ri_pcm.poisoned) {
+  uint32_t port=0x4001;error=ri_mic_command(0x504,0x404,0x100e6,0,&port,1,&reply);
+  if(error)ri_mic.cleanup_error=error;else ri_mic.afe_started=false;
+ }
+ if(ri_mic.mapped && !ri_mic.in_flight && !ri_pcm.poisoned &&
+    !ri_mic.asm_open && !ri_mic.adm_open && !ri_mic.afe_started && !ri_mic.cleanup_error) {
+  error=ri_mic_command(0x507,0x407,0x10d94,0,&ri_mic.handle,1,&reply);
+  if(error)ri_mic.cleanup_error=error;else ri_mic.mapped=false;
+ }
+}
+static int
+ri_mic_dsp_run(void)
+{
+ struct ri_apr_reply reply;int error;const uint32_t stream=0x06010000;
+ ri_mic.phase="asm_open_read";
+ uint32_t open[]={0,0,0x10c68,0x10da5,16};
+ error=ri_mic_command(stream|0x507,stream|0x407,0x10db4,0,open,5,&reply);if(error)return error;
+ ri_mic.asm_open=true;ri_mic.phase="encoder_pcm";
+ uint32_t format[]={0x10da3,28,0,20,(16u<<16)|1,48000,1,3,0};
+ error=ri_mic_command(stream|0x507,stream|0x407,0x10c10,0,format,9,&reply);if(error)return error;
+ ri_mic.phase="adm_tx_open";
+ uint32_t device[]={2u<<16,0xffff4001,0x10312,(16u<<16)|1,48000,3,0};
+ error=ri_mic_command(0x40010508,0x40010408,0x10326,0x10329,device,7,&reply);if(error)return error;
+ if(reply.words!=2 || reply.data[0] || (reply.data[1]>>16) || reply.data[1]>=0xff) {
+  ri_pcm.poisoned=true;return EIO;
+ }
+ ri_mic.copp=reply.data[1];ri_mic.adm_open=true;
+ uint32_t matrix[]={1,1,0x10000|6,ri_mic.copp};ri_mic.phase="tx_matrix";
+ error=ri_mic_command(0x508,0x408,0x10325,0,matrix,4,&reply);if(error)return error;
+ uint32_t run[]={0,0,0};ri_mic.phase="run";
+ error=ri_mic_command(stream|0x507,stream|0x407,0x10daa,0,run,3,&reply);if(error)return error;
+ ri_mic.running=true;uint64_t start=ri_pipeline_now();
+ for(unsigned index=0;index<48;index++) {
+  if(ri_pipeline_now()-start>3500000000ULL)return ETIMEDOUT;
+  uint64_t address=ri_mic.physical+(index&3)*4096;
+  uint32_t read[]={(uint32_t)address,(uint32_t)(address>>32),ri_mic.handle,4096,index};
+  ri_mic.phase="read_done";ri_mic.in_flight=true;
+  error=ri_mic_command(stream|0x507,stream|0x407,0x10dac,0x10d9a,read,5,&reply);
+  if(reply.sent)ri_mic.submitted++;else ri_mic.in_flight=false;
+  if(error)return error;
+  unsigned offset=0,bytes=0;
+  if(!ri_mic_read_done(&reply,address,ri_mic.handle,index,&offset,&bytes) ||
+     bytes/2>98304-ri_mic.frames) {ri_pcm.poisoned=true;return EIO;}
+  ri_mic.in_flight=false;ri_mic.completed++;
+  ri_mic_invalidate(ri_mic.page);
+  const int16_t *samples=(const int16_t *)(ri_mic.page+(index&3)*4096+offset);
+  /* No sample reads until exact completion and cache invalidation. */
+  lck_mtx_lock(&ri_mic_buffer_lock);
+  memcpy(ri_mic_capture.samples+ri_mic.frames,samples,bytes);
+  lck_mtx_unlock(&ri_mic_buffer_lock);
+  for(unsigned n=0;n<bytes/2;n++) {
+   int value=samples[n];unsigned peak=value<0?(unsigned)-value:(unsigned)value;
+   if(peak>ri_mic.peak)ri_mic.peak=peak;
+  }
+  ri_mic.frames+=bytes/2;
+  uint16_t lock=ri_clock_read(0x1881);
+  if(lock==0xffff || !(lock&0x100))return EIO;
+ }
+ ri_mic.phase="captured";return 0;
+}
