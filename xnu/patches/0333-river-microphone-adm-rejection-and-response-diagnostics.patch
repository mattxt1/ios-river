  const uint32_t *payload,unsigned words,struct ri_apr_reply *reply)
 {
  struct ri_apr_request request={source,destination,0,opcode,response,payload,words};
- return ri_pcm_transaction(&request,reply);
+ int error=ri_pcm_transaction(&request,reply);
