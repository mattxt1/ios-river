+/* GET payload_size is parameter capacity, excluding its12-byte record header.
+ * Parse the self-declared24-byte config; bounded trailing transport words are
+ * opaque, as on the verified playback GET path. Keep every readback strict. */
+static int
+ri_mic_afe_config(void)
+{
+ struct ri_apr_reply reply;
+ const uint32_t expected[]={0,0x1020c,0x10212,24,1,16u<<16,1u<<16,128,0,48000};
+ uint32_t config[13]={(36u<<16)|0x4001,0,0,0,0x1020c,0x10212,24};
+ memcpy(config+7,expected+4,24);ri_mic.phase="afe_tx_config";
+ int error=ri_mic_command(0x504,0x404,0x100ef,0,config,13,&reply);if(error)return error;
+ uint32_t get[]={(24u<<16)|0x4001,0,0,0,0x1020c,0x10212};ri_mic.phase="afe_tx_readback";
+ error=ri_mic_command(0x504,0x404,0x100f0,0x10106,get,6,&reply);
+ ri_mic.afe_words=reply.words;
+ unsigned words=reply.words<10?reply.words:10;
+ memcpy(ri_mic.afe_reply,reply.data,words*4);
+ if(error)return error;
+ if(reply.words<10 || memcmp(reply.data,expected,sizeof(expected)))return EIO;
+ return 0;
+}
 static int
 ri_mic_dsp_run(void)
 {
