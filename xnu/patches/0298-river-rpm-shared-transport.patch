diff --git a/bsd/dev/river_rpm_transport.h b/bsd/dev/river_rpm_transport.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/river_rpm_transport.h
@@ -0,0 +1,68 @@
+/* Shared APPS->RPM V0 request transport. Caller holds ri_rpm_lock across
+ * handshake, request and reply. Pointers refer to validated item18/342 maps.
+ * A timeout is an unknown remote outcome, never an ACK or a rollback. */
+struct ri_rpm_kv { uint32_t key, value; };
+static struct {
+ uint32_t next_id;
+ unsigned boot_votes;
+ bool ready;
+} ri_rpm_channel = { .next_id=0x52490001u };
+
+enum { RI_RPM_REQUEST_TIMEOUT=-3, RI_RPM_REQUEST_GATED=-4 };
+static bool
+ri_rpm_layout(vm_offset_t smem)
+{
+ const unsigned info=0xd0+18*16, fifo=0xd0+342*16;
+ return ri_rd(smem,info)==1 && ri_rd(smem,info+4)==0 &&
+     ri_rd(smem,info+8)==88 && ri_rd(smem,info+12)==0x60000 &&
+     ri_rd(smem,fifo)==1 && ri_rd(smem,fifo+4)==0x800 &&
+     ri_rd(smem,fifo+8)==0x800 && ri_rd(smem,fifo+12)==0x60000;
+}
+static int
+ri_rpm_request_locked(vm_offset_t aux, vm_offset_t ipc, bool boot_client,
+    uint32_t set, uint32_t type, uint32_t resource,
+    const struct ri_rpm_kv *kv, unsigned count, uint32_t *request_id)
+{
+ lck_mtx_assert(&ri_rpm_lock,LCK_MTX_ASSERT_OWNED);
+ if(!request_id) return RI_RPM_REPLY_BAD;
+ *request_id=0;
+ if(!boot_client && !ri_rpm_channel.ready) return RI_RPM_REQUEST_GATED;
+ if(!kv || !count || count>3 || set>1 || !type ||
+    !ri_rpm_channel.next_id || ri_rpm_channel.next_id==0xffffffffu)
+  return RI_RPM_REPLY_BAD;
+ uint32_t packet[21]={0}; /* 20-byte SMD header, V0 header, <=3 KVPs. */
+ unsigned bytes=48+count*12;
+ packet[0]=bytes-20; packet[5]=0x00716572; packet[6]=bytes-28;
+ packet[8]=set; packet[9]=type; packet[10]=resource; packet[11]=count*12;
+ for(unsigned i=0;i<count;i++) {
+  packet[12+i*3]=kv[i].key; packet[13+i*3]=4; packet[14+i*3]=kv[i].value;
+ }
+ uint32_t head=0;
+ bool space=false;
+ for(unsigned wait=0;wait<500;wait++) {
+  if(ri_rd(aux,0)!=2 || ri_rd(aux,44)!=2) return RI_RPM_REPLY_BAD;
+  head=ri_rd(aux,40);
+  uint32_t tail=ri_rd(aux,36);
+  if(head>=1024 || tail>=1024 || ((head|tail)&3)) return RI_RPM_REPLY_BAD;
+  if(((tail-head-4)&1023)>=bytes) { space=true; break; }
+  delay(1000);
+ }
+ if(!space) return RI_RPM_REQUEST_TIMEOUT; /* No FIFO/control writes. */
+ uint32_t id=ri_rpm_channel.next_id++;
+ *request_id=id; packet[7]=id;
+ for(unsigned offset=0;offset<bytes;offset+=4)
+  ri_wr(aux+0x800,(head+offset)&1023,packet[offset/4]);
+ /* Publish complete packet before head, then flags before the IPC doorbell. */
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(aux,40,(head+bytes)&1023);
+ ri_wr(aux,24,0); ri_wr(aux,20,1);
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(ipc,0,1);
+ for(unsigned wait=0;wait<500;wait++) {
+  uint32_t response=0;
+  int result=ri_rpm_take_reply(aux,aux+0xc00,ipc,id,&response);
+  if(result!=RI_RPM_REPLY_WAIT && result!=RI_RPM_REPLY_STALE) return result;
+  delay(1000);
+ }
+ return RI_RPM_REQUEST_TIMEOUT;
+}
