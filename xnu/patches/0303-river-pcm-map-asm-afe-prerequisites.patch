diff --git a/bsd/dev/river_adsp_pcm.h b/bsd/dev/river_adsp_pcm.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/river_adsp_pcm.h
@@ -0,0 +1,231 @@
+/* Bounded serialized APR transactions on the proven CID6 channel. ri_adsp_lock
+ * owns all channel access. No receive worker or physical PCM submission yet.
+ * One dedicated contiguous page is retained for this entire boot, including
+ * map/unmap failures. Never reuse firmware, TZ metadata or another DMA page. */
+struct ri_apr_request {
+ uint32_t source,destination,token,opcode,response;
+ const uint32_t *payload;
+ unsigned words;
+};
+struct ri_apr_reply {uint32_t status,data[32];unsigned words;bool sent,complete;};
+static struct {
+ bool poisoned,map_attempted,mapped,unmapped,asm_attempted,asm_open,asm_format,asm_closed;
+ bool afe_attempted;
+ vm_offset_t page;
+ uint64_t physical;
+ uint32_t handle,sequence,opcode,token,status;
+ unsigned transactions,notifications;
+} ri_pcm;
+static char ri_pcm_note[1536]="not requested; physical playback/capture pending";
+static int
+ri_pcm_result(const char *phase,int error)
+{
+ snprintf(ri_pcm_note,sizeof(ri_pcm_note),
+  "phase=%s error=%d poisoned=%u transactions=%u notifications=%u opcode=%#x token=%#x dsp_status=%#x page_retained=%u region_bytes=%u physical=%#llx map_attempted=%u mapped=%u handle=%#x unmapped=%u asm_attempted=%u asm_open=%u asm_format=%u asm_closed=%u afe_attempted=%u pcm_transport=0 playback=discarded capture=synthetic",
+  phase,error,ri_pcm.poisoned,ri_pcm.transactions,ri_pcm.notifications,ri_pcm.opcode,
+  ri_pcm.token,ri_pcm.status,!!ri_pcm.page,ri_pcm.page?(unsigned)PAGE_SIZE:0,
+  (unsigned long long)ri_pcm.physical,ri_pcm.map_attempted,ri_pcm.mapped,ri_pcm.handle,
+  ri_pcm.unmapped,ri_pcm.asm_attempted,ri_pcm.asm_open,ri_pcm.asm_format,ri_pcm.asm_closed,ri_pcm.afe_attempted);
+ printf("RIVER PCM: %s\n",ri_pcm_note);return error;
+}
+/* Returns WAIT only for a partial SMD packet, STALE for bounded unrelated
+ * notifications, ACK_ONLY for a map ACK without its separate handle reply. */
+static int
+ri_pcm_decode(const uint32_t *packet,unsigned bytes,const struct ri_apr_request *request,
+ struct ri_apr_reply *reply)
+{
+ if(bytes<20 || bytes>512 || (bytes&3))return RI_APR_BAD;
+ unsigned field=packet[0]&0xffff,header=((field>>4)&15)*4,size=packet[0]>>16;
+ if((field&0xfc00) || (field&15)>1 || header<20 || size<header || size>bytes)return RI_APR_BAD;
+ if(((field>>8)&3)>1 || packet[1]!=request->destination || packet[2]!=request->source ||
+    packet[3]!=request->token)return RI_APR_STALE;
+ const uint32_t *data=packet+header/4;unsigned words=(size-header)/4;
+ if((size-header)&3)return RI_APR_BAD;
+ if(packet[4]==0x110e8) {
+  if(words<2)return RI_APR_BAD;
+  if(data[0]!=request->opcode)return RI_APR_STALE;
+  reply->status=data[1];
+  if(data[1]) {reply->complete=true;return RI_APR_NACK;}
+  if(request->response)return RI_APR_ACK_ONLY;
+  reply->complete=true;return RI_APR_STATE;
+ }
+ if(!request->response || packet[4]!=request->response)return RI_APR_STALE;
+ if(!words || words>32)return RI_APR_BAD;
+ memcpy(reply->data,data,words*4);reply->words=words;reply->complete=true;
+ return RI_APR_STATE;
+}
+static int
+ri_pcm_receive(const struct ri_apr_channel *ch,const struct ri_apr_request *request,
+ struct ri_apr_reply *reply)
+{
+ if(ri_rd(ch->info,0)!=2 || ri_rd(ch->info,20)!=2 || !ri_apr_indices(ch))return RI_APR_BAD;
+ uint32_t head=ri_rd(ch->info,36),tail=ri_rd(ch->info,32);
+ if(head>=8192 || tail>=8192 || ((head|tail)&3))return RI_APR_BAD;
+ unsigned available=(head-tail)&8191;
+ if(available<20)return RI_APR_WAIT;
+ __asm__ volatile("dmb sy" ::: "memory");
+ uint32_t bytes=ri_rd(ch->rx,tail),packet[128];
+ if(bytes<20 || bytes>512 || (bytes&3))return RI_APR_BAD;
+ if(available<20+bytes)return RI_APR_WAIT;
+ for(unsigned i=0;i<bytes;i+=4)packet[i/4]=ri_rd(ch->rx,(tail+20+i)&8191);
+ int result=ri_pcm_decode(packet,bytes,request,reply);
+ if(result==RI_APR_BAD)return result;
+ __asm__ volatile("dmb sy" ::: "memory");
+ ri_wr(ch->info,32,(tail+20+bytes)&8191);ri_apr_write8(ch->info+9,1);
+ ri_apr_ack_flags(ch);ri_apr_notify(ch);return result;
+}
+static int
+ri_pcm_transaction(struct ri_apr_request *request,struct ri_apr_reply *reply)
+{
+ lck_mtx_assert(&ri_adsp_lock,LCK_MTX_ASSERT_OWNED);
+ memset(reply,0,sizeof(*reply));
+ if(request->words>123 || (request->words && !request->payload))return EINVAL;
+ vm_offset_t smem=river_smd_smem;struct ri_apr_channel ch,again;
+ if(ri_pcm.poisoned || !ri_apr.received || !ri_apr.state || !ri_apr.owned || !ri_apr.opened ||
+    !smem || !ri_apr_dsp_ready(smem) || !ri_apr_resolve(smem,&ch) ||
+    (uint32_t)(ch.info-smem)!=ri_apr.info_offset || (uint32_t)(ch.tx-smem)!=ri_apr.fifo_offset ||
+    ri_rd(ch.info,0)!=2 || ri_rd(ch.info,20)!=2 || !ri_apr_indices(&ch))return EBUSY;
+ vm_offset_t ipc=ml_io_map_unmappable(0x0b010000,0x4000,VM_WIMG_IO);
+ if(!ipc)return ENOMEM;
+ int error=EIO;
+ if(!ri_apr_dsp_ready(smem) || !ri_apr_resolve(smem,&again) || again.info!=ch.info ||
+    again.tx!=ch.tx || ri_rd(ch.info,0)!=2 || ri_rd(ch.info,20)!=2 || !ri_apr_indices(&ch))goto done;
+ ch.ipc=ipc+0x1008;
+ /* Sequence cannot wrap within the bounded operations exposed below. */
+ request->token=0x52420000u+(++ri_pcm.sequence);
+ ri_pcm.opcode=request->opcode;ri_pcm.token=request->token;ri_pcm.status=0;
+ unsigned bytes=20+request->words*4,frame_bytes=20+bytes;
+ bool space=false;
+ for(unsigned i=0;i<100;i++) {
+  if(!ri_apr_dsp_ready(smem) || ri_rd(ch.info,0)!=2 || ri_rd(ch.info,20)!=2 || !ri_apr_indices(&ch))goto done;
+  uint32_t head=ri_rd(ch.info,16),tail=ri_rd(ch.info,12);
+  if(((tail-head-4)&8191)>=frame_bytes) {space=true;break;}
+  ri_wait(5);
+ }
+ if(!space) {error=ETIMEDOUT;goto done;}
+ uint32_t frame[133]={0};frame[0]=bytes;frame[5]=(bytes<<16)|0x250;
+ frame[6]=request->source;frame[7]=request->destination;frame[8]=request->token;frame[9]=request->opcode;
+ if(request->words)memcpy(frame+10,request->payload,request->words*4);
+ uint32_t head=ri_rd(ch.info,16);
+ for(unsigned i=0;i<frame_bytes;i+=4)ri_wr(ch.tx,(head+i)&8191,frame[i/4]);
+ __asm__ volatile("dmb sy" ::: "memory");
+ reply->sent=true;ri_pcm.transactions++;
+ ri_wr(ch.info,16,(head+frame_bytes)&8191);ri_apr_write8(ch.info+8,1);ri_apr_notify(&ch);
+ error=ETIMEDOUT;unsigned unrelated=0;
+ for(unsigned i=0;i<1000;i++) {
+  if(!ri_apr_dsp_ready(smem)) {error=EIO;break;}
+  int result=ri_pcm_receive(&ch,request,reply);
+  if(result==RI_APR_STATE) {error=0;break;}
+  if(result==RI_APR_NACK) {error=EREMOTE;break;}
+  if(result==RI_APR_BAD) {error=EIO;break;}
+  if(result==RI_APR_STALE || result==RI_APR_ACK_ONLY) {
+   ri_pcm.notifications++;
+   if(++unrelated>32) {error=EOVERFLOW;break;}
+   continue;
+  }
+  ri_wait(5);
+ }
+ ri_pcm.status=reply->status;
+done:
+ /* An exact DSP NACK completes a transaction. Timeout/malformed/reset after
+  * publication leaves ownership uncertain; no later command is allowed. */
+ if(error && reply->sent && !reply->complete)ri_pcm.poisoned=true;
+ ml_io_unmap(ipc,0x4000);return error;
+}
+static int
+ri_pcm_map_test(void)
+{
+ if(ri_pcm.map_attempted)return EALREADY;
+ if(!ri_apr.received || ri_pcm.poisoned)return ri_pcm_result("map_prerequisite",EBUSY);
+ if(!ri_pcm.page && kmem_alloc_contig(kernel_map,&ri_pcm.page,PAGE_SIZE,PAGE_MASK,0,0,
+     KMA_DATA|KMA_ZERO|KMA_PERMANENT,VM_KERN_MEMORY_IOKIT)!=KERN_SUCCESS)return ri_pcm_result("allocate",ENOMEM);
+ ppnum_t pn=pmap_find_phys(kernel_pmap,(addr64_t)ri_pcm.page);
+ uint64_t pa=pn?ptoa_64(pn):0;
+ /* Exact XNU-owned RAM page; exclude every firmware carveout. Verify all
+  * 4KiB subpages too, independent of the kernel's configured page size. */
+ if(!pa || (pa&PAGE_MASK) || PAGE_SIZE<4096 || (PAGE_SIZE&4095) ||
+    pa<0x18000000ULL || pa>0x81800000ULL-PAGE_SIZE)return ri_pcm_result("physical_range",EIO);
+ for(unsigned i=0;i<PAGE_SIZE;i+=4096) {
+  ppnum_t sub=pmap_find_phys(kernel_pmap,(addr64_t)(ri_pcm.page+i));
+  if(!sub || ptoa_64(sub)+(i&PAGE_MASK)!=pa+i)return ri_pcm_result("contiguity",EIO);
+ }
+ ri_pcm.physical=pa;
+ memset((void *)ri_pcm.page,0,PAGE_SIZE);sweet_dcache_clean(ri_pcm.page,PAGE_SIZE);
+ __asm__ volatile("dmb sy" ::: "memory");
+ uint32_t payload[]={0x00010003,0,(uint32_t)pa,(uint32_t)(pa>>32),(uint32_t)PAGE_SIZE};
+ struct ri_apr_request command={0x507,0x407,0,0x10d92,0x10d93,payload,5};
+ struct ri_apr_reply reply;ri_pcm.map_attempted=true;
+ int error=ri_pcm_transaction(&command,&reply);
+ if(error)return ri_pcm_result("map",error);
+ if(reply.words!=1 || !reply.data[0]) {ri_pcm.poisoned=true;return ri_pcm_result("map_handle",EIO);}
+ ri_pcm.handle=reply.data[0];ri_pcm.mapped=true;
+ command.opcode=0x10d94;command.response=0;command.payload=&ri_pcm.handle;command.words=1;
+ error=ri_pcm_transaction(&command,&reply);
+ if(error)return ri_pcm_result("unmap",error);
+ ri_pcm.mapped=false;ri_pcm.unmapped=true;
+ return ri_pcm_result("map_unmap_complete",0);
+}
+static int
+ri_pcm_asm_test(void)
+{
+ if(ri_pcm.asm_attempted)return EALREADY;
+ if(!ri_pcm.unmapped || ri_pcm.poisoned)return ri_pcm_result("asm_prerequisite",EBUSY);
+ /* Session1/stream1, no processing topology, matrix sink, signed stereo
+  * 48kHz/16-bit. No RUN, ADM matrix route, AFE start or WRITE is issued. */
+ uint32_t open[]={0,16u<<16,0x10c68,0x10da5};
+ struct ri_apr_request command={0x01010507,0x01010407,0,0x10db3,0,open,4};
+ struct ri_apr_reply reply;ri_pcm.asm_attempted=true;
+ int error=ri_pcm_transaction(&command,&reply);
+ if(error)return ri_pcm_result("asm_open",error);
+ ri_pcm.asm_open=true;
+ uint32_t format[]={20,(16u<<16)|2,48000,1,0x0201,0};
+ command.opcode=0x10d98;command.payload=format;command.words=6;
+ error=ri_pcm_transaction(&command,&reply);
+ if(!error)ri_pcm.asm_format=true;
+ if(ri_pcm.poisoned)return ri_pcm_result("asm_format",error);
+ int format_error=error;
+ command.opcode=0x10bcd;command.payload=NULL;command.words=0;
+ error=ri_pcm_transaction(&command,&reply);
+ if(!error) {ri_pcm.asm_open=false;ri_pcm.asm_closed=true;}
+ return ri_pcm_result(error?"asm_close":format_error?"asm_format_rejected":"asm_setup_complete",error?error:format_error);
+}
+static int
+ri_pcm_afe_probe(void)
+{
+ if(ri_pcm.afe_attempted)return EALREADY;
+ if(!ri_pcm.unmapped || ri_pcm.poisoned)return ri_pcm_result("afe_prerequisite",EBUSY);
+ /* In-band GET only. A nonconfigured stock SLIMbus RX port may reject it.
+  * This does not configure a port, enable clocks or establish a device route. */
+ uint32_t payload[]={(64u<<16)|0x4000,0,0,0,0x1020c,0x10212};
+ struct ri_apr_request command={0x504,0x404,0,0x100f0,0x10106,payload,6};
+ struct ri_apr_reply reply;ri_pcm.afe_attempted=true;
+ int error=ri_pcm_transaction(&command,&reply);
+ if(error)return ri_pcm_result("afe_get_slimbus",error);
+ ri_pcm.status=reply.data[0];
+ if(reply.data[0])return ri_pcm_result("afe_get_slimbus_rejected",EREMOTE);
+ if(reply.words<4 || reply.data[1]!=0x1020c || reply.data[2]!=0x10212 ||
+    (reply.data[3]>>16) || (reply.data[3]&0xffff)>4*(reply.words-4))
+  return ri_pcm_result("afe_get_payload",EIO);
+ return ri_pcm_result("afe_get_slimbus_complete",0);
+}
+static int
+river_adsp_pcm_sysctl SYSCTL_HANDLER_ARGS
+{
+ int value=0,error=sysctl_handle_int(oidp,&value,0,req);
+ if(error || !req->newptr)return error;
+ if(value<1 || value>3)return EINVAL;
+ lck_mtx_lock(&ri_adsp_lock);
+ error=value==1?ri_pcm_map_test():value==2?ri_pcm_asm_test():ri_pcm_afe_probe();
+ lck_mtx_unlock(&ri_adsp_lock);return error;
+}
+static int
+river_adsp_pcm_status_sysctl SYSCTL_HANDLER_ARGS
+{
+ lck_mtx_lock(&ri_adsp_lock);
+ int error=sysctl_handle_string(oidp,ri_pcm_note,sizeof(ri_pcm_note),req);
+ lck_mtx_unlock(&ri_adsp_lock);return error;
+}
+SYSCTL_PROC(_debug,OID_AUTO,river_adsp_pcm,CTLTYPE_INT|CTLFLAG_RW|CTLFLAG_LOCKED,
+ NULL,0,river_adsp_pcm_sysctl,"I","Explicit PCM map/unmap, ASM setup, AFE read probe");
+SYSCTL_PROC(_debug,OID_AUTO,river_adsp_pcm_status,CTLTYPE_STRING|CTLFLAG_RD|CTLFLAG_LOCKED,
+ NULL,0,river_adsp_pcm_status_sysctl,"A","Last shared PCM/ASM/AFE prerequisite outcome");
