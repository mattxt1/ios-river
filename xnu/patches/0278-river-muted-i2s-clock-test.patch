diff --git a/bsd/dev/river_codec_i2s.h b/bsd/dev/river_codec_i2s.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/river_codec_i2s.h
@@ -0,0 +1,154 @@
+/* Clock-only CS47L35 AIF1 -> CS35L41 test; caller holds speaker mutex.
+ * No PCM TX/RX channels or analog codec outputs are enabled. Amp mute bit
+ * 0x10 and PWR_CTRL2 AMP_EN bit0=0 are verified before clock pins drive.
+ */
+static const uint16_t ri_i2s_codec_regs[] = {
+ 0x101,0x102,0x500,0x501,0x502,0x503,0x504,0x506,0x507,0x508,
+ 0x519,0x51a,0x1710,0x1711,0x1714,0x1715
+};
+static const uint32_t ri_i2s_amp_regs[] = {
+ 0x2018,0x2024,0x6000,0x4800,0x4808,0x2c04,0x2c0c,0x4840,0x4838
+};
+static uint16_t ri_i2s_codec_saved[16];
+static uint32_t ri_i2s_amp_saved[9], ri_i2s_irq_before, ri_i2s_irq_live;
+static bool ri_i2s_touched, ri_i2s_codec_restored, ri_i2s_amp_restored, ri_i2s_amp_locked;
+static char ri_i2s_note[512];
+
+static bool
+ri_i2s_amp_write(uint32_t reg, uint32_t val)
+{
+ bool allowed = false;
+ for (unsigned i=0;i<9;i++) if (ri_i2s_amp_regs[i]==reg) allowed=true;
+ uint32_t got=0;
+ return allowed && ri_cs35l41_wr(reg,val) && ri_cs35l41_rd(reg,&got) && got==val;
+}
+static bool
+ri_i2s_quiet(void)
+{
+ uint32_t mute=0,power=0,format=0;
+ return ri_cs35l41_rd(0x2024,&mute) && (mute&0x10) &&
+     ri_cs35l41_rd(0x2018,&power) && !(power&1) &&
+     ri_cs35l41_rd(0x4808,&format) && !(format&0x33);
+}
+static bool
+ri_i2s_snapshot(void)
+{
+ ri_i2s_touched=false;ri_i2s_codec_restored=true;ri_i2s_amp_restored=true;ri_i2s_amp_locked=false;
+ ri_i2s_irq_before=ri_i2s_irq_live=0;
+ uint32_t id=0;
+ if (!ri_cs35l41_rd(0,&id) || id!=0x35a40) return false;
+ for(unsigned i=0;i<16;i++) ri_i2s_codec_saved[i]=ri_clock_read(ri_i2s_codec_regs[i]);
+ for(unsigned i=0;i<16;i++) if(ri_clock_read(ri_i2s_codec_regs[i])!=ri_i2s_codec_saved[i]) return false;
+ for(unsigned i=0;i<9;i++) if(!ri_cs35l41_rd(ri_i2s_amp_regs[i],&ri_i2s_amp_saved[i])) return false;
+ for(unsigned i=0;i<9;i++) {
+  uint32_t got=0;
+  if(!ri_cs35l41_rd(ri_i2s_amp_regs[i],&got) || got!=ri_i2s_amp_saved[i]) return false;
+ }
+ if(!ri_cs35l41_rd(0x10098,&ri_i2s_irq_before)) return false;
+ snprintf(ri_i2s_note,sizeof(ri_i2s_note),
+     "i2s_snapshot=1 sys=%#x sr=%#x bclk=%#x txpin=%#x rxpin=%#x rate=%#x fmt=%#x bcpf=%#x txwl=%#x rxwl=%#x txen=%#x rxen=%#x gp9=%#x,%#x gp11=%#x,%#x amp_power=%#x amp_mute=%#x amp_fmt=%#x amp_pll=%#x irq=%#x",
+     ri_i2s_codec_saved[0],ri_i2s_codec_saved[1],ri_i2s_codec_saved[2],ri_i2s_codec_saved[3],
+     ri_i2s_codec_saved[4],ri_i2s_codec_saved[5],ri_i2s_codec_saved[6],ri_i2s_codec_saved[7],
+     ri_i2s_codec_saved[8],ri_i2s_codec_saved[9],ri_i2s_codec_saved[10],ri_i2s_codec_saved[11],
+     ri_i2s_codec_saved[12],ri_i2s_codec_saved[13],ri_i2s_codec_saved[14],ri_i2s_codec_saved[15],
+     ri_i2s_amp_saved[0],ri_i2s_amp_saved[1],ri_i2s_amp_saved[4],ri_i2s_amp_saved[5],ri_i2s_irq_before);
+ return true;
+}
+static bool
+ri_i2s_prepare(void)
+{
+ // Refuse an already active/owned codec interface or GPIO alternate function.
+ if ((ri_i2s_codec_saved[2]&0xe0) || (ri_i2s_codec_saved[3]&7) ||
+     (ri_i2s_codec_saved[4]&7) || ri_i2s_codec_saved[10] || ri_i2s_codec_saved[11] ||
+     (ri_i2s_codec_saved[12]&0x1ff) || !(ri_i2s_codec_saved[13]&0x8000) ||
+     (ri_i2s_codec_saved[14]&0x1ff) || !(ri_i2s_codec_saved[15]&0x8000)) return false;
+ ri_i2s_touched=true;ri_i2s_amp_restored=false;ri_i2s_codec_restored=false;
+ // Mute first, then disable the Class-D output stage. Both read back.
+ if(!ri_i2s_amp_write(0x2024,ri_i2s_amp_saved[1]|0x10) ||
+    !ri_i2s_amp_write(0x2018,ri_i2s_amp_saved[0]&~1u) ||
+    !ri_i2s_amp_write(0x6000,0x4cf) || !ri_i2s_amp_write(0x4800,0)) return false;
+ // Stereo S16 I2S; both master and forced-clock bits cleared before the codec.
+ uint32_t format=(ri_i2s_amp_saved[4]&~0xffff0777u)|0x10100200;
+ if(!ri_i2s_amp_write(0x4808,format) || !ri_i2s_quiet()) return false;
+ if(!ri_i2s_amp_write(0x4840,(ri_i2s_amp_saved[7]&~0x3fu)|16) ||
+    !ri_i2s_amp_write(0x4838,(ri_i2s_amp_saved[8]&~0x3fu)|16) ||
+    !ri_i2s_amp_write(0x2c0c,(ri_i2s_amp_saved[6]&~0x1fu)|3)) return false;
+ // Pinned codec_set_sysclk sequence: open loop, frequency 0x1b (1.536MHz),
+ // disable PLL, select SCLK(0), close loop, enable PLL.
+ uint32_t pll=ri_i2s_amp_saved[5];
+ if(!ri_i2s_amp_write(0x2c04,pll|0x800)) return false;
+ pll=(pll&~0x7e0u)|0x360|0x800;
+ if(!ri_i2s_amp_write(0x2c04,pll) || !ri_i2s_amp_write(0x2c04,pll&~0x10u)) return false;
+ pll&=~0x17u;
+ if(!ri_i2s_amp_write(0x2c04,pll) || !ri_i2s_amp_write(0x2c04,pll&~0x800u) ||
+    !ri_i2s_amp_write(0x2c04,(pll&~0x800u)|0x10)) return false;
+ return ri_i2s_quiet();
+}
+static int
+ri_i2s_drive(void)
+{
+ if(!ri_i2s_quiet()) return EIO;
+ // 48k stereo S16: BCLK table index11, BCPF32, frame16/16, I2S format2.
+ if(!ri_clock_write(0x102,(ri_i2s_codec_saved[1]&~0x1fu)|3) ||
+    !ri_clock_write(0x504,(ri_i2s_codec_saved[6]&~7u)|2) ||
+    !ri_clock_write(0x506,(ri_i2s_codec_saved[7]&~0x1fffu)|32) ||
+    !ri_clock_write(0x507,0x1010) || !ri_clock_write(0x508,0x1010) ||
+    !ri_clock_write(0x503,ri_i2s_codec_saved[5]&~0x7840u) ||
+    !ri_clock_write(0x501,(ri_i2s_codec_saved[3]&~7u)|0x23) ||
+    !ri_clock_write(0x502,(ri_i2s_codec_saved[4]&~7u)|3) ||
+    !ri_clock_write(0x500,(ri_i2s_codec_saved[2]&~0xffu)|0x2b)) return EIO;
+ if(!ri_i2s_quiet()) return EIO;
+ // Native GPIO functions, no pull; TXDATA remains tri-stated and channels off.
+ if(!ri_clock_write(0x1711,ri_i2s_codec_saved[13]&~0xe000u) ||
+    !ri_clock_write(0x1715,ri_i2s_codec_saved[15]&~0xe000u) ||
+    !ri_clock_write(0x101,(ri_i2s_codec_saved[0]&~0x874fu)|0x444) ||
+    !ri_clock_write(0x500,(ri_i2s_codec_saved[2]&~0xffu)|0x6b)) return EIO;
+ unsigned clean=0;
+ for(unsigned i=0;i<25;i++) {
+  uint16_t fll=ri_clock_read(0x1881);
+  if(!ri_i2s_quiet() || !ri_cs35l41_rd(0x10098,&ri_i2s_irq_live) ||
+     ri_i2s_irq_live==0xffffffff || fll==0xffff || !(fll&0x100)) return EIO;
+  clean=(ri_i2s_irq_live&0x10)?0:clean+1;
+  if(clean>=2) { ri_i2s_amp_locked=true;return 0; }
+  ri_wait(10);
+ }
+ return ETIMEDOUT;
+}
+static void
+ri_i2s_stop_codec(void)
+{
+ if(!ri_i2s_touched) return;
+ bool ok=true;
+ // Release codec clock outputs before restoring the amplifier's original mode.
+ if(!ri_clock_write(0x1711,ri_i2s_codec_saved[13]|0x8000)) ok=false;
+ if(!ri_clock_write(0x1715,ri_i2s_codec_saved[15]|0x8000)) ok=false;
+ if(!ri_clock_write(0x500,ri_i2s_codec_saved[2]&~0xe0u)) ok=false;
+ if(!ri_clock_write(0x501,(ri_i2s_codec_saved[3]&~7u)|0x20)) ok=false;
+ if(!ri_clock_write(0x502,ri_i2s_codec_saved[4]&~7u)) ok=false;
+ if(!ri_clock_write(0x101,ri_i2s_codec_saved[0]&~0x40u)) ok=false;
+ for(unsigned i=0;i<16;i++) if(!ri_clock_write(ri_i2s_codec_regs[i],ri_i2s_codec_saved[i])) ok=false;
+ for(unsigned i=0;i<16;i++) if(ri_clock_read(ri_i2s_codec_regs[i])!=ri_i2s_codec_saved[i]) ok=false;
+ ri_i2s_codec_restored=ok;
+}
+static void
+ri_i2s_restore_amp(void)
+{
+ if(!ri_i2s_touched) return;
+ bool ok=ri_i2s_codec_restored;
+ if(ok) {
+  // Clock consumers first; stage enable and original mute state last.
+  const unsigned order[]={3,4,5,6,7,8,2,0,1};
+  for(unsigned i=0;i<9;i++) if(!ri_i2s_amp_write(ri_i2s_amp_regs[order[i]],ri_i2s_amp_saved[order[i]])) { ok=false;break; }
+  for(unsigned i=0;i<9;i++) {
+   uint32_t got=0;
+   if(!ri_cs35l41_rd(ri_i2s_amp_regs[i],&got)||got!=ri_i2s_amp_saved[i]) ok=false;
+  }
+ }
+ if(!ok) {
+  // Retain protective mute/output-disable and slave clocks on cleanup failure.
+  (void)ri_i2s_amp_write(0x2024,ri_i2s_amp_saved[1]|0x10);
+  (void)ri_i2s_amp_write(0x2018,ri_i2s_amp_saved[0]&~1u);
+  (void)ri_i2s_amp_write(0x4808,(ri_i2s_amp_saved[4]&~0x33u));
+ }
+ ri_i2s_amp_restored=ok;
+}
