new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/river_display_fit.h
@@ -0,0 +1,35 @@
+#ifndef RIVER_DISPLAY_FIT_H
+#define RIVER_DISPLAY_FIT_H
+
+#include <stdint.h>
+
+enum {
+	RIVER_PANEL_WIDTH = 1080, RIVER_PANEL_HEIGHT = 2270,
+	RIVER_CANVAS_WIDTH = 1125, RIVER_CANVAS_HEIGHT = 2436,
+	RIVER_VIEW_WIDTH = 1048, RIVER_VIEW_LEFT = 16, RIVER_CANVAS_STRIDE = 4608,
+};
+
+/* Nearest source pixel. The same transform is used for fit sampling and HID. */
+static inline uint32_t
+river_fit_axis(int32_t position, uint32_t displayed, uint32_t logical)
+{
+	if (position <= 0) return 0;
+	if ((uint32_t)position >= displayed) return logical - 1;
+	return ((uint32_t)position * logical + displayed / 2) / displayed;
+}
+
+static inline void
+river_fit_frame(const uint8_t *stage, uint8_t *panel, uint32_t stride, const uint16_t *columns)
+{
+	for (uint32_t y = 0; y < RIVER_PANEL_HEIGHT; y++) {
+		uint32_t source_y = river_fit_axis(y, RIVER_PANEL_HEIGHT, RIVER_CANVAS_HEIGHT);
+		const uint32_t *in = (const uint32_t *)(stage + source_y * RIVER_CANVAS_STRIDE);
+		uint32_t *out = (uint32_t *)(panel + y * stride);
+		for (uint32_t x = 0; x < RIVER_VIEW_LEFT; x++) out[x] = 0xff000000;
+		for (uint32_t x = 0; x < RIVER_VIEW_WIDTH; x++) out[RIVER_VIEW_LEFT + x] = in[columns[x]];
+		for (uint32_t x = RIVER_VIEW_LEFT + RIVER_VIEW_WIDTH; x < RIVER_PANEL_WIDTH; x++)
+			out[x] = 0xff000000;
+	}
+}
+
+#endif
