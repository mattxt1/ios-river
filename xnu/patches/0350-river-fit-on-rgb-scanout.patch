+/* Copy logical layers into cached memory using the existing fenced GPU copy.
+ * Only the cached staging buffer is read by the CPU. Keep the last complete
+ * panel frame on any copy failure and require a new full base after a drop. */
+void
+AppleCLCD::presentPanelFit(const uint8_t *rec, uint32_t mask)
+{
+	uint64_t start_time = mach_absolute_time();
+	bool copied = false;
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || !id) continue;
+		SweetSurface *surface = sweet_surface_copy(id);
+		if (!surface || surface == fSurface) {
+			OSSafeReleaseNULL(surface);
+			continue;
+		}
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+		if (sx < 0 || sy < 0) sx = sy = 0;
+		if (dx < 0 || dy < 0) dx = dy = 0;
+		if (w <= 0 || h <= 0) { w = surface->width; h = surface->height; }
+		w = MIN(w, MIN((int32_t)surface->width - sx, (int32_t)RIVER_CANVAS_WIDTH - dx));
+		h = MIN(h, MIN((int32_t)surface->height - sy, (int32_t)RIVER_CANVAS_HEIGHT - dy));
+		if (w <= 0 || h <= 0) {
+			surface->release();
+			continue;
+		}
+		uint64_t end = (uint64_t)surface->offset + (uint64_t)(sy + h - 1) * surface->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		const uint64_t *pages = NULL;
+		uint32_t count = 0;
+		uint64_t offset = 0;
+		bool hit = false;
+		bool valid = (!surface->bytesPerElement || surface->bytesPerElement == 4) &&
+		    surface->elementWidth == 1 && surface->elementHeight == 1 && surface->memory &&
+		    (uint64_t)(sx + w) * 4 <= surface->bytesPerRow && end <= surface->memory->getLength();
+		if (valid && !surface->gpuTouched) {
+			uintptr_t va = surface->kernelAddress();
+			if (va) sweet_dcache_clean((vm_offset_t)(va + surface->offset),
+			    (unsigned)(end - surface->offset));
+			else valid = false;
+		}
+		int error = valid && surface->getBlitPages(&pages, &count, &offset, &hit) ?
+		    river_gpu_blit(pages, count, offset, surface->bytesPerRow, sx, sy,
+		    fPanelStagePhys, fPanelStage->getLength(), RIVER_CANVAS_STRIDE, dx, dy, w, h, 50) : EINVAL;
+		surface->release();
+		if (error) {
+			fPanelStageValid = false;
+			if (fPanelFitDrops++ < 5) IOLog("RIVER FIT: dropped logical layer %u (%d)\n", layer, error);
+			return;
+		}
+		if (dx == 0 && dy == 0 && w == RIVER_CANVAS_WIDTH && h == RIVER_CANVAS_HEIGHT)
+			fPanelStageValid = true;
+		copied = true;
+	}
+	if (!copied || !fPanelStageValid) return;
+
+	/* Initial CPU writes were cleaned at setup. Drop CPU read caches after
+	 * the fenced GPU writes before sampling the staging buffer. */
+	auto *source = (const uint8_t *)fPanelStage->getBytesNoCopy();
+	flush_dcache64((addr64_t)(uintptr_t)source, (unsigned)fPanelStage->getLength(), FALSE);
+	river_fit_frame(source, backBuffer(), fRowBytes, fPanelColumns);
+	river_flip_valid[fFlipIdx ^ 1] = false;
+	fBackClean = false;
+	flipBack();
+	if (!fPanelFitReport) {
+		IOLog("RIVER FIT: RGB scanout 1125x2436 -> 1048x2270 at x=16\n");
+		fPanelFitReport = start_time;
+	}
+	uint64_t now = mach_absolute_time(), ns;
+	absolutetime_to_nanoseconds(now - start_time, &ns);
+	fPanelFitElapsed += ns;
+	fPanelFitFrames++;
+	absolutetime_to_nanoseconds(now - fPanelFitReport, &ns);
+	if (ns >= 10000000000ULL) {
+		IOLog("RIVER FIT: %u frames, copy/resample/flip avg %llu us, %u dropped\n",
+		    fPanelFitFrames, fPanelFitElapsed / 1000 / fPanelFitFrames, fPanelFitDrops);
+		fPanelFitReport = now;
+		fPanelFitElapsed = 0;
+		fPanelFitFrames = fPanelFitDrops = 0;
+	}
+}
+#endif
